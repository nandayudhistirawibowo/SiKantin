---
import Layout from '../layouts/Layout.astro';
import '../styles/cek-pesanan.css';
---

<Layout
	title="Lacak Status Pesanan Kantin | SiKantin"
	description="Lacak nomor antrean dan status pesanan kantin Anda di SiKantin menggunakan token yang diperoleh setelah checkout."
	keywords="SiKantin, cek pesanan, lacak pesanan kantin, nomor antrean, status pesanan"
	bodyClass="min-h-screen bg-slate-50 text-slate-800"
	noIndex
>
	<header class="border-b border-slate-200 bg-white">
		<div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
			<a href="/" class="text-sm font-bold text-blue-700 hover:underline">← Katalog Kantin</a>
			<div class="flex items-center gap-3">
				<button id="soundToggle" type="button" aria-pressed="false" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50"><span class="sound-icon" aria-hidden="true">🔕</span> <span class="sound-label">Aktifkan Suara</span></button>
				<span class="font-extrabold text-slate-900">Cek Pesanan</span>
			</div>
		</div>
	</header>
	<main class="mx-auto max-w-3xl px-4 py-10">
		<p id="soundStatus" class="sr-only" aria-live="polite"></p>
		<section class="ui-enter ui-hover-card rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
			<p class="text-sm font-bold text-blue-700">Pesanan Guest</p>
			<h1 class="mt-1 text-2xl font-extrabold text-slate-900">Lacak status pesanan</h1>
			<p class="mt-2 text-sm text-slate-500">Masukkan token yang diberikan setelah checkout atau dikirim melalui WhatsApp.</p>
			<form id="lookupForm" class="mt-6 flex flex-col gap-3 sm:flex-row">
				<label class="sr-only" for="orderToken">Token pesanan</label>
				<input
					id="orderToken"
					name="token"
					autocomplete="off"
					spellcheck="false"
					required
					class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-3 font-mono text-sm uppercase"
					placeholder="SK-xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"
				/>
				<button id="lookupButton" type="submit" class="rounded-lg bg-blue-700 px-5 py-3 text-sm font-bold text-white hover:bg-blue-800 disabled:opacity-60">
					Cek Pesanan
				</button>
			</form>
			<div id="lookupLoading" class="skeleton-card mt-4 hidden" role="status" aria-label="Memeriksa pesanan">
				<span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span>
			</div>
			<p id="lookupMessage" role="status" aria-live="polite" class="mt-4 hidden rounded-lg p-3 text-sm"></p>
		</section>
		<section id="orderCard" class="ui-hover-card mt-6 hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
			<div class="queue-number-hero rounded-2xl px-5 py-7 text-center">
				<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-emerald-800">Nomor antrean</p>
				<p id="queueNumber" class="mt-2 text-6xl font-black leading-none tracking-tight text-emerald-950 sm:text-8xl"></p>
				<p class="mt-3 text-sm font-medium text-emerald-900">Tunjukkan nomor ini saat mengambil pesanan</p>
			</div>
			<div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-5">
				<div>
					<p class="text-xs font-bold uppercase tracking-wide text-slate-500">Nomor Pesanan</p>
					<h2 id="orderNumber" class="mt-1 text-xl font-extrabold text-slate-900"></h2>
					<p id="tenantName" class="mt-1 text-sm text-slate-500"></p>
				</div>
				<span id="orderStatus" class="rounded-full bg-amber-50 px-3 py-1.5 text-sm font-extrabold text-amber-800"></span>
			</div>
			<ol id="orderStepper" class="order-stepper my-6 grid grid-cols-4 gap-1 sm:gap-2" aria-label="Tahapan pesanan">
				<li data-order-step class="order-step">
					<span data-step-indicator class="order-step-indicator">1</span>
					<span class="mt-2 block text-center text-xs font-bold sm:text-sm">Diterima</span>
				</li>
				<li data-order-step class="order-step">
					<span data-step-indicator class="order-step-indicator">2</span>
					<span class="mt-2 block text-center text-xs font-bold sm:text-sm">Dimasak</span>
				</li>
				<li data-order-step class="order-step">
					<span data-step-indicator class="order-step-indicator">3</span>
					<span class="mt-2 block text-center text-xs font-bold sm:text-sm">Siap Diambil</span>
				</li>
				<li data-order-step class="order-step">
					<span data-step-indicator class="order-step-indicator">4</span>
					<span class="mt-2 block text-center text-xs font-bold sm:text-sm">Selesai</span>
				</li>
			</ol>
			<p id="cancelledOrderMessage" class="hidden rounded-xl bg-rose-50 p-4 text-sm font-semibold text-rose-700">Pesanan ini dibatalkan.</p>
			<div class="mt-5 border-t border-slate-100 pt-4">
				<h3 class="font-extrabold text-slate-900">Rincian menu</h3>
			</div>
			<ul id="orderItems" class="mt-5 space-y-3"></ul>
			<section id="tenantReviewSection" class="mt-6 hidden border-t border-slate-100 pt-5" aria-labelledby="tenantReviewHeading">
				<h3 id="tenantReviewHeading" class="text-lg font-extrabold text-slate-900">Beri rating untuk pesanan ini</h3>
				<p class="mt-1 text-sm text-slate-500">Pesanan selesai. Bagikan penilaianmu untuk pengalaman di tenant ini.</p>
				<form id="tenantReviewForm" class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
					<fieldset id="tenantRatingStars" class="tenant-rating-stars">
						<legend class="sr-only">Pilih rating 1 sampai 5 bintang</legend>
					</fieldset>
					<button id="tenantReviewSubmit" type="submit" class="mt-4 rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-800 disabled:cursor-wait disabled:opacity-60">Kirim Rating</button>
					<p id="tenantReviewResult" class="mt-3 text-xs text-slate-500" aria-live="polite"></p>
				</form>
				<button id="finishOrderButton" type="button" class="mt-3 w-full rounded-lg border border-slate-300 px-4 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-100">Selesaikan Pesanan</button>
			</section>
			<div class="mt-5 flex justify-between border-t border-slate-100 pt-4 font-extrabold text-slate-900">
				<span>Total</span><span id="orderTotal"></span>
			</div>
			<p id="realtimeMessage" class="mt-4 text-xs text-slate-500" aria-live="polite"></p>
		</section>
	</main>
	<script>
		import { db } from '../scripts/supabase.js';
		import '../scripts/notification-sound.js';

		const form = document.getElementById('lookupForm');
		const tokenInput = document.getElementById('orderToken');
		const button = document.getElementById('lookupButton');
		const message = document.getElementById('lookupMessage');
		const lookupLoading = document.getElementById('lookupLoading');
		const tenantRatingStars = document.getElementById('tenantRatingStars');
		let statusChannel;
		let activeToken = '';
		let currentOrder;
		let hoveredRating = 0;

		function updateRatingStars(rating) {
			tenantRatingStars.querySelectorAll('[data-rating-option]').forEach((label) => {
				const value = Number(label.dataset.ratingOption);
				const isActive = value <= rating;
				label.dataset.active = String(isActive);
				label.querySelector('[data-rating-star]').textContent = isActive ? '★' : '☆';
			});
		}

		for (let rating = 1; rating <= 5; rating += 1) {
			const label = document.createElement('label');
			label.className = 'tenant-rating-star';
			label.dataset.ratingOption = String(rating);
			const input = document.createElement('input');
			input.type = 'radio';
			input.name = 'rating';
			input.value = String(rating);
			input.required = true;
			input.className = 'sr-only';
			input.setAttribute('aria-label', `${rating} bintang`);
			input.addEventListener('change', () => updateRatingStars(rating));
			const star = document.createElement('span');
			star.dataset.ratingStar = '';
			star.setAttribute('aria-hidden', 'true');
			star.textContent = '☆';
			label.append(input, star);
			label.addEventListener('mouseenter', () => {
				hoveredRating = rating;
				updateRatingStars(rating);
			});
			tenantRatingStars.append(label);
		}
		tenantRatingStars.addEventListener('mouseleave', () => {
			hoveredRating = 0;
			updateRatingStars(Number(tenantRatingStars.querySelector('input:checked')?.value) || 0);
		});

		function applyRealtimeStatus(nextStatus, updatedAt) {
			if (!currentOrder || !nextStatus) return;
			const previousStatus = currentOrder.status;
			if (previousStatus === nextStatus) return;
			currentOrder = {
				...currentOrder,
				status: nextStatus,
				updated_at: updatedAt || currentOrder.updated_at,
			};
			renderOrder(currentOrder);
			if (nextStatus === 'Siap Diambil') window.playNotificationSound?.();
		}

		function showMessage(text, isError) {
			message.textContent = text;
			message.className = `mt-4 rounded-lg p-3 text-sm ${isError ? 'bg-rose-50 text-rose-700' : 'bg-emerald-50 text-emerald-700'}`;
		}

		function formatRupiah(value) {
			return `Rp ${Number(value).toLocaleString('id-ID')}`;
		}

		function updateStepperUI(status) {
			const normalizedStatus = typeof status === 'string' ? status.trim().toLocaleLowerCase('id-ID') : '';
			const activeStep = normalizedStatus === 'selesai'
				? 4
				: normalizedStatus === 'siap diambil'
					? 3
					: ['dimasak', 'diproses'].includes(normalizedStatus)
						? 2
						: 1;
			const cancelled = normalizedStatus === 'dibatalkan';
			const stepper = document.getElementById('orderStepper');
			stepper.classList.toggle('hidden', cancelled);
			document.getElementById('cancelledOrderMessage').classList.toggle('hidden', !cancelled);
			stepper.querySelectorAll('[data-order-step]').forEach((step, index) => {
				const isComplete = !cancelled
					&& (index < activeStep - 1 || (normalizedStatus === 'selesai' && index === activeStep - 1));
				const isCurrent = !cancelled && normalizedStatus !== 'selesai' && index === activeStep - 1;
				step.classList.toggle('is-complete', isComplete);
				step.classList.toggle('is-current', isCurrent);
				step.removeAttribute('aria-current');
				if (isCurrent) step.setAttribute('aria-current', 'step');
				const indicator = step.querySelector('[data-step-indicator]');
				if (isComplete) {
					indicator.innerHTML = '<svg class="step-check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8 3.2 3.2L13 4.5"></path></svg>';
				} else {
					indicator.textContent = String(index + 1);
				}
			});
		}

		function renderOrder(order) {
			document.getElementById('queueNumber').textContent = order.nomor_antrean || '—';
			document.getElementById('orderNumber').textContent = order.nomor_pesanan;
			document.getElementById('tenantName').textContent = order.tenants?.nama_tenant || '-';
			const status = document.getElementById('orderStatus');
			status.textContent = order.status;
			status.className = `rounded-full px-3 py-1.5 text-sm font-extrabold ${
				order.status === 'Selesai'
					? 'bg-emerald-50 text-emerald-800'
					: order.status === 'Dibatalkan'
						? 'bg-rose-50 text-rose-800'
						: 'bg-amber-50 text-amber-800'
			}`;
			updateStepperUI(order.status);
			const items = document.getElementById('orderItems');
			items.replaceChildren();
			(order.order_items || []).forEach((item) => {
				const row = document.createElement('li');
				row.className = 'flex justify-between gap-4 text-sm';
				const name = document.createElement('span');
				name.className = 'text-slate-600';
				name.textContent = `${item.nama_menu} × ${item.jumlah}`;
				const detail = document.createElement('span');
				detail.className = 'mt-1 block text-xs text-slate-500';
				detail.textContent = Array.isArray(item.add_ons) && item.add_ons.length
					? `Add-on: ${item.add_ons.map((addon) => `${addon.name}${Number.isFinite(Number(addon.price)) ? ` (${formatRupiah(addon.price)})` : ''}`).join(', ')}`
					: '';
				const subtotal = document.createElement('span');
				subtotal.className = 'font-semibold text-slate-800';
				subtotal.textContent = formatRupiah(item.subtotal);
				name.append(detail);
				row.append(name, subtotal);
				items.append(row);
			});
			renderTenantReviewForm(order);
			document.getElementById('orderTotal').textContent = formatRupiah(order.total);
			document.getElementById('orderCard').classList.remove('hidden');
			document.getElementById('orderCard').classList.add('ui-enter');
		}

		function renderTenantReviewForm(order) {
			const section = document.getElementById('tenantReviewSection');
			const reviewForm = document.getElementById('tenantReviewForm');
			const result = document.getElementById('tenantReviewResult');
			const submitButton = document.getElementById('tenantReviewSubmit');
			const isCompleted = order.status === 'Selesai';
			section.classList.toggle('hidden', !isCompleted);
			const savedRating = Number(order.review_rating) || 0;
			hoveredRating = 0;
			const selectedInput = tenantRatingStars.querySelector(`input[value="${savedRating}"]`);
			if (selectedInput) selectedInput.checked = true;
			else tenantRatingStars.querySelectorAll('input').forEach((input) => { input.checked = false; });
			updateRatingStars(savedRating);
			submitButton.textContent = savedRating ? 'Perbarui Rating' : 'Kirim Rating';
			result.textContent = savedRating ? `Rating tersimpan: ${savedRating} dari 5` : '';
			result.className = 'mt-3 text-xs text-slate-500';
			submitButton.disabled = false;
		}

		async function lookupOrder(token) {
			const { data, error } = await db.rpc('lookup_guest_order_with_queue', {
				p_token: token,
			});
			if (error || data?.error || data?.success === false) {
				console.error('Supabase guest order lookup failed:', error || data);
				throw new Error(error?.message || data?.error || data?.message || 'Pencarian pesanan gagal.');
			}
			if (!data?.order) throw new Error('Pesanan tidak ditemukan. Periksa kembali token.');

			const order = data.order;
			const items = order.items || order.order_items || [];
			const tenantName = order.tenant_nama || order.tenants?.nama_tenant || '-';
			return {
				...order,
				tenant_nama: tenantName,
				tenants: order.tenants || { nama_tenant: tenantName },
				review_rating: order.review_rating ?? null,
				items,
				order_items: order.order_items || items,
			};
		}

		async function subscribeToStatus(token, orderId) {
			if (statusChannel) await db.removeChannel(statusChannel);
			const topic = `guest-order:${token}`;
			statusChannel = db
				.channel(topic, { config: { private: false } })
				.on('broadcast', { event: 'order_status' }, ({ payload }) => {
					if (payload?.token_pesanan !== activeToken || !currentOrder) return;
					applyRealtimeStatus(payload.status, payload.updated_at);
				})
				.on('postgres_changes', {
					event: 'UPDATE',
					schema: 'public',
					table: 'orders',
					filter: `id=eq.${orderId}`,
				}, ({ new: updatedOrder }) => {
					if (updatedOrder?.id !== orderId || !currentOrder) return;
					applyRealtimeStatus(updatedOrder.status, updatedOrder.updated_at);
				})
				.subscribe((status) => {
					document.getElementById('realtimeMessage').textContent = status === 'SUBSCRIBED'
						? 'Pembaruan status realtime aktif.'
						: `Koneksi realtime: ${status}. Token dapat dicek ulang untuk status terbaru.`;
					if (status === 'SUBSCRIBED') {
						lookupOrder(token).then((order) => {
							if (activeToken !== token) return;
							currentOrder = order;
							renderOrder(order);
						}).catch((error) => {
							if (activeToken !== token) return;
							document.getElementById('realtimeMessage').textContent = `Gagal menyegarkan status: ${error.message}`;
						});
					}
				});
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const token = tokenInput.value.trim().toUpperCase();
			if (statusChannel) {
				await db.removeChannel(statusChannel);
				statusChannel = undefined;
			}
			activeToken = '';
			currentOrder = undefined;
			document.getElementById('orderCard').classList.add('hidden');
			button.disabled = true;
			lookupLoading.classList.remove('hidden');
			showMessage('Memeriksa token pesanan...', false);
			try {
				const order = await lookupOrder(token);
				activeToken = order.token_pesanan;
				currentOrder = order;
				renderOrder(order);
				showMessage('Pesanan ditemukan.', false);
				await subscribeToStatus(activeToken, order.id);
			} catch (error) {
				document.getElementById('orderCard').classList.add('hidden');
				showMessage(`Pesanan gagal dimuat: ${error.message}`, true);
			} finally {
				lookupLoading.classList.add('hidden');
				button.disabled = false;
			}
		});

		document.getElementById('tenantReviewForm').addEventListener('submit', async (event) => {
			event.preventDefault();

			const selectedRating = tenantRatingStars.querySelector('input[name="rating"]:checked');
			const submitButton = document.getElementById('tenantReviewSubmit');
			const result = document.getElementById('tenantReviewResult');
			if (!activeToken || !selectedRating) {
				result.textContent = 'Pilih rating 1 sampai 5 bintang terlebih dahulu.';
				result.className = 'w-full text-xs text-rose-700';
				return;
			}

			submitButton.disabled = true;
			result.textContent = 'Menyimpan rating...';
			result.className = 'w-full text-xs text-slate-500';
			try {
				const rating = Number(selectedRating.value);
				const { data, error } = await db.rpc('submit_guest_order_rating', {
					p_token: activeToken,
					p_rating: rating,
				});
				if (error || data?.error || data?.success !== true) {
					throw new Error(error?.message || data?.error || 'Rating gagal disimpan.');
				}

				currentOrder = {
					...currentOrder,
					review_rating: rating,
				};
				result.textContent = `Terima kasih! Rating ${rating} dari 5 berhasil disimpan.`;
				result.className = 'w-full text-xs font-semibold text-emerald-700';
				submitButton.textContent = 'Perbarui Rating';
				updateRatingStars(rating);
				document.getElementById('realtimeMessage').textContent = 'Rating tenant berhasil disimpan.';
				window.location.assign('/');
			} catch (error) {
				result.textContent = `Rating gagal disimpan: ${error.message}`;
				result.className = 'w-full text-xs text-rose-700';
			} finally {
				submitButton.disabled = false;
			}
		});

		document.getElementById('finishOrderButton').addEventListener('click', () => {
			window.location.assign('/');
		});

		const initialToken = new URLSearchParams(window.location.search).get('token');
		if (initialToken) {
			tokenInput.value = initialToken;
			form.requestSubmit();
		}
	</script>
</Layout>