---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-uym.png';
import { supabaseServer } from '../lib/supabase-server.js';
import '../styles/index.css';

function isTenantOpen(value: unknown): boolean {
	if (value === true || value === 1) return true;
	if (typeof value !== 'string') return false;
	return ['true', '1'].includes(value.trim().toLowerCase());
}

const { data: tenantRows, error } = await supabaseServer
	.from('tenants')
	.select('id, nama_tenant, slug, lokasi, status_buka')
	.order('nama_tenant');
if (error) {
	console.error('Gagal memuat daftar tenant untuk katalog:', error.message);
}
const tenants = (tenantRows ?? []).map((tenant) => ({
	...tenant,
	status_buka: isTenantOpen(tenant.status_buka),
}));

const { data: tenantMenuPrices, error: menuPriceError } = await supabaseServer
	.from('menu_items')
	.select('tenant_id, harga, foto_url')
	.eq('tersedia', true);

if (menuPriceError) {
	console.error('Gagal memuat harga menu untuk katalog tenant:', menuPriceError.message);
}

const { data: tenantRatings, error: ratingsError } = await supabaseServer
	.rpc('get_public_tenant_ratings', { p_tenant_id: null });

if (ratingsError) {
	console.error('Gagal memuat rating menu tenant:', ratingsError.message);
}

const cheapestPriceByTenant = new Map<string, number>();
const coverImageByTenant = new Map<string, string>();
const tenantRatingTotals = new Map<string, { total: number; count: number }>();
tenantMenuPrices?.forEach(({ tenant_id, harga }) => {
	const price = Number(harga);
	if (!Number.isFinite(price)) return;
	const currentPrice = cheapestPriceByTenant.get(tenant_id);
	if (currentPrice === undefined || price < currentPrice) cheapestPriceByTenant.set(tenant_id, price);
});

tenantMenuPrices?.forEach(({ tenant_id, foto_url }) => {
	if (foto_url && !coverImageByTenant.has(tenant_id)) coverImageByTenant.set(tenant_id, foto_url);
});

tenantRatings?.forEach((rating) => {
	const tenantId = rating.tenant_id;
	const count = Number(rating.review_count) || 0;
	if (!tenantId || count <= 0) return;
	tenantRatingTotals.set(tenantId, {
		total: Number(rating.rating_total) || 0,
		count,
	});
});
---

<Layout
	title="Pesan Makanan di Kantin Kampus | SiKantin UYM"
	description="Jelajahi kantin Universitas Yatsi Madani, lihat menu dan rating, lalu pesan makanan dengan mudah melalui SiKantin."
	keywords="SiKantin, kantin UYM, kantin Universitas Yatsi Madani, pesan makanan kampus, menu kantin"
	themeColor="#172b40"
	bodyClass="role-screen min-h-screen px-4 py-6 text-slate-100 sm:px-6"
>
	<main class="mx-auto max-w-6xl">
		<header class="site-header catalog-header glass flex items-center justify-between rounded-3xl px-4 py-3 sm:px-6">
			<a href="/" class="flex items-center gap-3" aria-label="SiKantin Universitas Yatsi Madani">
				<img src={logo.src} alt="" class="h-11 w-11 rounded-full border border-slate-200 bg-white p-1 dark:border-slate-700" />
				<span>
					<span class="block text-lg font-extrabold tracking-wide">SIKANTIN</span>
					<span class="uym-brand-text block text-xs">Universitas Yatsi Madani</span>
				</span>
			</a>
			<nav class="catalog-nav text-sm font-bold">
				<div class="catalog-nav-controls">
					<button id="catalogMenuButton" type="button" aria-controls="catalogLinks" aria-expanded="false" aria-label="Buka navigasi" class="catalog-menu-button inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 p-2.5 transition hover:bg-white/10">
						<svg data-catalog-menu-icon="open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
						<svg data-catalog-menu-icon="close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-5 w-5"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" /></svg>
					</button>
					<span data-theme-toggle-slot class="contents"></span>
				</div>
				<div id="catalogLinks" class="catalog-links">
					<a href="/mahasiswa/login" class="rounded-full bg-emerald-400 px-4 py-2 text-emerald-950 transition hover:bg-emerald-300">Login Mahasiswa</a>
					<a href="/cek-pesanan" class="rounded-full border border-white/15 bg-white/5 px-4 py-2 hover:bg-white/10">Cek Pesanan</a>
					<a href="/tenant/login" class="rounded-full border border-white/15 bg-white/5 px-4 py-2 hover:bg-white/10">Login Tenant</a>
				</div>
			</nav>
		</header>

		<section class="catalog-hero relative mt-7 overflow-hidden rounded-[2rem] border border-white/10 px-6 py-10 shadow-2xl sm:px-10 sm:py-14">
			<div class="relative z-10 max-w-2xl">
				<p class="uym-brand-text mb-3 text-xs font-extrabold uppercase tracking-[0.28em]">Universitas Yatsi Madani</p>
				<h1 class="text-2xl font-black tracking-tight sm:text-4xl">Lapar? <span class="text-sky-300">Ayo ke kantin favoritmu!</span></h1>
				<p class="mt-4 max-w-xl text-base leading-7 text-blue-100/75 sm:text-lg">Pesan makanan kampus tanpa perlu login. Pantau status dengan token, lalu ambil pesanan saat siap.</p>
				<div class="catalog-hero-actions mt-7 flex flex-col gap-3 sm:flex-row">
					<a href="#daftar-tenant" class="arrow-action arrow-down rounded-xl bg-blue-500 px-5 py-3 text-center text-sm font-extrabold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-400">Jelajahi kantin <span class="arrow-icon" aria-hidden="true">↓</span></a>
					<a href="/cek-pesanan" class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-center text-sm font-bold text-white transition hover:bg-white/10">Cek pesanan</a>
				</div>
			</div>
			<div class="hero-decoration" aria-hidden="true"><span>🍜</span><span>🥤</span><span>🍱</span></div>
		</section>

		<section class="catalog-promo mt-6 overflow-hidden rounded-3xl border border-white/10 px-5 py-6 shadow-xl sm:px-9 sm:py-9" aria-labelledby="catalog-promo-heading">
			<div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
				<div class="max-w-2xl">
					<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-800 dark:text-amber-200">Bebas Antre, Pesan Sekarang</p>
					<h2 id="catalog-promo-heading" class="mt-2 text-2xl font-black sm:text-3xl">Pesan dulu, nikmati waktu istirahatmu.</h2>
					<p class="mt-2 text-sm leading-6 text-blue-100/70">Pesan makanan favoritmu tanpa perlu ngantre. Cukup tunjukkan nomor antrean, pesanan siap diambil.</p>
				</div>
				<a href="/cek-pesanan" class="inline-flex w-full shrink-0 items-center justify-center rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-extrabold transition hover:bg-white/15 sm:w-auto">
					Cek status pesanan <span class="ml-2" aria-hidden="true">→</span>
				</a>
			</div>
		</section>

		<section id="tenant-directory" class="tenant-directory glass mt-10 rounded-3xl p-5 sm:p-6" aria-labelledby="tenant-directory-heading">
			<div class="mb-4">
				<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-200">Pilihan kantin kampus</p>
				<h2 id="tenant-directory-heading" class="mt-1 text-2xl font-extrabold">Daftar Kantin</h2>
			</div>
			{tenants?.length ? (
				<ul class="tenant-directory-list grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{tenants.map((tenant) => (
						<li>
							<a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="tenant-directory-link flex min-h-14 items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3 transition hover:bg-white/10">
								<span class="min-w-0 truncate text-sm font-bold">{tenant.nama_tenant}</span>
								<span data-tenant-status-indicator={tenant.id} class:list={['tenant-directory-status shrink-0 rounded-full px-2.5 py-1 text-xs font-bold', tenant.status_buka ? 'bg-emerald-500 text-white' : 'bg-slate-600 text-slate-100']}>{tenant.status_buka ? 'Buka' : 'Tutup'}</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="text-sm text-blue-100/65">Daftar kantin belum tersedia.</p>
			)}
		</section>

			<section id="daftar-tenant" class="mt-8" aria-labelledby="tenant-list-heading" tabindex="-1">
				<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-200">Menu kampus</p>
						<h2 id="tenant-list-heading" class="mt-1 text-2xl font-extrabold">Mau makan apa hari ini?</h2>
					</div>
					<p class="text-sm text-blue-100/70"><span id="tenantCount">{tenants?.length ?? 0}</span> tenant</p>
				</div>
				<p id="tenantRealtimeStatus" class="mb-4 text-xs text-blue-100/60" role="status" aria-live="polite">Menghubungkan status kantin realtime...</p>
				{error ? (
					<p role="alert" class="rounded-xl border border-rose-300/30 bg-rose-950/30 p-4 text-sm text-rose-100">
						Daftar tenant gagal dimuat. Coba muat ulang halaman.
					</p>
				) : tenants?.length ? (
					<>
						<div id="tenantCardGrid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{tenants.map((tenant, index) => (
								<article
									data-tenant-card
									data-tenant-id={tenant.id}
									data-tenant-open={tenant.status_buka ? 'true' : 'false'}
									class="tenant-card glass ui-enter flex min-h-80 flex-col overflow-hidden rounded-3xl shadow-xl hover:border-sky-200/30"
								>
									<a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="tenant-card-cover group relative block aspect-video overflow-hidden" aria-label={`Lihat menu ${tenant.nama_tenant}`}>
										{coverImageByTenant.get(tenant.id) ? (
											<img src={coverImageByTenant.get(tenant.id)} alt="" loading="lazy" data-fallback-on-error class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
										) : (
											<>
												<span class="tenant-card-cover-art" aria-hidden="true"></span>
												<span class="tenant-card-cover-emoji" aria-hidden="true">{index % 3 === 0 ? '🍱' : index % 3 === 1 ? '🥤' : '🍜'}</span>
											</>
										)}
										<span data-tenant-status-badge={tenant.id} class:list={['absolute right-3 top-3 rounded-full px-3 py-1.5 text-xs font-extrabold shadow-sm', tenant.status_buka ? 'tenant-status-open' : 'tenant-status-closed bg-white/90 text-slate-700']}>
											<span data-tenant-status-dot class:list={['mr-1 inline-block h-1.5 w-1.5 rounded-full align-middle', tenant.status_buka ? 'bg-emerald-700' : 'bg-slate-400']}></span>
											<span data-tenant-status-label>{tenant.status_buka ? 'Buka sekarang' : 'Sedang tutup'}</span>
										</span>
										<span class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-slate-950/60 to-transparent" aria-hidden="true"></span>
									</a>
									<div class="flex flex-1 flex-col p-5">
										<div class="flex items-start justify-between gap-3">
											<div>
												<h3 class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">{tenant.nama_tenant}</h3>
												<p class="mt-1 text-sm text-blue-100/70">{tenant.lokasi || 'Lokasi belum diisi'}</p>
											</div>
										</div>
										<div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold text-blue-100/80">
											{(() => {
												const rating = tenantRatingTotals.get(tenant.id);
												if (ratingsError) {
													return <span class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-[11px] font-semibold text-blue-100/70">Rating gagal dimuat</span>;
												}
												return rating ? (
													<span class="inline-flex items-center gap-1.5 rounded-full border border-yellow-200 bg-yellow-400 px-2.5 py-1 font-extrabold text-yellow-950 shadow-sm" aria-label={`Rating ${(rating.total / rating.count).toFixed(1)} dari 5`}>
														<span aria-hidden="true">★</span> {(rating.total / rating.count).toFixed(1)}
													</span>
												) : (
													<span class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-[11px] font-semibold text-blue-100/70">Belum ada rating</span>
												);
											})()}
											{cheapestPriceByTenant.has(tenant.id) && <span class="whitespace-nowrap text-emerald-300">Mulai Rp {cheapestPriceByTenant.get(tenant.id).toLocaleString('id-ID')}</span>}
										</div>
										<a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="arrow-action mt-5 inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-400 px-4 py-3 text-sm font-extrabold text-emerald-950 shadow-lg shadow-emerald-950/20 transition hover:bg-emerald-300">
											Pesan Sekarang <span class="arrow-icon" aria-hidden="true">→</span>
										</a>
									</div>
								</article>
							))}
						</div>
					</>
				) : (
					<div class="empty-tenant rounded-3xl border border-white/10 p-8 text-center">
						<span class="text-5xl" aria-hidden="true">🍽️</span>
						<h3 class="mt-4 text-xl font-extrabold">Kantin sedang bersiap</h3>
						<p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-blue-100/65">Daftar tenant akan muncul di sini saat kantin sudah bergabung. Silakan kembali lagi nanti.</p>
					</div>
				)}
			</section>

		<footer class="catalog-footer py-8 text-center text-sm">
			<p>SiKantin UYM · Pesan dulu, ambil tanpa antre.</p>
			<p class="mt-2">Created by <a href="https://ndhistira.my.id/" target="_blank" rel="noopener noreferrer" class="font-bold underline decoration-current/40 underline-offset-2 transition hover:decoration-current">Nanda Yudhistira</a> · <a href="https://ndhistira.my.id/#projects" target="_blank" rel="noopener noreferrer" class="font-bold underline decoration-current/40 underline-offset-2 transition hover:decoration-current">Lihat Portofolio</a></p>
		</footer>
	</main>
	<script>
		import { db } from '../scripts/supabase.js';

		const catalogMenuButton = document.getElementById('catalogMenuButton');
		const catalogLinks = document.getElementById('catalogLinks');
		const catalogMenuIcons = catalogMenuButton.querySelectorAll('[data-catalog-menu-icon]');
		function setCatalogMenuOpen(isOpen) {
			catalogLinks.classList.toggle('is-open', isOpen);
			catalogMenuButton.setAttribute('aria-expanded', String(isOpen));
			catalogMenuButton.setAttribute('aria-label', isOpen ? 'Tutup navigasi' : 'Buka navigasi');
			catalogMenuIcons.forEach((icon) => icon.classList.toggle('hidden', icon.dataset.catalogMenuIcon !== (isOpen ? 'close' : 'open')));
		}
		catalogMenuButton.addEventListener('click', () => {
			setCatalogMenuOpen(catalogMenuButton.getAttribute('aria-expanded') !== 'true');
		});
		catalogLinks.addEventListener('click', (event) => {
			if (event.target.closest('a')) setCatalogMenuOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setCatalogMenuOpen(false);
		});

		const tenantCards = document.querySelectorAll('[data-tenant-card]');
		const tenantRealtimeStatus = document.getElementById('tenantRealtimeStatus');
		let tenantStatusChannel;
		const tenantStatusRevisions = new Map();

		function parseTenantOpenStatus(value) {
			if (value === true || value === 1) return true;
			if (value === false || value === 0) return false;
			if (typeof value === 'string') {
				const normalized = value.trim().toLowerCase();
				if (normalized === 'true' || normalized === '1') return true;
				if (normalized === 'false' || normalized === '0') return false;
			}
			return null;
		}

		function applyTenantStatus(tenantId, statusValue) {
			const isOpen = parseTenantOpenStatus(statusValue);
			if (isOpen === null) return;

			const card = [...tenantCards].find((item) => item.dataset.tenantId === tenantId);
			if (card) {
				card.dataset.tenantOpen = String(isOpen);
				const badge = card.querySelector('[data-tenant-status-badge]');
				const dot = badge?.querySelector('[data-tenant-status-dot]');
				const label = badge?.querySelector('[data-tenant-status-label]');
				badge?.classList.toggle('tenant-status-open', isOpen);
				badge?.classList.toggle('tenant-status-closed', !isOpen);
				badge?.classList.toggle('bg-white/90', !isOpen);
				badge?.classList.toggle('text-slate-700', !isOpen);
				dot?.classList.toggle('bg-emerald-700', isOpen);
				dot?.classList.toggle('bg-slate-400', !isOpen);
				if (label) label.textContent = isOpen ? 'Buka sekarang' : 'Sedang tutup';
			}

			const indicator = document.querySelector(`[data-tenant-status-indicator="${CSS.escape(tenantId)}"]`);
			indicator?.classList.toggle('bg-emerald-500', isOpen);
			indicator?.classList.toggle('text-white', isOpen);
			indicator?.classList.toggle('bg-slate-600', !isOpen);
			indicator?.classList.toggle('text-slate-100', !isOpen);
			if (indicator) indicator.textContent = isOpen ? 'Buka' : 'Tutup';
		}

		const tenantIds = [...tenantCards].map((card) => card.dataset.tenantId).filter(Boolean);
		if (tenantIds.length) {
			tenantStatusChannel = db
				.channel('tenant-directory-status')
				.on('postgres_changes', {
					event: 'UPDATE',
					schema: 'public',
					table: 'tenants',
				}, ({ new: tenant }) => {
					if (tenant?.id && Object.prototype.hasOwnProperty.call(tenant, 'status_buka')) {
						tenantStatusRevisions.set(tenant.id, (tenantStatusRevisions.get(tenant.id) || 0) + 1);
						applyTenantStatus(tenant.id, tenant.status_buka);
					}
				})
				.subscribe((status, error) => {
					tenantRealtimeStatus.textContent = status === 'SUBSCRIBED'
						? 'Status kantin diperbarui realtime.'
						: error
							? `Realtime status kantin gagal: ${error.message}`
							: `Realtime status kantin: ${status}`;
					if (status !== 'SUBSCRIBED') console.error('Realtime status tenant:', status, error);
					if (status === 'SUBSCRIBED') {
						const revisionsAtRequest = new Map(tenantStatusRevisions);
						db.from('tenants')
							.select('id, status_buka')
							.in('id', tenantIds)
							.then(({ data, error: snapshotError }) => {
								if (snapshotError) {
									tenantRealtimeStatus.textContent = `Gagal menyegarkan status kantin: ${snapshotError.message}`;
									console.error('Gagal menyegarkan status tenant:', snapshotError);
									return;
								}
								data?.forEach((tenant) => {
									if ((revisionsAtRequest.get(tenant.id) || 0) === (tenantStatusRevisions.get(tenant.id) || 0)) {
										applyTenantStatus(tenant.id, tenant.status_buka);
									}
								});
							});
					}
				});
		} else if (tenantRealtimeStatus) {
			tenantRealtimeStatus.textContent = 'Belum ada tenant untuk dipantau.';
		}

		window.addEventListener('pagehide', () => {
			if (tenantStatusChannel) db.removeChannel(tenantStatusChannel);
		}, { once: true });
	</script>
</Layout>
