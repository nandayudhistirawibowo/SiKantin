---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-uym.png';
import { supabaseServer } from '../lib/supabase-server.js';
import '../styles/index.css';

const { data: tenants, error } = await supabaseServer
	.from('tenants')
	.select('id, nama_tenant, slug, lokasi, status_buka')
	.order('nama_tenant');

const { data: tenantMenuPrices, error: menuPriceError } = await supabaseServer
	.from('menu_items')
	.select('tenant_id, harga')
	.eq('tersedia', true);

if (menuPriceError) {
	console.error('Gagal memuat harga menu untuk katalog tenant:', menuPriceError.message);
}

const cheapestPriceByTenant = new Map<string, number>();
tenantMenuPrices?.forEach(({ tenant_id, harga }) => {
	const price = Number(harga);
	if (!Number.isFinite(price)) return;
	const currentPrice = cheapestPriceByTenant.get(tenant_id);
	if (currentPrice === undefined || price < currentPrice) cheapestPriceByTenant.set(tenant_id, price);
});

const featuredTenant = tenants?.find((tenant) => tenant.status_buka) ?? tenants?.[0];
---

<Layout title="Pilih Kantin | SiKantin UYM" themeColor="#172b40" bodyClass="role-screen min-h-screen px-4 py-6 text-slate-100 sm:px-6">
	<main class="mx-auto max-w-6xl">
		<header class="glass flex items-center justify-between rounded-3xl px-4 py-3 sm:px-6">
			<a href="/" class="flex items-center gap-3" aria-label="SiKantin Universitas Yatsi Madani">
				<img src={logo.src} alt="" class="h-11 w-11 rounded-full bg-white p-1" />
				<span>
					<span class="block text-lg font-extrabold tracking-wide">SIKANTIN</span>
					<span class="block text-xs text-blue-100/75">Universitas Yatsi Madani</span>
				</span>
			</a>
			<nav class="flex flex-wrap items-center justify-end gap-2 text-sm font-bold">
				<a href="/cek-pesanan" class="rounded-full border border-white/15 bg-white/5 px-4 py-2 hover:bg-white/10">Cek Pesanan</a>
				<a href="/tenant/login" class="rounded-full border border-white/15 bg-white/5 px-4 py-2 hover:bg-white/10">Login Tenant</a>
			</nav>
		</header>

		<section class="catalog-hero relative mt-7 overflow-hidden rounded-[2rem] border border-white/10 px-6 py-10 shadow-2xl sm:px-10 sm:py-14">
			<div class="relative z-10 max-w-2xl">
				<p class="mb-3 text-xs font-extrabold uppercase tracking-[0.28em] text-amber-300">Universitas Yatsi Madani</p>
				<h1 class="text-4xl font-black tracking-tight sm:text-6xl">Lapar? Kantin favoritmu <span class="text-sky-300">dekat.</span></h1>
				<p class="mt-4 max-w-xl text-base leading-7 text-blue-100/75 sm:text-lg">Temukan pilihan makan dan minum di kampus. Pesan tanpa login, lalu pantau pesanan dengan token.</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<a href="#daftar-tenant" class="rounded-xl bg-blue-500 px-5 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-400">Jelajahi kantin <span aria-hidden="true">↓</span></a>
					<a href="/cek-pesanan" class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-bold text-white transition hover:bg-white/10">Cek pesanan</a>
				</div>
			</div>
			<div class="hero-decoration" aria-hidden="true"><span>🍜</span><span>🥤</span><span>🍱</span></div>
		</section>

		<div class="mt-10 grid items-start gap-6 lg:grid-cols-[250px_minmax(0,1fr)]">
			<aside class="tenant-sidebar glass rounded-3xl p-5 lg:sticky lg:top-5" aria-label="Navigasi kantin">
				<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-200">Jelajahi</p>
				<h2 class="mt-1 text-xl font-black">Cari kantin</h2>
				<nav class="mt-5 grid grid-cols-2 gap-2 lg:grid-cols-1" aria-label="Filter tenant">
					<button type="button" data-tenant-filter="all" aria-pressed="true" class="tenant-filter is-active rounded-xl px-3 py-2.5 text-left text-sm font-bold transition">Semua kantin <span class="float-right text-xs opacity-70">{tenants?.length ?? 0}</span></button>
					<button type="button" data-tenant-filter="open" aria-pressed="false" class="tenant-filter rounded-xl px-3 py-2.5 text-left text-sm font-bold transition">Sedang buka <span class="float-right text-xs opacity-70">{tenants?.filter((tenant) => tenant.status_buka).length ?? 0}</span></button>
					<button type="button" data-tenant-filter="cheapest" aria-pressed="false" class="tenant-filter rounded-xl px-3 py-2.5 text-left text-sm font-bold transition">Termurah <span class="float-right text-xs opacity-70">↓</span></button>
				</nav>
				<div class="mt-6 border-t border-white/10 pt-5">
					<p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-200/75">Daftar tenant</p>
					{tenants?.length ? (
						<ul class="mt-3 space-y-1">
							{tenants.map((tenant) => (
								<li>
									<a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm text-blue-50/80 transition hover:bg-white/10 hover:text-white">
										<span class="truncate">{tenant.nama_tenant}</span>
										<span class:list={['h-2 w-2 shrink-0 rounded-full', tenant.status_buka ? 'bg-emerald-300' : 'bg-slate-400']} aria-label={tenant.status_buka ? 'Buka' : 'Tutup'}></span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="mt-3 text-sm text-blue-100/55">Tenant akan tampil di sini.</p>
					)}
				</div>
				<div class="mt-6 rounded-2xl border border-sky-200/10 bg-sky-300/5 p-4">
					<p class="text-sm font-extrabold text-sky-100">Pesan praktis</p>
					<p class="mt-1 text-xs leading-5 text-blue-100/60">Pilih kantin, tambahkan menu ke pesanan, dan ambil saat siap.</p>
				</div>
			</aside>

			<section id="daftar-tenant" aria-labelledby="tenant-list-heading">
				<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-200">Menu kampus</p>
						<h2 id="tenant-list-heading" class="mt-1 text-2xl font-extrabold">Kantin di sekitar kamu</h2>
					</div>
					<p class="text-sm text-blue-100/70"><span id="tenantCount">{tenants?.length ?? 0}</span> tenant</p>
				</div>
				{error ? (
					<p role="alert" class="rounded-xl border border-rose-300/30 bg-rose-950/30 p-4 text-sm text-rose-100">
						Daftar tenant gagal dimuat. Coba muat ulang halaman.
					</p>
				) : tenants?.length ? (
					<>
						{featuredTenant && (
							<a href={`/tenant/${encodeURIComponent(featuredTenant.slug)}`} data-tenant-open={featuredTenant.status_buka ? 'true' : 'false'} class="featured-tenant mb-5 flex min-h-36 items-end justify-between gap-4 overflow-hidden rounded-3xl border border-white/10 p-5 shadow-xl transition hover:border-sky-200/30 sm:p-6">
								<div class="relative z-10">
									<p class="text-xs font-extrabold uppercase tracking-[0.18em] text-amber-200">Mulai dari sini</p>
									<h3 class="mt-2 text-2xl font-black">{featuredTenant.nama_tenant}</h3>
									<p class="mt-1 text-sm text-blue-100/70">{featuredTenant.lokasi || 'Temukan menu favoritmu'}</p>
								</div>
								<span class:list={['relative z-10 shrink-0 rounded-full px-3 py-1.5 text-xs font-extrabold', featuredTenant.status_buka ? 'bg-emerald-300/15 text-emerald-100' : 'bg-slate-300/15 text-slate-100']}>
									{featuredTenant.status_buka ? '● Sedang buka' : '● Sedang tutup'}
								</span>
							</a>
						)}
						<div id="tenantCardGrid" class="grid gap-4 sm:grid-cols-2">
							{tenants.map((tenant, index) => (
								<article
									data-tenant-card
									data-tenant-open={tenant.status_buka ? 'true' : 'false'}
									data-cheapest-price={cheapestPriceByTenant.has(tenant.id) ? String(cheapestPriceByTenant.get(tenant.id)) : ''}
									data-original-order={index}
									class="tenant-card glass flex min-h-72 flex-col overflow-hidden rounded-3xl shadow-xl transition duration-200 hover:-translate-y-1 hover:border-sky-200/30 hover:shadow-2xl"
								>
									<a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="tenant-card-cover group relative block h-36 overflow-hidden" aria-label={`Lihat menu ${tenant.nama_tenant}`}>
										<span class="tenant-card-cover-art" aria-hidden="true"></span>
										<span class="tenant-card-cover-emoji" aria-hidden="true">{index % 3 === 0 ? '🍱' : index % 3 === 1 ? '🥤' : '🍜'}</span>
										<span class:list={['absolute right-3 top-3 rounded-full px-3 py-1.5 text-xs font-extrabold shadow-sm', tenant.status_buka ? 'bg-emerald-300 text-emerald-950' : 'bg-white/90 text-slate-700']}>
											<span class:list={['mr-1 inline-block h-1.5 w-1.5 rounded-full align-middle', tenant.status_buka ? 'bg-emerald-700' : 'bg-slate-400']}></span>
											{tenant.status_buka ? 'Buka sekarang' : 'Sedang tutup'}
										</span>
										<span class="absolute bottom-3 left-3 rounded-full border border-white/30 bg-slate-950/30 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-white backdrop-blur">Kantin kampus</span>
									</a>
									<div class="flex flex-1 flex-col p-5">
										<div class="flex items-start justify-between gap-3">
											<div>
												<h3 class="text-lg font-extrabold">{tenant.nama_tenant}</h3>
												<p class="mt-1 text-sm text-blue-100/70">{tenant.lokasi || 'Lokasi belum diisi'}</p>
											</div>
										</div>
										<div class="mt-4 flex items-center gap-3 text-xs font-semibold text-blue-100/80">
											<span class="inline-flex items-center gap-1"><span class="text-amber-300" aria-hidden="true">★</span> 4.5</span>
											<span aria-hidden="true">·</span>
											<span>± {((index + 2) * 0.15).toFixed(1)} km</span>
											{cheapestPriceByTenant.has(tenant.id) && <span class="ml-auto whitespace-nowrap text-emerald-300">Mulai Rp {cheapestPriceByTenant.get(tenant.id).toLocaleString('id-ID')}</span>}
										</div>
										<a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="mt-4 inline-flex items-center justify-between rounded-xl bg-blue-600 px-4 py-3 text-sm font-extrabold text-white transition hover:bg-blue-500">
											Lihat menu <span aria-hidden="true">→</span>
										</a>
									</div>
								</article>
							))}
						</div>
						<p id="tenantEmptyFilter" class="mt-4 hidden rounded-xl border border-white/10 bg-white/5 p-5 text-sm text-blue-100/75">Tidak ada tenant yang sedang buka saat ini.</p>
					</>
				) : (
					<div class="empty-tenant rounded-3xl border border-white/10 p-8 text-center">
						<span class="text-5xl" aria-hidden="true">🍽️</span>
						<h3 class="mt-4 text-xl font-extrabold">Kantin sedang bersiap</h3>
						<p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-blue-100/65">Daftar tenant akan muncul di sini saat kantin sudah bergabung. Silakan kembali lagi nanti.</p>
					</div>
				)}
			</section>
		</div>

		<section class="catalog-promo mt-8 overflow-hidden rounded-3xl border border-white/10 px-6 py-7 shadow-xl sm:px-9 sm:py-9" aria-labelledby="catalog-promo-heading">
			<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
				<div class="max-w-2xl">
					<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-amber-200">Praktis untuk hari sibuk</p>
					<h2 id="catalog-promo-heading" class="mt-2 text-2xl font-black sm:text-3xl">Pesan dulu, nikmati waktu istirahatmu.</h2>
					<p class="mt-2 text-sm leading-6 text-blue-100/70">Pilih menu favorit tanpa perlu login, lalu gunakan token untuk memantau status pesanan.</p>
				</div>
				<a href="/cek-pesanan" class="inline-flex shrink-0 items-center justify-center rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-extrabold transition hover:bg-white/15">
					Cek status pesanan <span class="ml-2" aria-hidden="true">→</span>
				</a>
			</div>
		</section>

		<footer class="py-8 text-center text-xs text-blue-100/50">
			<p>SiKantin UYM · Pesan dulu, ambil tanpa antre.</p>
		</footer>
	</main>
	<script>
		const tenantFilterButtons = document.querySelectorAll('[data-tenant-filter]');
		const tenantCards = document.querySelectorAll('[data-tenant-card]');
		const tenantCardGrid = document.getElementById('tenantCardGrid');
		const tenantCount = document.getElementById('tenantCount');
		const tenantEmptyFilter = document.getElementById('tenantEmptyFilter');
		const featuredTenant = document.querySelector('.featured-tenant');

		tenantFilterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const filter = button.dataset.tenantFilter;
				if (filter === 'cheapest' && tenantCardGrid) {
					const sortedCards = [...tenantCards].sort((a, b) => {
						const priceA = a.dataset.cheapestPrice === '' ? Number.POSITIVE_INFINITY : Number(a.dataset.cheapestPrice);
						const priceB = b.dataset.cheapestPrice === '' ? Number.POSITIVE_INFINITY : Number(b.dataset.cheapestPrice);
						return priceA - priceB;
					});
					sortedCards.forEach((card) => tenantCardGrid.append(card));
				} else if (filter === 'all' && tenantCardGrid) {
					[...tenantCards]
						.sort((a, b) => Number(a.dataset.originalOrder) - Number(b.dataset.originalOrder))
						.forEach((card) => tenantCardGrid.append(card));
				}
				let visibleCount = 0;
				tenantCards.forEach((card) => {
					const visible = filter !== 'open' || card.dataset.tenantOpen === 'true';
					card.classList.toggle('hidden', !visible);
					if (visible) visibleCount += 1;
				});
				if (tenantCount) tenantCount.textContent = String(visibleCount);
				if (tenantEmptyFilter) tenantEmptyFilter.classList.toggle('hidden', visibleCount > 0);
				if (featuredTenant) featuredTenant.classList.toggle('hidden', filter === 'open' && featuredTenant.dataset.tenantOpen !== 'true');
				tenantFilterButtons.forEach((filterButton) => {
					const active = filterButton === button;
					filterButton.classList.toggle('is-active', active);
					filterButton.setAttribute('aria-pressed', String(active));
				});
			});
		});
	</script>
</Layout>
