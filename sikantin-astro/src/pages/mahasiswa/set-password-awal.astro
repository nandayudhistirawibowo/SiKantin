---
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/logo-uym.png';
---

<Layout title="Atur Password Pertama Kali | SiKantin" themeColor="#172b40" bodyClass="flex min-h-screen items-center justify-center bg-slate-950 px-4 py-8 text-white" noIndex>
	<main class="w-full max-w-md rounded-3xl border border-white/10 bg-slate-900 p-6 shadow-2xl sm:p-9">
		<a href="/mahasiswa/login" class="text-sm font-bold text-blue-200 hover:text-white">← Kembali ke login</a>
		<div class="mb-7 mt-8 text-center">
			<img src={logo.src} alt="" class="mx-auto h-16 w-16 rounded-full bg-white p-1" />
			<p class="mt-4 text-xs font-extrabold uppercase tracking-[0.2em] text-sky-300">Aktivasi akun</p>
			<h1 class="mt-2 text-3xl font-black">Atur Password Pertama Kali</h1>
			<p class="mt-2 text-sm leading-6 text-blue-100/65">Gunakan NIM dan kode aktivasi yang dikirim admin melalui WhatsApp.</p>
		</div>
		<form id="initialPasswordForm" class="space-y-4">
			<label for="studentNim" class="block text-sm font-bold">NIM
				<input id="studentNim" type="text" inputmode="numeric" pattern="[0-9]{6,20}" maxlength="20" autocomplete="username" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 text-white outline-none focus:border-sky-300" />
			</label>
			<label for="activationCode" class="block text-sm font-bold">Kode aktivasi
				<input id="activationCode" type="text" inputmode="text" minlength="20" maxlength="20" pattern="AKT-[A-Fa-f0-9]{16}" autocomplete="one-time-code" autocapitalize="characters" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 font-mono uppercase text-white outline-none focus:border-sky-300" />
			</label>
			<label for="newStudentPassword" class="block text-sm font-bold">Password baru
				<input id="newStudentPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 text-white outline-none focus:border-sky-300" />
			</label>
			<label for="confirmStudentPassword" class="block text-sm font-bold">Konfirmasi password
				<input id="confirmStudentPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 text-white outline-none focus:border-sky-300" />
			</label>
			<button id="initialPasswordButton" type="submit" class="w-full rounded-xl bg-blue-500 px-4 py-3 font-extrabold text-white transition hover:bg-blue-400 disabled:cursor-wait disabled:opacity-60">Simpan password</button>
		</form>
		<p id="initialPasswordMessage" role="status" aria-live="polite" class="mt-4 hidden rounded-xl p-3 text-sm"></p>
	</main>

	<script>
		import { db } from '../../scripts/supabase.js';

		const form = document.getElementById('initialPasswordForm');
		const button = document.getElementById('initialPasswordButton');
		const message = document.getElementById('initialPasswordMessage');

		function showMessage(text, isError) {
			message.textContent = text;
			message.className = `mt-4 rounded-xl p-3 text-sm ${isError ? 'bg-rose-950 text-rose-200' : 'bg-emerald-950 text-emerald-200'}`;
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			button.disabled = true;
			try {
				const nim = document.getElementById('studentNim').value.trim();
				const activationCode = document.getElementById('activationCode').value.trim().toUpperCase();
				const password = document.getElementById('newStudentPassword').value;
				const confirmation = document.getElementById('confirmStudentPassword').value;
				if (!/^\d{6,20}$/.test(nim)) throw new Error('NIM harus berisi 6 sampai 20 digit.');
				if (!/^AKT-[A-F0-9]{16}$/.test(activationCode)) throw new Error('Format kode aktivasi tidak valid.');
				if (password.length < 8 || password.length > 128) {
					throw new Error('Password harus berisi 8 sampai 128 karakter.');
				}
				if (password !== confirmation) throw new Error('Konfirmasi password tidak sama.');

				const { data, error } = await db.functions.invoke('activate-student-account', {
					body: { nim, activation_code: activationCode, new_password: password }
				});
				if (error || data?.success !== true) {
					throw new Error(error?.message || data?.error || 'Aktivasi akun gagal.');
				}
				window.location.assign('/mahasiswa/login?password_set=1');
			} catch (error) {
				showMessage(error instanceof Error ? error.message : String(error), true);
			} finally {
				button.disabled = false;
			}
		});
	</script>
</Layout>
