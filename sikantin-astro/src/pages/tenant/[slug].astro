---
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/logo-uym.png';
import { supabaseServer } from '../../lib/supabase-server.js';
import '../../styles/tenant-guest.css';

const slug = Astro.params.slug || '';
const { data: tenant, error: tenantError } = await supabaseServer
  .from('tenants')
  .select('id, nama_tenant, slug, lokasi, jam_operasional, status_buka, qris_image_url')
  .eq('slug', slug)
  .maybeSingle();

if (tenantError) {
  console.error('Gagal memuat tenant berdasarkan slug:', tenantError.message);
  Astro.response.status = 500;
}

if (!tenant) {
  Astro.response.status = tenantError ? 500 : 404;
}

const { data: menuItems, error: menuError } = tenant
  ? await supabaseServer
      .from('menu_items')
      .select('id, nama_menu, kategori, harga, foto_url, waktu_persiapan, add_ons')
      .eq('tenant_id', tenant.id)
      .eq('tersedia', true)
      .order('nama_menu')
  : { data: [], error: null };

const { data: menuRatings, error: ratingsError } = tenant
  ? await supabaseServer.rpc('get_public_menu_ratings', { p_tenant_id: tenant.id })
  : { data: [], error: null };

if (ratingsError) {
  console.error('Gagal memuat rating menu tenant:', ratingsError.message);
}

const menuRatingById = new Map((menuRatings ?? []).map((rating) => [rating.menu_item_id, rating]));
const tenantRatingTotals = (menuRatings ?? []).reduce(
  (totals, rating) => ({
    total: totals.total + (Number(rating.rating_total) || 0),
    count: totals.count + (Number(rating.review_count) || 0),
  }),
  { total: 0, count: 0 },
);
const menuCategories = [...new Set((menuItems ?? []).map((item) => item.kategori?.trim() || 'Menu kantin'))];
---

<Layout
  title={tenant ? `Menu ${tenant.nama_tenant} | SiKantin` : 'Kantin tidak ditemukan | SiKantin'}
  description={tenant
    ? `Jelajahi menu ${tenant.nama_tenant}, pilih add-on, dan pesan melalui SiKantin.`
    : 'Tenant yang Anda cari tidak ditemukan di SiKantin.'}
  keywords={tenant
    ? `SiKantin, ${tenant.nama_tenant}, menu ${tenant.nama_tenant}, pesan makanan kampus, kantin UYM`
    : 'SiKantin, kantin UYM, menu kantin kampus'}
  ogImage={tenant ? menuItems?.find((item) => item.foto_url)?.foto_url : undefined}
  themeColor="#172b40"
  bodyClass="tenant-guest min-h-screen"
>
  <header class="border-b border-white/10 bg-slate-950/30">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
      <a href="/" class="flex items-center gap-3 text-white">
        <img src={logo.src} alt="" class="h-10 w-10 rounded-full bg-white p-1" />
        <span class="font-extrabold">SiKantin UYM</span>
      </a>
      <a href="/cek-pesanan" class="rounded-full border border-white/15 px-4 py-2 text-sm font-bold text-white hover:bg-white/10">Cek Pesanan</a>
    </div>
  </header>

  {!tenant ? (
    <main class="mx-auto max-w-3xl px-4 py-20 text-center text-white">
      <h1 class="text-3xl font-black">{tenantError ? 'Tenant gagal dimuat' : 'Tenant tidak ditemukan'}</h1>
      <p class="mt-3 text-blue-100/70">{tenantError ? 'Coba muat ulang halaman beberapa saat lagi.' : 'Link tenant mungkin sudah berubah atau tidak tersedia.'}</p>
      <a href="/" class="mt-7 inline-flex rounded-xl bg-blue-600 px-5 py-3 font-bold hover:bg-blue-500">Kembali ke daftar kantin</a>
    </main>
  ) : (
    <main class="mx-auto max-w-7xl space-y-8 px-4 py-8 sm:px-6">
      <section class="tenant-menu-hero relative overflow-hidden rounded-3xl border border-white/10 p-6 text-white shadow-xl sm:p-8">
        <a href="/" class="text-sm font-bold text-blue-200 hover:text-white">← Semua kantin</a>
        <div class="mt-5 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-200">Menu kantin</p>
            <h1 class="mt-2 text-3xl font-black sm:text-4xl">{tenant.nama_tenant}</h1>
            <p class="mt-2 text-sm text-blue-100/70">{tenant.lokasi || 'Lokasi belum diisi'}</p>
            {tenant.jam_operasional && <p class="mt-1 text-sm text-blue-100/70">Jam operasional: {tenant.jam_operasional}</p>}
          </div>
          <div class="flex flex-wrap items-center gap-2">
            {tenantRatingTotals.count > 0 ? (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-yellow-200 bg-yellow-400 px-4 py-2 text-sm font-extrabold text-yellow-950 shadow-sm" aria-label={`Rating ${(tenantRatingTotals.total / tenantRatingTotals.count).toFixed(1)} dari 5`}>
                <span aria-hidden="true">★</span> {(tenantRatingTotals.total / tenantRatingTotals.count).toFixed(1)}
              </span>
            ) : (
              <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs font-semibold text-blue-100/70">Belum ada rating</span>
            )}
            <span class:list={[
              'rounded-full px-4 py-2 text-sm font-extrabold',
              tenant.status_buka ? 'bg-emerald-400/15 text-emerald-200' : 'bg-slate-400/15 text-slate-200',
            ]}>
              {tenant.status_buka ? 'Sedang buka' : 'Sedang tutup'}
            </span>
          </div>
        </div>
      </section>

      {menuError ? (
        <p role="alert" class="rounded-xl bg-rose-950/60 p-4 text-rose-100">Menu gagal dimuat. Coba muat ulang halaman.</p>
      ) : (
        <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
          <section class="min-w-0">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
              <div>
                <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-200">Pilih yang kamu suka</p>
                <h2 class="mt-1 text-2xl font-extrabold text-white">Katalog Menu</h2>
              </div>
              <p class="text-sm text-blue-100/65"><span id="visibleMenuCount">{menuItems?.length ?? 0}</span> menu tersedia</p>
            </div>
            {menuItems?.length ? (
              <>
                <div class="menu-tools rounded-2xl border border-white/10 bg-slate-950/25 p-4">
                  <label class="relative block">
                    <span class="sr-only">Cari menu</span>
                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-blue-100/45" aria-hidden="true">⌕</span>
                    <input id="menuSearch" type="search" autocomplete="off" placeholder="Cari menu favorit..." class="menu-search w-full rounded-xl border border-white/10 bg-slate-950/35 py-3 pl-10 pr-4 text-sm text-white outline-none transition placeholder:text-blue-100/40 focus:border-sky-300/50" />
                  </label>
                  <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter dan urutkan menu">
                    <button type="button" data-category-filter="all" aria-pressed="true" class="category-filter is-active rounded-full px-4 py-2 text-xs font-extrabold transition">Semua</button>
                    {menuCategories.map((category) => (
                      <button type="button" data-category-filter={category.toLowerCase()} aria-pressed="false" class="category-filter rounded-full px-4 py-2 text-xs font-extrabold transition">{category}</button>
                    ))}
                    <button type="button" data-menu-sort="cheapest" aria-pressed="false" class="category-filter rounded-full px-4 py-2 text-xs font-extrabold transition">Termurah <span aria-hidden="true">↓</span></button>
                  </div>
                </div>

              <div id="menuGrid" data-count={menuItems.length} class:list={['menu-grid mt-4 grid gap-5', menuItems.length === 1 ? 'menu-grid-single' : 'sm:grid-cols-2 xl:grid-cols-2']}>
                {menuItems.map((item) => (
                  <article
                    class="menu-card group overflow-hidden rounded-3xl border border-white/10 bg-white shadow-lg shadow-slate-950/20 transition duration-200 hover:-translate-y-1 hover:shadow-2xl"
                    data-menu-card
                    data-menu-category={(item.kategori || 'Menu kantin').trim().toLowerCase()}
                    data-menu-search={`${item.nama_menu} ${item.kategori || 'Menu kantin'}`.toLowerCase()}
                    data-menu-price={item.harga}
                  >
                    <div class="relative overflow-hidden">
                      <img
                        src={item.foto_url || logo.src}
                        alt={item.nama_menu}
                        loading="lazy"
                        class:list={['menu-photo w-full bg-slate-100 object-cover transition duration-500 group-hover:scale-105', menuItems.length === 1 ? 'h-64' : 'h-48']}
                      />
                      <span class="absolute left-3 top-3 rounded-full border border-white/70 bg-white/90 px-3 py-1 text-[11px] font-extrabold text-slate-700 shadow-sm backdrop-blur">
                        {item.kategori || 'Menu kantin'}
                      </span>
                      {(() => {
                        const rating = menuRatingById.get(item.id);
                        return rating ? (
                          <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full border border-yellow-200 bg-yellow-400 px-2.5 py-1 text-xs font-extrabold text-yellow-950 shadow-sm" aria-label={`Rating ${Number(rating.rating_average).toFixed(1)} dari 5`}>
                            <span aria-hidden="true">★</span> {Number(rating.rating_average).toFixed(1)}
                          </span>
                        ) : null;
                      })()}
                    </div>
                    <div class="p-5">
                      <div class="flex items-start justify-between gap-3">
                        <div>
                          <h3 class="text-lg font-extrabold tracking-tight text-slate-900">{item.nama_menu}</h3>
                          <p class="mt-1 text-xs text-slate-500">Persiapan {item.waktu_persiapan ?? 0} menit</p>
                        </div>
                        <p class="whitespace-nowrap text-sm font-black text-emerald-700">
                          Rp {Number(item.harga).toLocaleString('id-ID')}
                        </p>
                      </div>
                      {item.add_ons?.length ? (
                        <fieldset class="mt-4 rounded-2xl bg-slate-50 p-3">
                          <legend class="sr-only">Add-on (opsional)</legend>
                          <p class="text-xs font-extrabold text-slate-700">Tambahan pilihan</p>
                          <div class="mt-2 space-y-2">
                            {item.add_ons.map((addon) => (
                              <label class="flex cursor-pointer items-center justify-between gap-3 text-xs text-slate-600">
                                <span class="flex min-w-0 items-center gap-2">
                                  <input
                                    type="checkbox"
                                    data-menu-addon
                                    data-addon-id={addon.id}
                                    data-addon-name={addon.name}
                                    data-addon-price={addon.price}
                                    disabled={!tenant.status_buka}
                                    class="h-4 w-4 rounded accent-blue-700"
                                  />
                                  <span>{addon.name}</span>
                                </span>
                                <span class="shrink-0 font-semibold text-blue-700">
                                  {addon.price ? `+ Rp ${Number(addon.price).toLocaleString('id-ID')}` : 'Gratis'}
                                </span>
                              </label>
                            ))}
                          </div>
                        </fieldset>
                      ) : null}
                      <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-100 pt-4">
                        <span class="text-xs font-semibold text-slate-500">Jumlah</span>
                        <div class="flex items-center gap-3">
                          <button
                            type="button"
                            data-quantity-decrement
                            aria-label={`Kurangi ${item.nama_menu}`}
                            disabled={!tenant.status_buka}
                            class="menu-quantity-button"
                          >−</button>
                          <output data-quantity-value aria-live="polite" class="min-w-5 text-center text-sm font-extrabold text-slate-900">0</output>
                          <button
                            type="button"
                            data-quantity-increment
                            aria-label={`Tambah ${item.nama_menu}`}
                            disabled={!tenant.status_buka}
                            class="menu-quantity-button"
                          >+</button>
                        </div>
                      </div>
                      <div class="sr-only" data-menu-id={item.id} data-menu-name={item.nama_menu} data-menu-price={item.harga}></div>
                    </div>
                  </article>
                ))}
              </div>
                <p id="menuNoResults" class="mt-5 hidden rounded-2xl border border-white/10 bg-white/5 p-6 text-center text-sm text-blue-100/70">Tidak ada menu yang cocok. Coba kata kunci atau kategori lain.</p>
              </>
            ) : (
              <div class="menu-empty rounded-3xl border border-white/10 p-8 text-center text-white">
                <span class="text-5xl" aria-hidden="true">🍽️</span>
                <h3 class="mt-4 text-xl font-extrabold">Menu sedang disiapkan</h3>
                <p class="mt-2 text-sm text-blue-100/65">Menu dari {tenant.nama_tenant} akan segera tampil di sini.</p>
              </div>
            )}
          </section>

          <aside class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xl lg:sticky lg:top-5">
            <h2 class="text-xl font-extrabold text-slate-900">Pesanan Anda</h2>
            <ul id="guestCart" class="mt-4 space-y-3">
              <li class="text-sm text-slate-500">Pilih menu untuk mulai memesan.</li>
            </ul>
            <div class="mt-4 flex justify-between border-t border-slate-200 pt-4 font-extrabold text-slate-900">
              <span>Total</span><span id="guestCartTotal">Rp 0</span>
            </div>
            {!tenant.status_buka && (
              <p class="mt-4 rounded-lg bg-amber-50 p-3 text-xs font-semibold text-amber-800">Tenant sedang tutup. Pesanan baru belum dapat dibuat.</p>
            )}
            <form id="guestCheckoutForm" data-tenant-open={tenant.status_buka ? 'true' : 'false'} class="mt-5 space-y-4">
              <label class="block text-sm font-bold text-slate-700" for="guestNim">
                NIM mahasiswa
                <input id="guestNim" name="nim" inputmode="numeric" pattern="[0-9]{6,20}" minlength="6" maxlength="20" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 font-normal" />
                <span id="nimValidationMessage" class="mt-1 block text-xs font-normal text-slate-500">NIM akan diverifikasi sebelum pesanan dibuat.</span>
              </label>
              <label class="block text-sm font-bold text-slate-700" for="guestPhone">
                Nomor HP / WhatsApp
                <input id="guestPhone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="6281234567890" pattern="628[0-9]{8,13}" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 font-normal" />
                <span class="mt-1 block text-xs font-normal text-slate-500">Gunakan format 628... agar notifikasi WhatsApp dapat dikirim.</span>
              </label>
              <section class="rounded-xl border border-slate-200 bg-slate-50 p-4" aria-labelledby="guestQrisHeading">
                <h3 id="guestQrisHeading" class="font-extrabold text-slate-900">Pembayaran QRIS</h3>
                {tenant.qris_image_url ? (
                  <img
                    src={tenant.qris_image_url}
                    alt={`QRIS pembayaran ${tenant.nama_tenant}`}
                    loading="lazy"
                    class="mx-auto mt-3 max-h-64 w-full rounded-lg bg-white object-contain p-2"
                  />
                ) : (
                  <p class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-800">QRIS tenant belum tersedia.</p>
                )}
                <p class="mt-3 text-sm text-slate-600">Silakan scan QRIS tenant dan upload bukti transfer.</p>
                <label for="guestTransferProof" class="mt-3 block text-sm font-bold text-slate-700">
                  Bukti transfer (JPG/PNG)
                  <input
                    id="guestTransferProof"
                    name="bukti_transfer"
                    type="file"
                    accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                    required
                    class="mt-1.5 block w-full rounded-lg border border-slate-300 p-2 text-sm font-normal file:mr-3 file:rounded-md file:border-0 file:bg-blue-50 file:px-3 file:py-2 file:font-bold file:text-blue-700"
                  />
                  <span class="mt-1 block text-xs font-normal text-slate-500">Format JPG atau PNG, maksimal 5 MB.</span>
                </label>
              </section>
              <p id="checkoutMessage" role="status" aria-live="polite" class="hidden rounded-lg p-3 text-sm"></p>
              <div class="sticky bottom-0 z-10 -mx-1 bg-white/95 py-2 backdrop-blur">
                <button
                  id="guestCheckoutButton"
                  type="submit"
                  class="w-full rounded-lg bg-emerald-500 px-4 py-3 font-extrabold text-emerald-950 shadow-md transition hover:bg-emerald-400 hover:shadow-lg disabled:cursor-not-allowed disabled:opacity-60"
                  disabled={!tenant.status_buka || !menuItems?.length}
                >
                  Buat Pesanan
                </button>
              </div>
            </form>
            <section id="orderConfirmation" class="mt-5 hidden rounded-xl border border-emerald-200 bg-emerald-50 p-4" aria-live="polite">
              <h3 class="font-extrabold text-emerald-900">Pesanan berhasil dibuat</h3>
              <p class="mt-3 text-xs font-bold uppercase tracking-wide text-emerald-800">Nomor antrean</p>
              <p id="confirmationQueueNumber" class="mt-1 text-4xl font-black tracking-tight text-emerald-950"></p>
              <p class="mt-2 text-sm text-emerald-800">Nomor pesanan: <strong id="confirmationNumber"></strong></p>
              <p class="mt-2 text-sm text-emerald-800">Token cek pesanan:</p>
              <code id="confirmationToken" class="mt-1 block break-all rounded bg-white p-2 text-sm font-extrabold text-emerald-900"></code>
              <a id="trackOrderLink" href="/cek-pesanan" class="mt-3 inline-flex text-sm font-bold text-emerald-800 underline">Pantau status pesanan</a>
              <p id="whatsappNotice" class="mt-2 text-xs text-emerald-800"></p>
            </section>
          </aside>
        </div>
      )}
    </main>
  )}
  <script>
    import { db } from '../../scripts/supabase.js';

    const guestCart = new Map();
    const cartList = document.getElementById('guestCart');
    const totalElement = document.getElementById('guestCartTotal');
    const checkoutForm = document.getElementById('guestCheckoutForm');
    const checkoutMessage = document.getElementById('checkoutMessage');
    const checkoutButton = document.getElementById('guestCheckoutButton');
    const proofInput = document.getElementById('guestTransferProof');
    const tenantSlug = window.location.pathname.split('/').filter(Boolean).at(-1);
    const tenantIsOpen = checkoutForm?.dataset.tenantOpen === 'true';
    const menuSearch = document.getElementById('menuSearch');
    const menuGrid = document.getElementById('menuGrid');
    const menuCards = [...document.querySelectorAll('[data-menu-card]')];
    const categoryFilters = [...document.querySelectorAll('[data-category-filter]')];
    const menuSortButtons = [...document.querySelectorAll('[data-menu-sort]')];
    const visibleMenuCount = document.getElementById('visibleMenuCount');
    const menuNoResults = document.getElementById('menuNoResults');
    let activeCategory = 'all';
    let sortByCheapest = false;
    let nimIsValid = false;
    let validatingNim = false;

    function filterMenuCards() {
      const searchTerm = menuSearch?.value.trim().toLocaleLowerCase('id-ID') || '';
      let visibleCount = 0;
      menuCards.forEach((card) => {
        const categoryMatches = activeCategory === 'all' || card.dataset.menuCategory === activeCategory;
        const searchMatches = card.dataset.menuSearch.includes(searchTerm);
        const visible = categoryMatches && searchMatches;
        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount += 1;
      });
      if (visibleMenuCount) visibleMenuCount.textContent = String(visibleCount);
      menuNoResults?.classList.toggle('hidden', visibleCount > 0);
    }

    menuSearch?.addEventListener('input', filterMenuCards);
    categoryFilters.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.categoryFilter;
        categoryFilters.forEach((filterButton) => {
          const active = filterButton === button;
          filterButton.classList.toggle('is-active', active);
          filterButton.setAttribute('aria-pressed', String(active));
        });
        filterMenuCards();
      });
    });

    menuSortButtons.forEach((button) => {
      button.addEventListener('click', () => {
        sortByCheapest = !sortByCheapest;
        button.classList.toggle('is-active', sortByCheapest);
        button.setAttribute('aria-pressed', String(sortByCheapest));
        const sortedCards = [...menuCards].sort((a, b) => sortByCheapest
          ? Number(a.dataset.menuPrice) - Number(b.dataset.menuPrice)
          : menuCards.indexOf(a) - menuCards.indexOf(b));
        sortedCards.forEach((card) => menuGrid?.append(card));
      });
    });

    function showCheckoutMessage(text, isError) {
      checkoutMessage.textContent = text;
      checkoutMessage.className = `rounded-lg p-3 text-sm ${isError ? 'bg-rose-50 text-rose-700' : 'bg-emerald-50 text-emerald-700'}`;
    }

    async function getFunctionErrorMessage(error) {
      console.error('Supabase Edge Function request failed:', error);
      if (error?.context instanceof Response) {
        const body = await error.context.clone().json().catch(() => null);
        if (typeof body?.error === 'string') return body.error;
        if (typeof body?.message === 'string') return body.message;
      }
      return error?.message || 'Tidak dapat terhubung ke Supabase Edge Function.';
    }

    function getCreatedOrder(response) {
      const candidates = [
        response?.order,
        response?.data?.order,
        response?.result?.order,
        response?.data,
        response?.result,
      ];
      return candidates.find((candidate) =>
        candidate
        && typeof candidate === 'object'
        && typeof candidate.nomor_pesanan === 'string'
        && typeof candidate.token_pesanan === 'string'
      );
    }

    function formatRupiah(value) {
      return `Rp ${Number(value).toLocaleString('id-ID')}`;
    }

    function getUnitPrice(item) {
      return item.price + item.addons.reduce((sum, addon) => sum + addon.price, 0);
    }

    function getCartKey(menu, selectedAddons) {
      const addonKey = selectedAddons.map((addon) => addon.id).sort().join(',');
      return `${menu.id}:${addonKey}`;
    }

    function getSelectedAddons(card) {
      return [...card.querySelectorAll('[data-menu-addon]:checked')].map((input) => ({
        id: input.dataset.addonId,
        name: input.dataset.addonName,
        price: Number(input.dataset.addonPrice),
      }));
    }

    function getMenuFromCard(card) {
      const details = card.querySelector('[data-menu-id]');
      return {
        id: details.dataset.menuId,
        name: details.dataset.menuName,
        price: Number(details.dataset.menuPrice),
      };
    }

    function addMenuToCart(menu, selectedAddons) {
      const key = getCartKey(menu, selectedAddons);
      const item = guestCart.get(key) || {
        key,
        id: menu.id,
        name: menu.name,
        price: menu.price,
        addons: selectedAddons,
        quantity: 0,
      };
      if (item.quantity < 50) item.quantity += 1;
      guestCart.set(key, item);
      renderCart();
    }

    function updateCardQuantity(card) {
      const menu = getMenuFromCard(card);
      const key = getCartKey(menu, getSelectedAddons(card));
      const quantity = guestCart.get(key)?.quantity || 0;
      const decrement = card.querySelector('[data-quantity-decrement]');
      const increment = card.querySelector('[data-quantity-increment]');
      card.querySelector('[data-quantity-value]').textContent = String(quantity);
      decrement.disabled = !tenantIsOpen || quantity === 0;
      increment.disabled = !tenantIsOpen || quantity >= 50;
    }

    function changeCardQuantity(card, change) {
      const menu = getMenuFromCard(card);
      const selectedAddons = getSelectedAddons(card);
      const key = getCartKey(menu, selectedAddons);
      const item = guestCart.get(key);
      if (change > 0) {
        addMenuToCart(menu, selectedAddons);
      } else if (item) {
        if (item.quantity <= 1) guestCart.delete(key);
        else item.quantity -= 1;
        renderCart();
      }
    }

    function renderCart() {
      cartList.replaceChildren();
      if (!guestCart.size) {
        const empty = document.createElement('li');
        empty.className = 'text-sm text-slate-500';
        empty.textContent = 'Pilih menu untuk mulai memesan.';
        cartList.append(empty);
      }

      let total = 0;
      for (const item of guestCart.values()) {
        const unitPrice = getUnitPrice(item);
        total += unitPrice * item.quantity;
        const row = document.createElement('li');
        row.className = 'flex items-start justify-between gap-2 border-b border-slate-100 pb-3 text-sm last:border-0';
        const details = document.createElement('span');
        details.className = 'min-w-0 flex-1';
        const description = document.createElement('span');
        description.className = 'block font-semibold text-slate-700';
        description.textContent = `${item.name} × ${item.quantity}`;
        details.append(description);
        if (item.addons.length) {
          const addonNames = document.createElement('span');
          addonNames.className = 'mt-1 block text-xs text-slate-500';
          addonNames.textContent = `+ ${item.addons.map((addon) => addon.name).join(', ')}`;
          details.append(addonNames);
        }
        const controls = document.createElement('span');
        controls.className = 'flex items-center gap-1';
        const price = document.createElement('span');
        price.className = 'whitespace-nowrap px-1 text-right font-bold text-slate-900';
        price.textContent = formatRupiah(unitPrice * item.quantity);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'rounded p-1.5 text-rose-600 transition hover:bg-rose-50 hover:text-rose-700';
        remove.innerHTML = '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M10 11v6m4-6v6M5.5 7l1 13h11l1-13M9 7V4h6v3"/></svg>';
        remove.setAttribute('aria-label', `Hapus ${item.name} dari pesanan`);
        remove.addEventListener('click', () => {
          guestCart.delete(item.key);
          renderCart();
        });
        const add = document.createElement('button');
        add.type = 'button';
        add.className = 'rounded px-2 py-1 text-blue-700 hover:bg-blue-50';
        add.textContent = '+';
        add.setAttribute('aria-label', `Tambah ${item.name}`);
        add.addEventListener('click', () => {
          if (item.quantity < 50) item.quantity += 1;
          renderCart();
        });
        controls.append(price, remove, add);
        row.append(details, controls);
        cartList.append(row);
      }
      totalElement.textContent = formatRupiah(total);
      checkoutButton.disabled = !guestCart.size || !tenantIsOpen;
      menuCards.forEach(updateCardQuantity);
    }

    menuCards.forEach((card) => {
      card.querySelector('[data-quantity-decrement]').addEventListener('click', () => changeCardQuantity(card, -1));
      card.querySelector('[data-quantity-increment]').addEventListener('click', () => changeCardQuantity(card, 1));
      card.querySelectorAll('[data-menu-addon]').forEach((input) => {
        input.addEventListener('change', () => updateCardQuantity(card));
      });
    });
    menuCards.forEach(updateCardQuantity);

    const nimInput = document.getElementById('guestNim');
    const nimStatus = document.getElementById('nimValidationMessage');
    nimInput?.addEventListener('input', () => {
      nimIsValid = false;
      nimStatus.textContent = 'NIM akan diverifikasi sebelum pesanan dibuat.';
    });
    nimInput?.addEventListener('blur', async () => {
      const nim = nimInput.value.trim();
      if (!/^\d{6,20}$/.test(nim) || validatingNim) return;
      validatingNim = true;
      nimStatus.textContent = 'Memeriksa NIM...';
      try {
        const { data, error } = await db.functions.invoke('validate-nim', {
          body: { nim },
          timeout: 10000,
        });
        if (error) throw new Error(await getFunctionErrorMessage(error));
        if (data?.error || data?.success === false) throw new Error(data.error || data.message || 'Validasi NIM gagal.');
        nimIsValid = data?.valid === true;
        nimStatus.textContent = nimIsValid ? 'NIM terverifikasi.' : 'NIM tidak terdaftar sebagai mahasiswa.';
        nimStatus.className = `mt-1 block text-xs font-normal ${nimIsValid ? 'text-emerald-700' : 'text-rose-600'}`;
      } catch (error) {
        nimStatus.textContent = `Validasi NIM gagal: ${error.message}`;
        nimStatus.className = 'mt-1 block text-xs font-normal text-rose-600';
      } finally {
        validatingNim = false;
      }
    });

    checkoutForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!tenantIsOpen) {
        showCheckoutMessage('Tenant sedang tutup dan belum dapat menerima pesanan.', true);
        return;
      }
      if (!guestCart.size) {
        showCheckoutMessage('Tambahkan menu sebelum membuat pesanan.', true);
        return;
      }
      const nim = nimInput.value.trim();
      const phone = document.getElementById('guestPhone').value.replace(/[\s()+-]/g, '');
      const proofFile = proofInput.files?.[0];
      if (!/^\d{6,20}$/.test(nim)) {
        showCheckoutMessage('NIM harus terdiri dari 6 sampai 20 digit.', true);
        nimInput.focus();
        return;
      }
      if (!/^628\d{8,13}$/.test(phone)) {
        showCheckoutMessage('Nomor HP harus memakai format 628 yang valid.', true);
        return;
      }
      const validProof = proofFile
        && /\.(jpe?g|png)$/i.test(proofFile.name)
        && ['image/jpeg', 'image/png'].includes(proofFile.type);
      if (!validProof) {
        showCheckoutMessage('Silakan pilih bukti transfer berupa file JPG atau PNG.', true);
        proofInput.focus();
        return;
      }
      if (proofFile.size > 5 * 1024 * 1024) {
        showCheckoutMessage('Ukuran bukti transfer maksimal 5 MB.', true);
        proofInput.focus();
        return;
      }

      checkoutButton.disabled = true;
      checkoutButton.textContent = 'Mengunggah bukti dan membuat pesanan...';
      try {
        nimStatus.textContent = 'Memeriksa NIM...';
        const { data: validation, error: validationError } = await db.functions.invoke('validate-nim', {
          body: { nim },
          timeout: 10000,
        });
        if (validationError) throw new Error(await getFunctionErrorMessage(validationError));
        if (validation?.error) throw new Error(validation.error);
        if (validation?.valid !== true) {
          nimIsValid = false;
          nimStatus.textContent = validation?.message || 'NIM tidak terdaftar sebagai mahasiswa.';
          nimStatus.className = 'mt-1 block text-xs font-normal text-rose-600';
          throw new Error('NIM tidak valid.');
        }
        nimIsValid = true;
        nimStatus.textContent = 'NIM terverifikasi.';
        nimStatus.className = 'mt-1 block text-xs font-normal text-emerald-700';
        const orderForm = new FormData();
        orderForm.set('tenant_slug', tenantSlug);
        orderForm.set('nim', nim);
        orderForm.set('phone', phone);
        orderForm.set('items', JSON.stringify([...guestCart.values()].map(({ id, quantity, addons }) => ({
          menu_item_id: id,
          qty: quantity,
          addon_ids: addons.map((addon) => addon.id),
        }))));
        orderForm.set('proof', proofFile);
        const { data, error } = await db.functions.invoke('create-guest-order', {
          body: orderForm,
          timeout: 30000,
        });
        if (error) throw new Error(await getFunctionErrorMessage(error));
        if (data?.error || data?.success === false) {
          throw new Error(data.error || data.message || 'Pembuatan pesanan gagal.');
        }
        const order = getCreatedOrder(data);
        if (!order) {
          console.error('Respons create-guest-order tidak sesuai kontrak:', data);
          throw new Error('Respons create-guest-order tidak berisi nomor dan token pesanan. Pastikan Edge Function sudah di-deploy ulang.');
        }

        document.getElementById('confirmationNumber').textContent = order.nomor_pesanan;
        const validQueueNumber = typeof order.nomor_antrean === 'string' && /^A-\d{2,}$/.test(order.nomor_antrean);
        document.getElementById('confirmationQueueNumber').textContent = validQueueNumber
          ? order.nomor_antrean
          : 'Belum tersedia';
        if (!validQueueNumber) {
          console.error('Pesanan berhasil dibuat tanpa nomor antrean yang valid:', order);
        }
        document.getElementById('confirmationToken').textContent = order.token_pesanan;
        document.getElementById('trackOrderLink').href = `/cek-pesanan?token=${encodeURIComponent(order.token_pesanan)}`;
        document.getElementById('whatsappNotice').textContent = !validQueueNumber
          ? 'Pesanan tersimpan. Nomor antrean belum tersedia; gunakan token di halaman cek pesanan.'
          : data.whatsapp === 'sent'
          ? 'Token pesanan juga dikirim ke WhatsApp Anda.'
          : data.whatsapp === 'not_configured'
            ? 'Simpan token ini untuk mengecek status pesanan; notifikasi WhatsApp belum dikonfigurasi.'
            : 'Pesanan tersimpan, tetapi notifikasi WhatsApp gagal dikirim. Simpan token untuk mengecek status.';
        document.getElementById('orderConfirmation').classList.remove('hidden');
        checkoutForm.classList.add('hidden');
        guestCart.clear();
        renderCart();
      } catch (error) {
        console.error('Checkout guest gagal:', error);
        showCheckoutMessage(`Pesanan gagal dibuat: ${error.message || error}`, true);
        checkoutButton.disabled = false;
      } finally {
        checkoutButton.textContent = 'Buat Pesanan';
      }
    });
  </script>
</Layout>