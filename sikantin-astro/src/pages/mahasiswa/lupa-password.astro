---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Bantuan Password Mahasiswa | SiKantin" description="Hubungi administrator SiKantin untuk bantuan reset password mahasiswa." themeColor="#172b40" bodyClass="flex min-h-screen items-center justify-center bg-slate-950 px-4 py-8 text-white" noIndex>
	<main class="w-full max-w-md rounded-3xl border border-white/10 bg-slate-900 p-6 shadow-2xl sm:p-9">
		<a href="/mahasiswa/login" class="text-sm font-bold text-blue-200 hover:text-white">← Kembali ke login</a>
		<div class="mb-7 mt-8">
			<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-sky-300">Bantuan akun</p>
			<h1 class="mt-2 text-3xl font-black">Lupa password?</h1>
			<p class="mt-2 text-sm leading-6 text-blue-100/65">Untuk menjaga keamanan akun, hubungi administrator SiKantin agar password direset. Administrator akan memberikan password sementara secara langsung.</p>
		</div>
		<a href="/mahasiswa/login" class="block w-full rounded-xl bg-blue-500 px-4 py-3 text-center font-extrabold text-white transition hover:bg-blue-400">Kembali ke login</a>
	</main>
</Layout>
