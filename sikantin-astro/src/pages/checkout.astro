---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-uym.png';
import { supabaseServer } from '../lib/supabase-server.js';
import '../styles/tenant-guest.css';

const tenantSlug = Astro.url.searchParams.get('tenant')?.trim() || '';
let tenant = null;
let tenantError = null;
if (tenantSlug) {
  const tenantResult = await supabaseServer
    .from('tenants')
    .select('id, nama_tenant, slug, status_buka, qris_image_url')
    .eq('slug', tenantSlug)
    .maybeSingle();
  tenant = tenantResult.data;
  tenantError = tenantResult.error;
}

if (tenantError) {
  console.error('Gagal memuat tenant untuk checkout:', tenantError.message);
  Astro.response.status = 500;
} else if (!tenant) {
  Astro.response.status = tenantSlug ? 404 : 400;
}

function isTenantOpen(value) {
  if (value === true || value === 1) return true;
  if (typeof value !== 'string') return false;
  return ['true', '1'].includes(value.trim().toLowerCase());
}

const tenantIsOpen = isTenantOpen(tenant?.status_buka);
---

<Layout
  title={tenant ? `Checkout | ${tenant.nama_tenant} | SiKantin` : 'Checkout | SiKantin'}
  description="Periksa pesanan, isi identitas, dan selesaikan pembayaran melalui SiKantin."
  themeColor="#172b40"
  bodyClass="tenant-guest checkout-page min-h-screen"
  noIndex
>
  <header class="site-header border-b border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-900">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
      <a href="/" class="flex items-center gap-3 text-slate-800 dark:text-white">
        <img src={logo.src} alt="" class="h-10 w-10 rounded-full border border-slate-200 bg-white object-cover dark:border-slate-700" />
        <span class="uym-brand-text font-extrabold">SiKantin UYM</span>
      </a>
      <div class="flex items-center gap-2">
        <span data-theme-toggle-slot class="contents"></span>
        <a id="checkoutBackButton" href={tenant ? `/tenant/${encodeURIComponent(tenant.slug)}` : '/'} class="arrow-action arrow-left rounded-full border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"><span class="arrow-icon" aria-hidden="true">←</span>Kembali</a>
      </div>
    </div>
  </header>

  {!tenant ? (
    <main class="mx-auto max-w-3xl px-4 py-16">
      <section class="rounded-2xl border border-rose-200 bg-white p-6 text-center shadow-sm dark:border-rose-900 dark:bg-slate-800">
        <h1 class="text-xl font-extrabold text-slate-800 dark:text-white">{tenantError ? 'Checkout gagal dimuat' : 'Tenant tidak ditemukan'}</h1>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{tenantError ? 'Terjadi kendala saat memuat informasi kantin. Silakan coba kembali.' : 'Pilih tenant dari katalog untuk melanjutkan checkout.'}</p>
        <a href="/" class="arrow-action arrow-left checkout-catalog-link mt-5 inline-flex rounded-xl bg-blue-700 px-5 py-3 text-sm font-bold text-white hover:bg-blue-800"><span class="arrow-icon" aria-hidden="true">←</span>Kembali ke katalog</a>
      </section>
    </main>
  ) : (
    <main
      id="checkoutPage"
      data-tenant-id={tenant.id}
      data-tenant-slug={tenant.slug}
      data-tenant-open={tenantIsOpen ? 'true' : 'false'}
      class="mx-auto max-w-6xl space-y-6 px-4 py-6 sm:px-6 sm:py-8"
    >
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-700 dark:text-blue-300">Langkah terakhir</p>
        <h1 class="mt-1 text-3xl font-black text-slate-800 dark:text-white sm:text-4xl">Checkout</h1>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Periksa pesanan dari <span class="font-bold text-slate-800 dark:text-slate-200">{tenant.nama_tenant}</span>, lalu lengkapi pembayaran.</p>
      </div>

      <p id="checkoutPageMessage" role="status" aria-live="polite" class="hidden rounded-xl border p-4 text-sm"></p>

      <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <section class="checkout-summary rounded-2xl border border-slate-200 bg-white p-5 shadow-sm shadow-slate-200/70 dark:border-slate-700 dark:bg-slate-800 dark:shadow-black/20 sm:p-6" aria-labelledby="checkoutSummaryHeading">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-800 dark:text-blue-300">Ringkasan</p>
              <h2 id="checkoutSummaryHeading" class="mt-1 text-xl font-extrabold text-slate-800 dark:text-white">Pesanan Anda</h2>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{tenant.nama_tenant}</p>
            </div>
            <span id="checkoutItemCount" class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-200">0 item</span>
          </div>
          <ul id="checkoutItems" class="mt-5 divide-y divide-slate-100 dark:divide-slate-700">
            <li class="grid gap-3 py-4" role="status" aria-label="Memuat ringkasan pesanan"><span class="skeleton-line block w-2/3"></span><span class="skeleton-line block w-1/2"></span></li>
          </ul>
          <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-200 pt-4 text-base font-extrabold text-slate-900 dark:border-slate-700 dark:text-white">
            <span>Total pembayaran</span>
            <span id="checkoutTotal">Rp 0</span>
          </div>
          <a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="mt-5 inline-flex text-sm font-bold text-blue-800 hover:underline dark:text-blue-300">← Ubah pilihan menu</a>
        </section>

        <form id="guestCheckoutForm" class="space-y-5">
          <div id="studentCheckoutInfo" role="status" aria-live="polite" class="hidden rounded-xl border border-blue-200 bg-blue-50 p-3 text-sm text-blue-900 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-100"></div>
          <section id="studentCheckoutProfileCard" class="hidden rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 to-white p-4 shadow-sm dark:border-emerald-900 dark:from-slate-800 dark:to-slate-900 sm:p-5" aria-label="Profil checkout">
            <div class="mb-4 flex items-center justify-between gap-2">
              <div>
                <p class="text-[11px] font-extrabold uppercase tracking-[0.16em] text-emerald-800 dark:text-emerald-300">Checkout Mahasiswa</p>
                <p class="mt-1 text-xs text-slate-800 dark:text-slate-400">Data terhubung ke profil kamu</p>
              </div>
              <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-[11px] font-bold text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200">Login</span>
            </div>
            <div class="flex min-w-0 items-center gap-3">
              <img id="checkoutStudentAvatar" src="" alt="" class="h-12 w-12 rounded-full bg-white object-cover" />
              <div class="min-w-0">
                <p id="checkoutStudentName" class="truncate font-extrabold text-slate-800 dark:text-white"></p>
                <p id="checkoutStudentPhone" class="mt-0.5 text-sm text-slate-800 dark:text-slate-400"></p>
              </div>
            </div>
            <p class="mt-4 flex items-center gap-2 border-t border-emerald-200 pt-3 text-xs font-semibold leading-5 text-emerald-800 dark:border-emerald-900 dark:text-emerald-300">
              <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0"><path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.2 7.26a1 1 0 0 1-1.42.003L3.294 9.18a1 1 0 1 1 1.412-1.416l4.086 4.076 6.498-6.545a1 1 0 0 1 1.414-.006Z" clip-rule="evenodd" /></svg>
              Pesanan akan dikirim ke nomor ini.
            </p>
          </section>

          <section class="checkout-form-section rounded-2xl border border-slate-200 bg-white p-5 shadow-sm shadow-slate-200/70 dark:border-slate-700 dark:bg-slate-800 dark:shadow-black/20 sm:p-6" aria-labelledby="checkoutIdentityHeading">
            <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-800 dark:text-blue-300">Identitas</p>
            <h2 id="checkoutIdentityHeading" class="mt-1 text-xl font-extrabold text-slate-800 dark:text-white">Data pemesan</h2>
            <div class="mt-4 space-y-4">
              <label id="guestNimField" class="hidden text-sm font-bold text-slate-800 dark:text-slate-200" for="guestNim">
                NIM mahasiswa
                <input id="guestNim" name="nim" inputmode="numeric" pattern="[0-9]{6,20}" minlength="6" maxlength="20" required class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 font-normal text-slate-800 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" />
                <span id="nimValidationMessage" class="mt-1 block text-xs font-normal text-slate-500 dark:text-slate-400">NIM akan diverifikasi sebelum pesanan dibuat.</span>
              </label>
              <label id="guestPhoneField" class="hidden text-sm font-bold text-slate-800 dark:text-slate-200" for="guestPhone">
                Nomor HP / WhatsApp
                <input id="guestPhone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="6281234567890" pattern="628[0-9]{8,13}" required class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 font-normal text-slate-800 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" />
                <span class="mt-1 block text-xs font-normal text-slate-500 dark:text-slate-400">Gunakan format 628... agar notifikasi WhatsApp dapat dikirim.</span>
              </label>
            </div>
          </section>

          <section class="checkout-form-section rounded-2xl border border-slate-200 bg-white p-5 shadow-sm shadow-slate-200/70 dark:border-slate-700 dark:bg-slate-800 dark:shadow-black/20 sm:p-6" aria-labelledby="guestQrisHeading">
            <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-800 dark:text-blue-300">Pembayaran</p>
            <h2 id="guestQrisHeading" class="mt-1 text-xl font-extrabold text-slate-800 dark:text-white">Pembayaran QRIS</h2>
            {tenant.qris_image_url ? (
              <img src={tenant.qris_image_url} alt={`QRIS pembayaran ${tenant.nama_tenant}`} loading="lazy" class="mx-auto mt-4 max-h-64 w-full rounded-xl border border-slate-100 bg-white object-contain p-3" />
            ) : (
              <p class="mt-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200">QRIS tenant belum tersedia.</p>
            )}
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Silakan scan QRIS tenant dan upload bukti transfer.</p>
            <label for="guestTransferProof" class="mt-4 block text-sm font-bold text-slate-800 dark:text-slate-200">
              Bukti transfer (JPG/PNG)
              <input id="guestTransferProof" name="bukti_transfer" type="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white p-2 text-sm font-normal text-slate-800 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 file:mr-3 file:rounded-md file:border-0 file:bg-blue-50 file:px-3 file:py-2 file:font-bold file:text-blue-800 dark:file:bg-blue-950 dark:file:text-blue-200" />
              <span class="mt-1 block text-xs font-normal text-slate-500 dark:text-slate-400">Format JPG atau PNG, maksimal 5 MB.</span>
            </label>
          </section>

          <p id="checkoutMessage" role="status" aria-live="polite" class="hidden rounded-lg p-3 text-sm"></p>
          <p id="tenantClosedMessage" class:list={['rounded-lg bg-amber-50 p-3 text-sm font-semibold text-amber-900 dark:bg-amber-950 dark:text-amber-200', tenantIsOpen ? 'hidden' : '' ]}>Tenant sedang tutup dan belum dapat menerima pesanan.</p>
          <button id="guestCheckoutButton" type="submit" class="arrow-action w-full rounded-xl bg-emerald-700 px-5 py-4 text-base font-extrabold text-white shadow-md transition hover:bg-emerald-800 dark:bg-emerald-500 dark:text-emerald-950 dark:hover:bg-emerald-400 hover:shadow-lg disabled:cursor-not-allowed disabled:opacity-50" disabled>
            Buat Pesanan <span class="arrow-icon" aria-hidden="true">→</span>
          </button>
        </form>
      </div>

      <section id="orderConfirmation" class="hidden rounded-2xl border border-emerald-200 bg-emerald-50 p-5 shadow-sm dark:border-emerald-900 dark:bg-emerald-950 sm:p-6" aria-live="polite">
        <h2 class="text-xl font-extrabold text-emerald-900 dark:text-emerald-200">Pesanan berhasil dibuat</h2>
        <p class="mt-3 text-xs font-bold uppercase tracking-wide text-emerald-800 dark:text-emerald-300">Nomor antrean</p>
        <p id="confirmationQueueNumber" class="mt-1 text-4xl font-black tracking-tight text-emerald-950 dark:text-white"></p>
        <p class="mt-2 text-sm text-emerald-800 dark:text-emerald-300">Nomor pesanan: <strong id="confirmationNumber"></strong></p>
        <p class="mt-2 text-sm text-emerald-800 dark:text-emerald-300">Token cek pesanan:</p>
        <code id="confirmationToken" class="mt-1 block break-all rounded bg-white p-2 text-sm font-extrabold text-emerald-900 dark:bg-slate-900 dark:text-emerald-200"></code>
        <a id="trackOrderLink" href="/cek-pesanan" class="mt-3 inline-flex text-sm font-bold text-emerald-800 underline dark:text-emerald-300">Pantau status pesanan</a>
        <p id="whatsappNotice" class="mt-2 text-sm text-emerald-800 dark:text-emerald-300"></p>
      </section>
    </main>
  )}

  <style is:global>
    html:not(.dark) body.checkout-page {
      background: #f8fafc;
      color: #1e293b;
    }

    html.dark body.checkout-page {
      background: #0f172a;
      color: #f8fafc;
    }

    html.dark body.checkout-page .checkout-summary,
    html.dark body.checkout-page .checkout-form-section {
      border-color: #334155;
      background-color: #1e293b !important;
    }

    html:not(.dark) body.checkout-page #guestCheckoutButton,
    html:not(.dark) body.checkout-page .checkout-catalog-link {
      color: #fff;
    }

    html.dark body.checkout-page #guestCheckoutButton {
      color: #022c22;
    }

    html.dark body.checkout-page .checkout-catalog-link {
      color: #fff;
    }
  </style>

  <script>
    const checkoutBackButton = document.getElementById('checkoutBackButton');
    checkoutBackButton?.addEventListener('click', (event) => {
      event.preventDefault();
      if (window.history.length > 1) window.history.back();
      else window.location.assign(checkoutBackButton.href);
    });
  </script>

  {tenant && (
    <script>
      import { db } from '../scripts/supabase.js';

      const checkoutPage = document.getElementById('checkoutPage');
      const checkoutForm = document.getElementById('guestCheckoutForm');
      const checkoutMessage = document.getElementById('checkoutMessage');
      const pageMessage = document.getElementById('checkoutPageMessage');
      const checkoutButton = document.getElementById('guestCheckoutButton');
      const proofInput = document.getElementById('guestTransferProof');
      const studentCheckoutInfo = document.getElementById('studentCheckoutInfo');
      const studentCheckoutProfileCard = document.getElementById('studentCheckoutProfileCard');
      const tenantSlug = checkoutPage.dataset.tenantSlug;
      const storageKey = 'sikantin-checkout-cart-v1';
      const referrerStorageKey = 'referrer';
      let tenantIsOpen = checkoutPage.dataset.tenantOpen === 'true';
      let cartItems = [];
      let cartIsValid = false;
      let studentCheckoutProfile = null;
      let studentProfileRequiresCompletion = false;
      let studentCheckoutReady = false;
      let studentSessionDetected = false;
      let validatingNim = false;
      let tenantStatusChannel;
      let tenantStatusRevision = 0;

      try {
        if (sessionStorage.getItem(referrerStorageKey) !== '/mahasiswa/dashboard') {
          sessionStorage.setItem(referrerStorageKey, '/');
        }
      } catch (error) {
        console.warn('Asal tenant checkout tidak dapat disimpan:', error);
      }

      function showPageMessage(text, isError = true) {
        pageMessage.textContent = text;
        if (!text) {
          pageMessage.className = 'hidden';
          return;
        }
        pageMessage.className = `rounded-xl border p-4 text-sm ${isError ? 'border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-900 dark:bg-rose-950 dark:text-rose-200' : 'border-blue-200 bg-blue-50 text-blue-900 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-100'}`;
      }

      function formatRupiah(value) {
        return `Rp ${Number(value).toLocaleString('id-ID')}`;
      }

      function getUnitPrice(item) {
        return item.price + item.addons.reduce((sum, addon) => sum + addon.price, 0);
      }

      function loadCart() {
        let rawCart;
        try {
          rawCart = sessionStorage.getItem(storageKey);
        } catch (error) {
          console.error('Keranjang checkout gagal dibaca:', error);
          showPageMessage('Keranjang tidak dapat dibaca oleh browser. Kembali ke menu dan coba lagi.');
          return;
        }
        if (!rawCart) {
          showPageMessage('Keranjang checkout tidak ditemukan. Kembali ke menu untuk memilih pesanan.');
          return;
        }

        let savedCart;
        try {
          savedCart = JSON.parse(rawCart);
        } catch (error) {
          console.error('Data keranjang checkout tidak valid:', error);
          showPageMessage('Data keranjang tidak valid. Kembali ke menu dan pilih pesanan kembali.');
          return;
        }

        const validItems = Array.isArray(savedCart?.items) && savedCart.items.length > 0
          && savedCart.tenantSlug === tenantSlug
          && savedCart.tenantId === checkoutPage.dataset.tenantId
          && savedCart.items.every((item) =>
            typeof item?.id === 'string'
            && typeof item.name === 'string'
            && Number.isFinite(item.price)
            && Number.isInteger(item.quantity)
            && item.quantity >= 1
            && item.quantity <= 50
            && Array.isArray(item.addons)
            && item.addons.every((addon) =>
              typeof addon?.id === 'string'
              && typeof addon.name === 'string'
              && Number.isFinite(addon.price)
            )
          );
        if (!validItems) {
          showPageMessage('Keranjang tidak cocok dengan tenant atau berisi data yang tidak valid. Kembali ke menu dan pilih pesanan kembali.');
          return;
        }

        cartItems = savedCart.items;
        cartIsValid = true;
        renderCartSummary();
      }

      function renderCartSummary() {
        const list = document.getElementById('checkoutItems');
        list.replaceChildren();
        let total = 0;
        let totalQuantity = 0;
        cartItems.forEach((item) => {
          const unitPrice = getUnitPrice(item);
          total += unitPrice * item.quantity;
          totalQuantity += item.quantity;
          const row = document.createElement('li');
          row.className = 'flex items-start justify-between gap-3 py-4';
          const detail = document.createElement('div');
          detail.className = 'min-w-0';
          const name = document.createElement('p');
          name.className = 'font-bold text-slate-800 dark:text-white';
          name.textContent = `${item.name} × ${item.quantity}`;
          detail.append(name);
          if (item.addons.length) {
            const addons = document.createElement('p');
            addons.className = 'mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400';
            addons.textContent = `Add-on: ${item.addons.map((addon) => `${addon.name} (${formatRupiah(addon.price)})`).join(', ')}`;
            detail.append(addons);
          }
          const price = document.createElement('span');
          price.className = 'shrink-0 text-right text-sm font-bold text-slate-800 dark:text-slate-200';
          price.textContent = formatRupiah(unitPrice * item.quantity);
          row.append(detail, price);
          list.append(row);
        });
        document.getElementById('checkoutItemCount').textContent = `${totalQuantity} item`;
        document.getElementById('checkoutTotal').textContent = formatRupiah(total);
        updateSubmitState();
      }

      function updateSubmitState() {
        checkoutButton.disabled = !cartIsValid || !tenantIsOpen || !studentCheckoutReady || studentProfileRequiresCompletion;
      }

      function showGuestCheckoutPrompt() {
        document.getElementById('guestNimField').classList.remove('hidden');
        document.getElementById('guestNimField').classList.add('block');
        document.getElementById('guestPhoneField').classList.remove('hidden');
        document.getElementById('guestPhoneField').classList.add('block');
        studentCheckoutInfo.innerHTML = 'Login untuk checkout lebih cepat. <a href="/mahasiswa/login" class="font-extrabold underline">Login Mahasiswa</a>';
        studentCheckoutInfo.classList.remove('hidden');
      }

      async function initializeStudentCheckout() {
        try {
          const { data: { session }, error: sessionError } = await db.auth.getSession();
          if (sessionError) throw new Error(`Sesi login gagal diperiksa: ${sessionError.message}`);
          if (!session) return;
          studentSessionDetected = true;
          studentProfileRequiresCompletion = true;

          const { data: profile, error: profileError } = await db
            .from('profiles')
            .select('id, nama, nim, no_telepon, avatar_url, peran')
            .eq('id', session.user.id)
            .single();
          if (profileError) throw new Error(`Profil gagal dimuat untuk checkout: ${profileError.message}`);
          if (profile.peran !== 'mahasiswa') {
            studentSessionDetected = false;
            studentProfileRequiresCompletion = false;
            return;
          }

          studentCheckoutProfile = profile;
          document.getElementById('guestNim').value = profile.nim || '';
          document.getElementById('guestPhone').value = profile.no_telepon || '';
          document.getElementById('guestNimField').classList.add('hidden');
          document.getElementById('guestPhoneField').classList.add('hidden');
          studentCheckoutProfileCard.classList.remove('hidden');
          document.getElementById('checkoutStudentName').textContent = `Pesanan atas nama: ${profile.nama || 'Mahasiswa'} (NIM: ${profile.nim || 'belum tersedia'})`;
          document.getElementById('checkoutStudentPhone').textContent = profile.no_telepon || 'Nomor HP belum diisi';
          const avatar = document.getElementById('checkoutStudentAvatar');
          avatar.src = profile.avatar_url || document.body.dataset.logoUrl;
          avatar.onerror = () => { avatar.src = document.body.dataset.logoUrl; };
          studentProfileRequiresCompletion = !/^\d{6,20}$/.test(profile.nim || '')
            || !/^628\d{8,13}$/.test(profile.no_telepon || '');
          if (studentProfileRequiresCompletion) {
            studentCheckoutInfo.innerHTML = 'Silakan isi NIM dan No HP di <a href="/profile" class="font-extrabold underline">Profil</a> dulu.';
            studentCheckoutInfo.classList.remove('hidden');
          }
        } catch (error) {
          console.error('Gagal memuat profil checkout:', error);
          if (studentSessionDetected) {
            studentCheckoutInfo.textContent = `Profil checkout gagal dimuat: ${error.message || error}`;
            studentCheckoutInfo.classList.remove('hidden');
            document.getElementById('guestNimField').classList.add('hidden');
            document.getElementById('guestPhoneField').classList.add('hidden');
          } else {
            showGuestCheckoutPrompt();
          }
        } finally {
          if (!studentSessionDetected) showGuestCheckoutPrompt();
          studentCheckoutReady = true;
          updateSubmitState();
        }
      }

      function parseTenantOpenStatus(value) {
        if (value === true || value === 1) return true;
        if (value === false || value === 0) return false;
        if (typeof value === 'string') {
          const normalized = value.trim().toLowerCase();
          if (normalized === 'true' || normalized === '1') return true;
          if (normalized === 'false' || normalized === '0') return false;
        }
        return null;
      }

      function applyTenantOpenStatus(value) {
        const isOpen = parseTenantOpenStatus(value);
        if (isOpen === null) return;
        tenantIsOpen = isOpen;
        document.getElementById('tenantClosedMessage').classList.toggle('hidden', isOpen);
        updateSubmitState();
      }

      function subscribeToTenantStatus() {
        const tenantId = checkoutPage.dataset.tenantId;
        tenantStatusChannel = db
          .channel(`checkout-tenant-status-${tenantId}`)
          .on('postgres_changes', {
            event: 'UPDATE',
            schema: 'public',
            table: 'tenants',
            filter: `id=eq.${tenantId}`,
          }, ({ new: updatedTenant }) => {
            if (updatedTenant?.id !== tenantId || !Object.prototype.hasOwnProperty.call(updatedTenant, 'status_buka')) return;
            tenantStatusRevision += 1;
            applyTenantOpenStatus(updatedTenant.status_buka);
          })
          .subscribe((status, error) => {
            if (status !== 'SUBSCRIBED') {
              console.error('Realtime status tenant checkout:', status, error);
              return;
            }
            const revisionAtRequest = tenantStatusRevision;
            db.from('tenants')
              .select('status_buka')
              .eq('id', tenantId)
              .single()
              .then(({ data, error: snapshotError }) => {
                if (snapshotError) {
                  console.error('Gagal menyegarkan status tenant checkout:', snapshotError);
                  showPageMessage(`Status tenant gagal diperbarui: ${snapshotError.message}`, false);
                  return;
                }
                if (revisionAtRequest === tenantStatusRevision) applyTenantOpenStatus(data.status_buka);
              });
          });
      }

      async function getFunctionErrorMessage(error) {
        console.error('Supabase Edge Function request failed:', error);
        if (error?.context instanceof Response) {
          const body = await error.context.clone().json().catch(() => null);
          if (typeof body?.error === 'string') return body.error;
          if (typeof body?.message === 'string') return body.message;
        }
        return error?.message || 'Tidak dapat terhubung ke Supabase Edge Function.';
      }

      function getCreatedOrder(response) {
        const candidates = [
          response?.order,
          response?.data?.order,
          response?.result?.order,
          response?.data,
          response?.result,
        ];
        return candidates.find((candidate) =>
          candidate
          && typeof candidate === 'object'
          && typeof candidate.nomor_pesanan === 'string'
          && typeof candidate.token_pesanan === 'string'
        );
      }

      function showCheckoutMessage(text, isError = true) {
        checkoutMessage.textContent = text;
        checkoutMessage.className = `rounded-lg p-3 text-sm ${isError ? 'bg-rose-50 text-rose-700 dark:bg-rose-950 dark:text-rose-200' : 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200'}`;
      }

      const nimInput = document.getElementById('guestNim');
      const nimStatus = document.getElementById('nimValidationMessage');
      nimInput.addEventListener('blur', async () => {
        const nim = nimInput.value.trim();
        if (!/^\d{6,20}$/.test(nim) || validatingNim || studentCheckoutProfile) return;
        validatingNim = true;
        nimStatus.textContent = 'Memeriksa NIM...';
        try {
          const { data, error } = await db.functions.invoke('validate-nim', {
            body: { nim },
            timeout: 10000,
          });
          if (error) throw new Error(await getFunctionErrorMessage(error));
          if (data?.error || data?.success === false) throw new Error(data.error || data.message || 'Validasi NIM gagal.');
          nimStatus.textContent = data?.valid === true ? 'NIM terverifikasi.' : 'NIM tidak terdaftar sebagai mahasiswa.';
          nimStatus.className = `mt-1 block text-xs font-normal ${data?.valid === true ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300'}`;
        } catch (error) {
          nimStatus.textContent = `Validasi NIM gagal: ${error.message}`;
          nimStatus.className = 'mt-1 block text-xs font-normal text-rose-700 dark:text-rose-300';
        } finally {
          validatingNim = false;
        }
      });

      checkoutForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!tenantIsOpen) {
          showCheckoutMessage('Tenant sedang tutup dan belum dapat menerima pesanan.');
          return;
        }
        if (!cartIsValid || !cartItems.length) {
          showCheckoutMessage('Keranjang checkout tidak valid. Kembali ke menu dan pilih pesanan kembali.');
          return;
        }
        if (!studentCheckoutReady) {
          showCheckoutMessage('Sedang memeriksa profil checkout. Silakan coba kembali sebentar lagi.');
          return;
        }
        if (studentProfileRequiresCompletion) {
          showCheckoutMessage('Silakan isi NIM dan No HP di Profil dulu sebelum membuat pesanan.');
          return;
        }

        const nim = studentCheckoutProfile ? studentCheckoutProfile.nim.trim() : nimInput.value.trim();
        const phone = (studentCheckoutProfile
          ? studentCheckoutProfile.no_telepon
          : document.getElementById('guestPhone').value).replace(/[\s()+-]/g, '');
        const proofFile = proofInput.files?.[0];
        if (!/^\d{6,20}$/.test(nim)) {
          showCheckoutMessage('NIM harus terdiri dari 6 sampai 20 digit.');
          if (!studentCheckoutProfile) nimInput.focus();
          return;
        }
        if (!/^628\d{8,13}$/.test(phone)) {
          showCheckoutMessage('Nomor HP harus memakai format 628 yang valid.');
          if (!studentCheckoutProfile) document.getElementById('guestPhone').focus();
          return;
        }
        const validProof = proofFile
          && /\.(jpe?g|png)$/i.test(proofFile.name)
          && ['image/jpeg', 'image/png'].includes(proofFile.type);
        if (!validProof) {
          showCheckoutMessage('Silakan pilih bukti transfer berupa file JPG atau PNG.');
          proofInput.focus();
          return;
        }
        if (proofFile.size > 5 * 1024 * 1024) {
          showCheckoutMessage('Ukuran bukti transfer maksimal 5 MB.');
          proofInput.focus();
          return;
        }

        checkoutButton.disabled = true;
        checkoutButton.textContent = 'Mengunggah bukti dan membuat pesanan...';
        try {
          nimStatus.textContent = 'Memeriksa NIM...';
          const { data: validation, error: validationError } = await db.functions.invoke('validate-nim', {
            body: { nim },
            timeout: 10000,
          });
          if (validationError) throw new Error(await getFunctionErrorMessage(validationError));
          if (validation?.error) throw new Error(validation.error);
          if (validation?.valid !== true) {
            nimStatus.textContent = validation?.message || 'NIM tidak terdaftar sebagai mahasiswa.';
            nimStatus.className = 'mt-1 block text-xs font-normal text-rose-700 dark:text-rose-300';
            throw new Error('NIM tidak valid.');
          }
          nimStatus.textContent = 'NIM terverifikasi.';
          nimStatus.className = 'mt-1 block text-xs font-normal text-emerald-700 dark:text-emerald-300';

          const orderForm = new FormData();
          orderForm.set('tenant_slug', tenantSlug);
          orderForm.set('tenant_id', checkoutPage.dataset.tenantId);
          orderForm.set('nim', nim);
          orderForm.set('phone', phone);
          orderForm.set('items', JSON.stringify(cartItems.map(({ id, quantity, addons }) => ({
            menu_item_id: id,
            qty: quantity,
            addon_ids: addons.map((addon) => addon.id),
          }))));
          orderForm.set('proof', proofFile);
          const { data, error } = await db.functions.invoke('create-guest-order', {
            body: orderForm,
            timeout: 30000,
          });
          if (error) throw new Error(await getFunctionErrorMessage(error));
          if (data?.error || data?.success === false) {
            throw new Error(data.error || data.message || 'Pembuatan pesanan gagal.');
          }
          const order = getCreatedOrder(data);
          if (!order) {
            console.error('Respons create-guest-order tidak sesuai kontrak:', data);
            throw new Error('Respons create-guest-order tidak berisi nomor dan token pesanan. Pastikan Edge Function sudah di-deploy ulang.');
          }

          document.getElementById('confirmationNumber').textContent = order.nomor_pesanan;
          const validQueueNumber = typeof order.nomor_antrean === 'string' && /^A-\d{2,}$/.test(order.nomor_antrean);
          document.getElementById('confirmationQueueNumber').textContent = validQueueNumber ? order.nomor_antrean : 'Belum tersedia';
          if (!validQueueNumber) console.error('Pesanan berhasil dibuat tanpa nomor antrean yang valid:', order);
          document.getElementById('confirmationToken').textContent = order.token_pesanan;
          document.getElementById('trackOrderLink').href = `/cek-pesanan?token=${encodeURIComponent(order.token_pesanan)}`;
          document.getElementById('whatsappNotice').textContent = !validQueueNumber
            ? 'Pesanan tersimpan. Nomor antrean belum tersedia; gunakan token di halaman cek pesanan.'
            : data.whatsapp === 'sent'
              ? 'Token pesanan juga dikirim ke WhatsApp Anda.'
              : data.whatsapp === 'not_configured'
                ? 'Simpan token ini untuk mengecek status pesanan; notifikasi WhatsApp belum dikonfigurasi.'
                : 'Pesanan tersimpan, tetapi notifikasi WhatsApp gagal dikirim. Simpan token untuk mengecek status.';
          document.getElementById('orderConfirmation').classList.remove('hidden');
          checkoutForm.classList.add('hidden');
          const orderStatusUrl = `/cek-pesanan?token=${encodeURIComponent(order.token_pesanan)}`;
          window.location.assign(orderStatusUrl);
          try {
            sessionStorage.removeItem(storageKey);
          } catch (error) {
            console.error('Keranjang checkout tidak dapat dibersihkan:', error);
          }
          showPageMessage('', false);
          document.getElementById('orderConfirmation').scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) {
          console.error('Checkout guest gagal:', error);
          showCheckoutMessage(`Pesanan gagal dibuat: ${error.message || error}`);
        } finally {
          checkoutButton.textContent = 'Buat Pesanan';
          updateSubmitState();
        }
      });

      loadCart();
      initializeStudentCheckout();
      subscribeToTenantStatus();
      window.addEventListener('pagehide', () => {
        if (tenantStatusChannel) db.removeChannel(tenantStatusChannel);
      }, { once: true });
    </script>
  )}
</Layout>
