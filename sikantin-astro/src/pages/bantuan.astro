---
import Layout from '../layouts/Layout.astro';
import HelpContent from '../components/HelpContent.astro';
---

<Layout
	title="Pusat Bantuan | SiKantin"
	description="Panduan pemesanan, pembayaran, pelacakan pesanan, dan akun mahasiswa SiKantin."
	themeColor="#172b40"
	bodyClass="min-h-screen bg-slate-50 text-slate-800"
>
	<header class="site-header border-b border-slate-200 bg-white">
		<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
			<a href="/" class="text-sm font-bold text-blue-700 hover:underline">← Kembali ke beranda</a>
			<div class="flex items-center gap-3">
				<a href="/mahasiswa/login" class="rounded-full bg-blue-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-800">Login Mahasiswa</a>
				<span data-theme-toggle-slot class="contents"></span>
			</div>
		</div>
	</header>
	<main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
		<HelpContent />
	</main>
</Layout>
