---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-uym.png';
import '../styles/tenant-dashboard.css';
---

<Layout title="Pesanan Masuk | SiKantin" themeColor="#ffffff" bodyClass="tenant-dashboard min-h-screen" noIndex>

<div class="min-h-screen">
    <header class="site-header tenant-dashboard-header">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
            <div class="flex min-w-0 items-center gap-3">
                <img src={logo.src} alt="Logo Universitas Yatsi Madani" class="h-10 w-10 rounded-full border border-slate-200 bg-white object-cover dark:border-slate-700">
                <div>
                    <p class="font-extrabold text-slate-900">SiKantin <span class="font-medium text-slate-400">/ Tenant</span></p>
                    <p id="tenantName" class="text-xs text-slate-500"><span class="skeleton-line inline-block w-24 align-middle" role="status" aria-label="Memuat kantin"></span></p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span data-theme-toggle-slot class="contents"></span>
                <button id="logoutButton" type="button" class="tenant-logout-button">Keluar</button>
            </div>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
        <section class="mb-7 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="text-sm font-semibold text-blue-700">Ringkasan tenant</p>
                <h1 class="mt-1 text-3xl font-black text-slate-900">Halo, pemilik tenant 👋</h1>
                <p class="mt-2 text-sm text-slate-500">Pantau operasional kantin dan pesanan masuk hari ini.</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex flex-col items-end gap-1">
                    <span id="connectionStatus" class="sr-only" aria-live="polite">Menghubungkan realtime pesanan...</span>
                    <span id="tenantStatusRealtime" class="sr-only" aria-live="polite">Menghubungkan realtime status kantin...</span>
                    <span id="tenantScheduleInfo" class="text-right text-xs text-slate-500"><span class="skeleton-line inline-block w-36 align-middle" role="status" aria-label="Memuat jadwal operasional"></span></span>
                </div>
                <button id="enableNotificationSound" type="button" class="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-xs font-bold text-blue-800 transition hover:bg-blue-100">
                    Aktifkan suara
                </button>
                <button id="tenantOpenStatus" type="button" disabled class="tenant-status-button disabled:cursor-wait disabled:opacity-60">
                    <span class="status-dot"></span><span id="tenantOpenStatusLabel"><span class="skeleton-line inline-block w-20 align-middle" role="status" aria-label="Memuat status"></span></span>
                </button>
            </div>
        </section>
        <p id="message" role="status" aria-live="polite" class="mb-5 hidden rounded-lg p-4 text-sm"></p>
        <p id="soundStatus" class="sr-only" aria-live="polite"></p>

        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
            <div>
                <h2 class="text-lg font-extrabold text-slate-900">Ringkasan penjualan</h2>
                <p id="tenantStatsPeriodDescription" class="mt-1 text-sm text-slate-500">Angka berdasarkan pesanan hari ini.</p>
            </div>
            <label for="tenantStatsPeriod" class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                Periode
                <select id="tenantStatsPeriod" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-800 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200">
                    <option value="today" selected>Hari Ini</option>
                    <option value="last7">7 Hari Terakhir</option>
                    <option value="month">Bulan Ini</option>
                </select>
            </label>
        </div>
        <section class="mb-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Ringkasan penjualan">
            <article class="tenant-stat-card ui-enter">
                <span class="tenant-stat-icon bg-blue-50 text-blue-700" aria-hidden="true">◉</span>
                <p class="mt-4 text-sm text-slate-500">Pendapatan</p>
                <p id="tenantSalesTotal" class="mt-1 text-2xl font-black text-slate-900">Rp 0</p>
                <p class="mt-2 text-xs text-slate-500">Tidak termasuk pesanan dibatalkan</p>
            </article>
            <article class="tenant-stat-card ui-enter">
                <span class="tenant-stat-icon bg-amber-50 text-amber-700" aria-hidden="true">▤</span>
                <p class="mt-4 text-sm text-slate-500">Pesanan</p>
                <p id="tenantOrderCount" class="mt-1 text-2xl font-black text-slate-900">0</p>
                <p class="mt-2 text-xs text-slate-500">Total pesanan tenant</p>
            </article>
            <article class="tenant-stat-card ui-enter">
                <span class="tenant-stat-icon bg-orange-50 text-orange-700" aria-hidden="true">◷</span>
                <p class="mt-4 text-sm text-slate-500">Perlu diproses</p>
                <p id="tenantPendingCount" class="mt-1 text-2xl font-black text-slate-900">0</p>
                <p class="mt-2 text-xs text-slate-500">Pesanan menunggu tindakan</p>
            </article>
            <article class="tenant-stat-card ui-enter">
                <span class="tenant-stat-icon bg-emerald-50 text-emerald-700" aria-hidden="true">✓</span>
                <p class="mt-4 text-sm text-slate-500">Siap diambil</p>
                <p id="tenantReadyCount" class="mt-1 text-2xl font-black text-slate-900">0</p>
                <p class="mt-2 text-xs text-slate-500">Menunggu mahasiswa mengambil</p>
            </article>
        </section>

        <button id="tenantDashboardMenuButton" type="button" aria-controls="tenantDashboardTabs" aria-expanded="false" class="tenant-dashboard-menu-button mb-3 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm lg:hidden">
            <span aria-hidden="true">☰</span> Navigasi dashboard
        </button>
        <nav id="tenantDashboardTabs" class="tenant-dashboard-tabs mb-5" aria-label="Menu dashboard">
            <button type="button" class="tenant-tab is-active" data-tenant-panel="orders">
                <span aria-hidden="true">☷</span> Pesanan
                <span id="tenantOrdersBadge" class="tenant-orders-badge hidden" aria-label="Pesanan belum diproses">0</span>
            </button>
            <button type="button" class="tenant-tab" data-tenant-panel="menu"><span aria-hidden="true">♨</span> Menu saya</button>
            <button type="button" class="tenant-tab" data-tenant-panel="history"><span aria-hidden="true">◷</span> Riwayat Pesanan</button>
        </nav>

        <section id="tenantOrdersPanel" class="tenant-panel">
            <div class="tenant-panel-heading">
                <div><h2 class="text-lg font-extrabold text-slate-900">Pesanan terbaru</h2></div>
            </div>
            <div id="ordersList" class="divide-y divide-slate-100" role="status" aria-label="Memuat pesanan">
                <div class="skeleton-card m-4"><span class="skeleton-line w-1/3"></span><span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span></div>
                <div class="skeleton-card m-4"><span class="skeleton-line w-1/3"></span><span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span></div>
            </div>
        </section>

        <section id="tenantMenuPanel" class="tenant-panel hidden">
            <div class="tenant-panel-heading">
                <div><h2 class="text-lg font-extrabold text-slate-900">Menu kantin</h2><p class="mt-1 text-sm text-slate-500">Daftar menu dari database.</p></div>
                <div class="flex items-center gap-3">
                    <a id="tenantCatalogLink" href="/" class="arrow-action arrow-after text-sm font-bold text-blue-700 underline" hidden>Lihat katalog</a>
                    <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Database</span>
                </div>
            </div>
            <div id="tenantMenuList" class="grid gap-3 p-5 sm:grid-cols-2" role="status" aria-label="Memuat menu">
                <div class="skeleton-card"><span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span></div>
                <div class="skeleton-card"><span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span></div>
            </div>
        </section>
        <section id="tenantHistoryPanel" class="tenant-panel hidden">
            <div class="tenant-panel-heading">
                <div><h2 class="text-lg font-extrabold text-slate-900">Riwayat Pesanan</h2><p class="mt-1 text-sm text-slate-500">Pesanan selesai, termasuk menu, rating, dan saran dari pelanggan.</p></div>
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Database</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[64rem] text-left text-sm">
                    <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wide text-slate-500">
                        <tr>
                            <th class="px-5 py-3">Antrean / Pesanan</th>
                            <th class="px-5 py-3">Tanggal Selesai</th>
                            <th class="px-5 py-3">Nama Mahasiswa</th>
                            <th class="px-5 py-3">Menu &amp; Add-on</th>
                            <th class="px-5 py-3">Total</th>
                            <th class="px-5 py-3">Rating &amp; Saran</th>
                        </tr>
                    </thead>
                    <tbody id="tenantHistoryBody" class="divide-y divide-slate-100">
                        <tr><td colspan="6" role="status" aria-label="Memuat riwayat pesanan"><span class="skeleton-line m-4 block w-2/3"></span></td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    </div>
    <script>
	import { db } from '../scripts/supabase.js';
        const ordersList = document.getElementById('ordersList');
        const message = document.getElementById('message');
        const connectionStatus = document.getElementById('connectionStatus');
        const notificationSound = new Audio('https://zafuozcduvijohjnbycw.supabase.co/storage/v1/object/public/sounds/notif.mp3');
        notificationSound.preload = 'auto';
        let notificationSoundEnabled = false;
        let activeTenantId;
        let tenantIsOpen = false;
        let tenantOrders = [];
        let tenantStatusChannel;
        let refreshTimer;
        let historyRefreshTimer;
        let channel;
        let reviewChannel;
        let notificationSoundUnlocking = false;
        let notificationSoundUnlockRequested = false;

        window.playNotificationSound = function () {
            if (!notificationSoundEnabled) return;
            notificationSound.volume = 1;
            notificationSound.currentTime = 0;
            notificationSound.play().catch((error) => {
                console.error('Notification sound could not be played.', error);
                notificationSoundEnabled = false;
            });
        };

        async function unlockNotificationSound(event) {
            if (notificationSoundEnabled) return;
            if (notificationSoundUnlocking) {
                if (event instanceof Event) notificationSoundUnlockRequested = true;
                return;
            }
            notificationSoundUnlocking = true;
            notificationSound.volume = 0;
            notificationSound.muted = false;
            try {
                await notificationSound.play();
                notificationSound.pause();
                notificationSound.currentTime = 0;
                notificationSound.volume = 1;
                notificationSoundEnabled = true;
                document.getElementById('enableNotificationSound').hidden = true;
                document.getElementById('soundStatus').textContent = 'Suara notifikasi aktif.';
                document.removeEventListener('pointerdown', unlockNotificationSound);
                document.removeEventListener('keydown', unlockNotificationSound);
            } catch (error) {
                notificationSound.volume = 1;
                console.warn('Aktivasi audio notifikasi diblokir browser:', error);
            } finally {
                notificationSoundUnlocking = false;
                if (notificationSoundUnlockRequested) {
                    notificationSoundUnlockRequested = false;
                    unlockNotificationSound();
                }
            }
        }

        document.getElementById('enableNotificationSound').addEventListener('click', unlockNotificationSound);
        document.addEventListener('pointerdown', unlockNotificationSound);
        document.addEventListener('keydown', unlockNotificationSound);
        unlockNotificationSound();

        function showMessage(text, isError) {
            message.textContent = text;
            message.className = `mb-5 rounded-lg p-4 text-sm ${isError ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`;
        }

        function formatRupiah(value) {
            return new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                maximumFractionDigits: 0
            }).format(value);
        }

        function getJakartaDateKey(value) {
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return null;
            const parts = new Intl.DateTimeFormat('en-CA', {
                timeZone: 'Asia/Jakarta',
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
            }).formatToParts(date);
            const part = (type) => parts.find((item) => item.type === type)?.value;
            return `${part('year')}-${part('month')}-${part('day')}`;
        }

        function getStatsDateRange(period) {
            const today = getJakartaDateKey(new Date());
            if (!today) return null;
            const todayUtc = new Date(`${today}T00:00:00Z`);
            let start = today;
            if (period === 'last7') {
                todayUtc.setUTCDate(todayUtc.getUTCDate() - 6);
                start = todayUtc.toISOString().slice(0, 10);
            } else if (period === 'month') {
                start = `${today.slice(0, 7)}-01`;
            }
            return { start, end: today };
        }

        function renderTenantStats() {
            const period = document.getElementById('tenantStatsPeriod').value;
            const range = getStatsDateRange(period);
            if (!range) return;
            const filteredOrders = tenantOrders.filter((order) => {
                const orderDate = getJakartaDateKey(order.created_at);
                return orderDate && orderDate >= range.start && orderDate <= range.end;
            });
            const pendingOrders = filteredOrders.filter((order) =>
                order.status === 'Menunggu' || order.status === 'Menunggu Verifikasi'
            );
            const readyOrders = filteredOrders.filter((order) => order.status === 'Siap diambil');
            document.getElementById('tenantOrderCount').textContent = String(filteredOrders.length);
            document.getElementById('tenantPendingCount').textContent = String(pendingOrders.length);
            document.getElementById('tenantReadyCount').textContent = String(readyOrders.length);
            document.getElementById('tenantSalesTotal').textContent = formatRupiah(
                filteredOrders
                    .filter((order) => order.status !== 'Dibatalkan')
                    .reduce((total, order) => total + Number(order.total || 0), 0)
            );
            const label = period === 'last7'
                ? '7 hari terakhir'
                : period === 'month'
                    ? 'bulan ini'
                    : 'hari ini';
            document.getElementById('tenantStatsPeriodDescription').textContent =
                `Angka berdasarkan pesanan ${label} (waktu WIB).`;

            const allPendingOrders = tenantOrders.filter((order) =>
                order.status === 'Menunggu' || order.status === 'Menunggu Verifikasi'
            );
            const badge = document.getElementById('tenantOrdersBadge');
            badge.textContent = String(allPendingOrders.length);
            badge.classList.toggle('hidden', allPendingOrders.length === 0);
        }

        function addText(parent, tag, className, text) {
            const element = document.createElement(tag);
            element.className = className;
            element.textContent = text ?? '';
            parent.append(element);
            return element;
        }

        function normalizeOrderAddons(value) {
            let addons = value;
            if (typeof addons === 'string') {
                try {
                    addons = JSON.parse(addons);
                } catch (error) {
                    console.error('Format add-on pesanan tidak valid:', error);
                    return [];
                }
            }
            if (!Array.isArray(addons)) return [];

            return addons.flatMap((addon) => {
                if (!addon || typeof addon !== 'object' || Array.isArray(addon)) return [];
                const name = typeof addon.name === 'string' ? addon.name.trim() : '';
                if (!name) return [];
                const price = addon.price === null || addon.price === undefined || addon.price === ''
                    ? null
                    : Number(addon.price);
                return [{ name, price: price !== null && Number.isFinite(price) ? price : null }];
            });
        }

        function isTenantOpen(status) {
            return status === true
                || status === 1
                || (typeof status === 'string' && ['true', '1'].includes(status.trim().toLowerCase()));
        }

        function formatScheduleTime(value) {
            return value ? value.slice(0, 5) : null;
        }

        function updateTenantScheduleInfo(tenant) {
            const scheduleInfo = document.getElementById('tenantScheduleInfo');
            const openTime = formatScheduleTime(tenant.jam_buka);
            const closeTime = formatScheduleTime(tenant.jam_tutup);
            if (openTime && closeTime) {
                const overrideUntil = tenant.override_until
                    ? new Intl.DateTimeFormat('id-ID', {
                        timeZone: 'Asia/Jakarta',
                        hour: '2-digit',
                        minute: '2-digit',
                        hourCycle: 'h23'
                    }).format(new Date(tenant.override_until))
                    : null;
                scheduleInfo.textContent = `Jadwal otomatis ${openTime}–${closeTime} WIB${overrideUntil ? ` · Override sampai ${overrideUntil} WIB` : ''}`;
            } else {
                scheduleInfo.textContent = 'Jadwal otomatis belum diatur admin.';
            }
        }

        function setTenantOpenStatus(isOpen, tenant = {}) {
            tenantIsOpen = isTenantOpen(isOpen);
            const button = document.getElementById('tenantOpenStatus');
            button.classList.toggle('is-closed', !tenantIsOpen);
            document.getElementById('tenantOpenStatusLabel').textContent = tenantIsOpen ? 'Tutup Manual' : 'Buka Manual';
            button.setAttribute('aria-label', `${tenantIsOpen ? 'Tutup' : 'Buka'} kantin secara manual.`);
            updateTenantScheduleInfo(tenant);
        }

        function setTenantDashboardUnavailable(statusLabel, connectionLabel, messageText, isError = true) {
            document.getElementById('tenantOpenStatusLabel').textContent = statusLabel;
            document.getElementById('tenantOpenStatus').disabled = true;
            connectionStatus.textContent = connectionLabel;
            document.getElementById('tenantStatusRealtime').textContent = 'Realtime status kantin tidak aktif.';
            if (messageText) showMessage(messageText, isError);
        }

        function subscribeToTenantStatus(ownerId) {
            if (typeof ownerId !== 'string' || !ownerId.trim()) {
                document.getElementById('tenantStatusRealtime').textContent = 'Tenant belum dimuat.';
                return;
            }

            tenantStatusChannel = db
                .channel(`tenant-status-${ownerId}`)
                .on('postgres_changes', {
                    event: 'UPDATE',
                    schema: 'public',
                    table: 'tenants',
                    filter: `pemilik_id=eq.${ownerId}`
                }, (payload) => {
                    if (payload.new?.pemilik_id !== ownerId
                        || !Object.prototype.hasOwnProperty.call(payload.new, 'status_buka')) return;
                    setTenantOpenStatus(payload.new.status_buka, payload.new);
                })
                .subscribe((status, error) => {
                    document.getElementById('tenantStatusRealtime').textContent = status === 'SUBSCRIBED'
                        ? 'Realtime status kantin aktif.'
                        : error
                            ? `Realtime status ${status}: ${error.message}`
                            : `Realtime status kantin: ${status}`;
                    if (status !== 'SUBSCRIBED') {
                        console.error('Realtime status tenant:', status, error);
                    }
                });
        }

        async function toggleTenantOpenStatus() {
            if (typeof activeTenantId !== 'string' || !activeTenantId.trim()) {
                showMessage('Status tenant belum dapat diperbarui karena data tenant belum dimuat.', true);
                return;
            }
            const nextStatus = !tenantIsOpen;
            const button = document.getElementById('tenantOpenStatus');
            button.disabled = true;
            const { error } = await db.rpc('set_tenant_manual_status', {
                p_tenant_id: activeTenantId,
                p_status_buka: nextStatus
            });
            button.disabled = false;
            if (error) {
                showMessage(`Status tenant gagal diperbarui: ${error.message}`, true);
                return;
            }
            const { data: tenant, error: tenantError } = await db
                .from('tenants')
                .select('jam_buka, jam_tutup, override_until')
                .eq('id', activeTenantId)
                .single();
            if (tenantError) {
                showMessage(`Status berubah, tetapi jadwal override gagal dimuat: ${tenantError.message}`, true);
                return;
            }
            setTenantOpenStatus(nextStatus, { ...tenant, status_buka: nextStatus });
            const overrideUntil = tenant.override_until
                ? new Intl.DateTimeFormat('id-ID', {
                    timeZone: 'Asia/Jakarta',
                    hour: '2-digit',
                    minute: '2-digit',
                    hourCycle: 'h23'
                }).format(new Date(tenant.override_until))
                : null;
            showMessage(
                `Tenant sekarang ${nextStatus ? 'buka' : 'tutup'} secara manual${overrideUntil ? ` sampai ${overrideUntil} WIB` : ' hingga jadwal otomatis dikonfigurasi'}.`,
                false
            );
        }

        function showTenantPanel(panel) {
            document.getElementById('tenantOrdersPanel').classList.toggle('hidden', panel !== 'orders');
            document.getElementById('tenantMenuPanel').classList.toggle('hidden', panel !== 'menu');
            document.getElementById('tenantHistoryPanel').classList.toggle('hidden', panel !== 'history');
            document.querySelectorAll('[data-tenant-panel]').forEach((tab) => {
                tab.classList.toggle('is-active', tab.dataset.tenantPanel === panel);
            });
            document.getElementById('tenantDashboardTabs').classList.remove('is-open');
            document.getElementById('tenantDashboardMenuButton').setAttribute('aria-expanded', 'false');
        }

        function formatOrderDate(value) {
            const date = new Date(value);
            return Number.isNaN(date.getTime())
                ? '-'
                : new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short' }).format(date);
        }

        function renderTenantMenu(menuItems) {
            const menuList = document.getElementById('tenantMenuList');
            menuList.replaceChildren();
            if (!menuItems.length) {
                addText(menuList, 'p', 'text-sm text-slate-500', 'Belum ada menu yang terdaftar.');
                return;
            }
            menuItems.forEach((item) => {
                const row = document.createElement('article');
                row.className = 'tenant-menu-item ui-enter bg-white';
                if (item.foto_url) {
                    const image = document.createElement('img');
                    image.src = item.foto_url;
                    image.alt = item.nama_menu;
                    image.loading = 'lazy';
                    row.append(image);
                } else {
                    addText(row, 'span', 'flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-2xl', '🍱');
                }
                const details = document.createElement('div');
                details.className = 'min-w-0 flex-1';
                addText(details, 'p', 'truncate text-sm font-bold text-slate-800', item.nama_menu);
                addText(details, 'p', 'mt-1 text-xs text-slate-500', item.kategori || 'Menu kantin');
                addText(details, 'p', 'mt-1 text-xs font-semibold text-slate-700', formatRupiah(item.harga));
                row.append(details);
                addText(
                    row,
                    'span',
                    `shrink-0 rounded-full px-2 py-1 text-[10px] font-bold ${item.tersedia ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500'}`,
                    item.tersedia ? 'Tersedia' : 'Habis'
                );
                menuList.append(row);
            });
        }

        async function updateOrder(order, status, rejectionReason, actionButton) {
            if (typeof activeTenantId !== 'string' || !activeTenantId.trim() || typeof order?.id !== 'string' || !order.id.trim()) {
                showMessage('Pesanan tidak dapat diperbarui karena data tenant belum dimuat.', true);
                return;
            }
            const changes = { status };
            if (status === 'Dibatalkan') changes.alasan_pembatalan = rejectionReason;
            if (actionButton) actionButton.disabled = true;
            let updatedOrder;
            let error;
            try {
                ({ data: updatedOrder, error } = await db
                    .from('orders')
                    .update(changes)
                    .eq('id', order.id)
                    .select('id')
                    .maybeSingle());
            } catch (requestError) {
                console.error(`Permintaan update status pesanan ${order.id} gagal:`, requestError);
                if (actionButton) actionButton.disabled = false;
                const errorMessage = requestError instanceof Error ? requestError.message : String(requestError);
                showMessage(`Status pesanan gagal diperbarui: ${errorMessage}`, true);
                return;
            }
            if (error) {
                console.error(`Update status pesanan ${order.id} gagal:`, error);
                if (actionButton) actionButton.disabled = false;
                showMessage(`Status pesanan gagal diperbarui: ${error.message}`, true);
                return;
            }
            if (!updatedOrder) {
                console.error(`Pesanan ${order.id} tidak ditemukan atau akses update ditolak oleh kebijakan database.`);
                if (actionButton) actionButton.disabled = false;
                showMessage('Pesanan sudah diperbarui atau akses perubahan ditolak. Muat ulang daftar pesanan.', true);
                await loadOrders();
                return;
            }
            const localOrder = tenantOrders.find((item) => item.id === order.id);
            if (localOrder) {
                localOrder.status = status;
                if (status === 'Dibatalkan') localOrder.alasan_pembatalan = rejectionReason;
                renderOrders(tenantOrders);
            }
            if (status === 'Dibatalkan') {
                const { data: notification, error: notificationError } = await db.functions.invoke('notify-order-rejected', {
                    body: { order_id: order.id }
                });
                if (notificationError) {
                    console.error('WhatsApp penolakan pesanan gagal dikirim:', notificationError);
                    showMessage(
                        `Pesanan ${order.nomor_pesanan} ditolak, tetapi WhatsApp gagal dikirim: ${notificationError.message}`,
                        true
                    );
                } else if (notification?.success !== true) {
                    showMessage(`Pesanan ${order.nomor_pesanan} ditolak, tetapi WhatsApp gagal dikirim.`, true);
                } else {
                    showMessage(`Pesanan ${order.nomor_pesanan} ditolak dan WhatsApp berhasil dikirim.`, false);
                }
            } else {
                showMessage(`Status pesanan ${order.nomor_pesanan} diperbarui menjadi ${status}.`, false);
            }
            await Promise.all([loadOrders(), loadTenantMenu()]);
        }

        ordersList.addEventListener('click', (event) => {
            if (!(event.target instanceof Element)) return;
            const button = event.target.closest('button[data-order-action]');
            if (!button || !ordersList.contains(button)) return;

            const orderId = button.dataset.orderId;
            if (!orderId) {
                console.error('Tombol tindakan pesanan tidak memiliki ID pesanan.');
                showMessage('ID pesanan tidak ditemukan. Muat ulang daftar pesanan.', true);
                return;
            }
            const order = tenantOrders.find((item) => item.id === orderId);
            if (!order) {
                console.error(`Pesanan ${orderId} tidak ditemukan pada daftar yang sedang ditampilkan.`);
                showMessage('Data pesanan sudah berubah. Daftar pesanan sedang dimuat ulang.', true);
                loadOrders();
                return;
            }

            if (button.dataset.orderAction === 'toggle-rejection') {
                const form = button.parentElement?.querySelector('[data-order-rejection-form]');
                const reason = form?.querySelector('textarea');
                if (!form || !reason) {
                    console.error(`Form penolakan untuk pesanan ${orderId} tidak ditemukan.`);
                    showMessage('Form penolakan tidak tersedia. Muat ulang daftar pesanan.', true);
                    return;
                }
                form.classList.toggle('hidden');
                if (!form.classList.contains('hidden')) reason.focus();
                return;
            }

            const nextStatus = button.dataset.nextStatus;
            if (!nextStatus) {
                console.error(`Tombol tindakan pesanan ${orderId} tidak memiliki status tujuan.`);
                showMessage('Status tujuan pesanan tidak ditemukan. Muat ulang daftar pesanan.', true);
                return;
            }
            updateOrder(order, nextStatus, undefined, button);
        });

        ordersList.addEventListener('submit', async (event) => {
            if (!(event.target instanceof HTMLFormElement) || !event.target.matches('[data-order-rejection-form]')) return;
            event.preventDefault();
            const form = event.target;
            const orderId = form.dataset.orderId;
            const order = tenantOrders.find((item) => item.id === orderId);
            const reason = form.querySelector('textarea');
            const confirmButton = form.querySelector('button[type="submit"]');
            if (!orderId || !order || !reason || !confirmButton) {
                console.error('Data pesanan atau elemen form penolakan tidak lengkap.', { orderId });
                showMessage('Data pesanan tidak ditemukan untuk diproses. Muat ulang daftar pesanan.', true);
                return;
            }
            const rejectionReason = reason.value.trim();
            if (!rejectionReason) {
                reason.setCustomValidity('Alasan penolakan wajib diisi.');
                reason.reportValidity();
                return;
            }
            confirmButton.disabled = true;
            await updateOrder(order, 'Dibatalkan', rejectionReason, confirmButton);
            confirmButton.disabled = false;
        });

        function renderOrders(orders) {
            tenantOrders = orders;
            renderTenantStats();

            ordersList.replaceChildren();
            if (!orders.length) {
                addText(ordersList, 'p', 'p-6 text-sm text-slate-500', 'Belum ada pesanan masuk.');
                return;
            }

            orders.forEach((order) => {
                if (typeof order.id !== 'string' || !order.id.trim()) {
                    console.error('Pesanan diabaikan saat dirender karena ID tidak valid:', order);
                    return;
                }
                const row = document.createElement('article');
                row.className = 'tenant-order-row ui-enter';
                row.dataset.orderId = order.id;
                const identity = document.createElement('div');
                identity.className = 'min-w-[12rem] flex-1';
                addText(
                    identity,
                    'p',
                    'mb-2 inline-flex items-center rounded-lg border border-amber-200 bg-amber-100 px-3 py-1.5 text-base font-black tracking-wide text-amber-900',
                    `ANTREAN ${order.nomor_antrean || 'Belum tersedia'}`
                );
                addText(identity, 'h3', 'text-sm font-extrabold text-slate-900', `Pesanan ${order.nomor_pesanan}`);
                const customer = document.createElement('p');
                customer.className = 'mt-1 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-700';
                if (order.mahasiswa_id == null) {
                    addText(customer, 'span', 'rounded-full bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-600', 'Guest');
                } else {
                    addText(customer, 'span', 'rounded-full bg-blue-50 px-2 py-1 text-[10px] font-bold text-blue-700', 'Mahasiswa');
                    addText(customer, 'span', '', order.nama_mahasiswa || 'Mahasiswa');
                }
                identity.append(customer);
                if (order.phone) {
                    addText(identity, 'p', 'mt-1 text-xs text-slate-500', order.phone);
                }
                const itemDetails = document.createElement('div');
                itemDetails.className = 'mt-2 space-y-2 text-xs text-slate-600';
                if (order.order_items?.length) {
                    order.order_items.forEach((item) => {
                        const itemDetail = document.createElement('div');
                        addText(
                            itemDetail,
                            'p',
                            'font-semibold text-slate-700',
                            `${item.nama_menu} × ${item.jumlah}${item.catatan ? ` (${item.catatan})` : ''}`
                        );
                        const addons = normalizeOrderAddons(item.add_ons);
                        if (addons.length) {
                            const addonList = document.createElement('ul');
                            addonList.className = 'ml-4 mt-1 space-y-0.5 pl-2 text-slate-600';
                            addons.forEach((addon) => {
                                const addonPrice = addon.price === null
                                    ? null
                                    : addon.price === 0
                                        ? 'Gratis'
                                        : `+ ${formatRupiah(addon.price)}`;
                                addText(
                                    addonList,
                                    'li',
                                    '',
                                    `- ${addon.name}${addonPrice ? ` (${addonPrice})` : ''}`
                                );
                            });
                            itemDetail.append(addonList);
                        }
                        itemDetails.append(itemDetail);
                    });
                } else {
                    addText(itemDetails, 'p', '', 'Rincian menu tidak tersedia.');
                }
                identity.append(itemDetails);
                addText(identity, 'p', 'mt-2 text-xs font-semibold text-slate-600', `Pembayaran: ${order.metode_pembayaran === 'tunai' ? 'Tunai (dibayar saat pengambilan)' : 'QRIS'}`);
                if (order.status === 'Dibatalkan' && order.alasan_pembatalan) {
                    addText(identity, 'p', 'mt-2 rounded-md bg-rose-50 p-2 text-xs text-rose-700', `Alasan penolakan: ${order.alasan_pembatalan}`);
                }
                if (order.status === 'Menunggu Verifikasi') {
                    addText(identity, 'p', 'mt-3 text-xs text-slate-500', 'Periksa nominal dan detail bukti transfer sebelum memverifikasi pembayaran.');
                    if (order.bukti_transfer) {
                        const proofLink = document.createElement('a');
                        proofLink.href = order.bukti_transfer;
                        proofLink.target = '_blank';
                        proofLink.rel = 'noopener noreferrer';
                        proofLink.className = 'mt-3 inline-block';
                        const proofImage = document.createElement('img');
                        proofImage.src = order.bukti_transfer;
                        proofImage.alt = `Bukti transfer pesanan ${order.nomor_pesanan}`;
                        proofImage.loading = 'lazy';
                        proofImage.className = 'max-h-48 max-w-full rounded-lg border border-slate-200 object-contain';
                        proofLink.append(proofImage);
                        identity.append(proofLink);
                    } else {
                        addText(identity, 'p', 'mt-3 text-xs font-semibold text-rose-600', 'Bukti transfer belum tersedia.');
                    }
                }
                row.append(identity);
                const statusColor = order.status === 'Siap diambil'
                    ? 'bg-emerald-50 text-emerald-700'
                    : order.status === 'Selesai'
                        ? 'bg-slate-100 text-slate-600'
                        : order.status === 'Dibatalkan'
                            ? 'bg-rose-50 text-rose-700'
                            : 'bg-amber-50 text-amber-800';
                const status = addText(row, 'span', `rounded-full px-3 py-1 text-xs font-bold ${statusColor}`, order.status);
                status.setAttribute('aria-label', `Status: ${order.status}`);
                addText(row, 'p', 'min-w-24 text-sm font-extrabold text-slate-900', formatRupiah(order.total));
                const actions = document.createElement('div');
                actions.className = 'flex flex-wrap items-center gap-2';
                if (order.status === 'Menunggu Verifikasi') {
                    const verifyButton = document.createElement('button');
                    verifyButton.type = 'button';
                    verifyButton.className = 'tenant-order-action';
                    verifyButton.textContent = 'Verifikasi Pembayaran';
                    verifyButton.dataset.orderAction = 'update-status';
                    verifyButton.dataset.orderId = order.id;
                    verifyButton.dataset.nextStatus = 'Diproses';
                    actions.append(verifyButton);

                    const rejectButton = document.createElement('button');
                    rejectButton.type = 'button';
                    rejectButton.className = 'tenant-order-action bg-rose-600 hover:bg-rose-700';
                    rejectButton.textContent = 'Tolak Pesanan';
                    rejectButton.dataset.orderAction = 'toggle-rejection';
                    rejectButton.dataset.orderId = order.id;
                    actions.append(rejectButton);

                    const rejectionForm = document.createElement('form');
                    rejectionForm.className = 'hidden basis-full space-y-2';
                    rejectionForm.dataset.orderRejectionForm = '';
                    rejectionForm.dataset.orderId = order.id;
                    const reason = document.createElement('textarea');
                    reason.required = true;
                    reason.maxLength = 500;
                    reason.rows = 2;
                    reason.placeholder = 'Tuliskan alasan penolakan, misalnya bukti tidak valid atau nominal tidak sesuai';
                    reason.className = 'w-full rounded-lg border border-slate-200 p-2 text-sm outline-none focus:border-rose-400';
                    reason.addEventListener('input', () => reason.setCustomValidity(''));
                    const confirmReject = document.createElement('button');
                    confirmReject.type = 'submit';
                    confirmReject.className = 'tenant-order-action bg-rose-600 hover:bg-rose-700';
                    confirmReject.textContent = 'Kirim Penolakan';
                    rejectionForm.append(reason, confirmReject);
                    actions.append(rejectionForm);
                } else if (order.status === 'Menunggu') {
                    const action = document.createElement('button');
                    action.type = 'button';
                    action.className = 'tenant-order-action';
                    action.textContent = 'Terima Pesanan';
                    action.dataset.orderAction = 'update-status';
                    action.dataset.orderId = order.id;
                    action.dataset.nextStatus = 'Diproses';
                    actions.append(action);
                } else if (order.status === 'Diproses') {
                    const action = document.createElement('button');
                    action.type = 'button';
                    action.className = 'tenant-order-action';
                    action.textContent = 'Siap Diambil';
                    action.dataset.orderAction = 'update-status';
                    action.dataset.orderId = order.id;
                    action.dataset.nextStatus = 'Siap diambil';
                    actions.append(action);
                } else if (order.status === 'Siap diambil') {
                    const action = document.createElement('button');
                    action.type = 'button';
                    action.className = 'tenant-order-action bg-emerald-600 hover:bg-emerald-700';
                    action.textContent = 'Selesaikan Pesanan';
                    action.dataset.orderAction = 'update-status';
                    action.dataset.orderId = order.id;
                    action.dataset.nextStatus = 'Selesai';
                    actions.append(action);
                }
                row.append(actions);
                ordersList.append(row);
            });
        }

        async function loadOrders() {
            if (typeof activeTenantId !== 'string' || !activeTenantId.trim()) return;
            const { data: orders, error } = await db
                .from('orders')
                .select('id, tenant_id, nomor_pesanan, nomor_antrean, mahasiswa_id, nama_mahasiswa, phone, status, total, created_at, metode_pembayaran, bukti_transfer, alasan_pembatalan, order_items(id, nama_menu, harga_satuan, jumlah, subtotal, catatan, add_ons)')
                .eq('tenant_id', activeTenantId)
                .order('id', { ascending: false });
            if (error) {
                showMessage(`Gagal memuat pesanan: ${error.message}`, true);
                return;
            }
            renderOrders(orders || []);
            await loadOrderHistory();
        }

        async function loadOrderHistory() {
            if (typeof activeTenantId !== 'string' || !activeTenantId.trim()) return;
            const historyBody = document.getElementById('tenantHistoryBody');
            const { data: orders, error } = await db
                .from('orders')
                .select('id, nomor_pesanan, nomor_antrean, created_at, completed_at, nama_mahasiswa, total, order_items(id, nama_menu, jumlah, add_ons), tenant_reviews!tenant_reviews_order_id_fkey(rating, feedback_text)')
                .eq('tenant_id', activeTenantId)
                .eq('status', 'Selesai')
                .order('completed_at', { ascending: false, nullsFirst: false });
            historyBody.replaceChildren();
            if (error) {
                const row = document.createElement('tr');
                const cell = addText(row, 'td', 'px-5 py-4 text-sm text-rose-600', `Gagal memuat riwayat pesanan: ${error.message}`);
                cell.colSpan = 6;
                historyBody.append(row);
                return;
            }
            if (!orders?.length) {
                const row = document.createElement('tr');
                const cell = addText(row, 'td', 'px-5 py-4 text-sm text-slate-500', 'Belum ada riwayat pesanan.');
                cell.colSpan = 6;
                historyBody.append(row);
                return;
            }
            orders.forEach((order) => {
                const row = document.createElement('tr');
                const queueCell = document.createElement('td');
                queueCell.className = 'px-5 py-4';
                addText(queueCell, 'p', 'font-extrabold text-amber-900', `ANTREAN ${order.nomor_antrean || '-'}`);
                addText(queueCell, 'p', 'mt-1 text-xs font-semibold text-slate-500', order.nomor_pesanan || '-');
                row.append(queueCell);
                addText(row, 'td', 'whitespace-nowrap px-5 py-4 text-slate-600', formatOrderDate(order.completed_at || order.created_at));
                addText(row, 'td', 'px-5 py-4 text-slate-700', order.nama_mahasiswa || 'Mahasiswa');
                const menuCell = document.createElement('td');
                menuCell.className = 'max-w-sm px-5 py-4';
                const menuList = document.createElement('ul');
                menuList.className = 'space-y-2';
                (order.order_items || []).forEach((item) => {
                    const menuRow = document.createElement('li');
                    addText(menuRow, 'p', 'font-semibold text-slate-800', `${item.nama_menu} × ${item.jumlah}`);
                    const addons = normalizeOrderAddons(item.add_ons);
                    if (addons.length) {
                        const addonText = addons.map((addon) => {
                            const price = addon.price === null ? '' : addon.price === 0 ? ' (Gratis)' : ` (+${formatRupiah(addon.price)})`;
                            return `${addon.name}${price}`;
                        }).join(', ');
                        addText(menuRow, 'p', 'mt-1 text-xs text-slate-500', `Add-on: ${addonText}`);
                    }
                    menuList.append(menuRow);
                });
                menuCell.append(menuList);
                row.append(menuCell);
                addText(row, 'td', 'whitespace-nowrap px-5 py-4 font-semibold text-slate-800', formatRupiah(order.total));
                const reviewCell = document.createElement('td');
                reviewCell.className = 'max-w-sm px-5 py-4';
                const review = Array.isArray(order.tenant_reviews) ? order.tenant_reviews[0] : order.tenant_reviews;
                addText(reviewCell, 'p', 'font-bold text-amber-700', review?.rating ? `${review.rating} / 5 ★` : 'Belum ada rating');
                addText(reviewCell, 'p', 'mt-1 whitespace-pre-wrap text-slate-600', review?.feedback_text || 'Belum ada saran atau masukan.');
                row.append(reviewCell);
                historyBody.append(row);
            });
        }

        async function loadTenantMenu() {
            if (typeof activeTenantId !== 'string' || !activeTenantId.trim()) return;
            const { data: menuItems, error } = await db
                .from('menu_items')
                .select('id, nama_menu, kategori, harga, tersedia, foto_url')
                .eq('tenant_id', activeTenantId)
                .order('nama_menu');
            if (error) {
                showMessage(`Gagal memuat menu kantin: ${error.message}`, true);
                return;
            }
            renderTenantMenu(menuItems || []);
        }

        function scheduleRefresh() {
            window.clearTimeout(refreshTimer);
            refreshTimer = window.setTimeout(loadOrders, 200);
        }

        function scheduleHistoryRefresh() {
            window.clearTimeout(historyRefreshTimer);
            historyRefreshTimer = window.setTimeout(() => {
                loadOrderHistory().catch((error) => {
                    console.error('Gagal memperbarui riwayat feedback:', error);
                });
            }, 200);
        }

        async function initialize() {
            const { data: { session }, error: sessionError } = await db.auth.getSession();
            if (sessionError) {
                setTenantDashboardUnavailable('Sesi bermasalah', 'Realtime tidak aktif.', `Gagal memeriksa sesi: ${sessionError.message}`);
                return;
            }
            if (!session) {
                setTenantDashboardUnavailable('Silakan masuk', 'Realtime tidak aktif.', 'Sesi login tidak ditemukan. Silakan masuk kembali sebagai pemilik tenant.');
                window.location.href = '/';
                return;
            }

            const { data: profile, error: profileError } = await db
                .from('profiles')
                .select('id, peran')
                .eq('id', session.user.id)
                .single();
            if (profileError) {
                setTenantDashboardUnavailable('Profil tidak tersedia', 'Realtime tidak aktif.', `Gagal memuat profil: ${profileError.message}`);
                return;
            }
            if (profile.peran !== 'pemilik_tenant') {
                setTenantDashboardUnavailable(
                    'Khusus pemilik tenant',
                    'Realtime tidak aktif untuk akun ini.',
                    'Sesi yang digunakan bukan akun pemilik tenant. Silakan masuk menggunakan akun pemilik tenant untuk melihat status kantin.'
                );
                return;
            }
            const { data: tenant, error: tenantError } = await db
                .from('tenants')
                .select('id, nama_tenant, slug, status_buka, jam_buka, jam_tutup, override_until')
                .eq('pemilik_id', session.user.id)
                .maybeSingle();
            if (tenantError) {
                setTenantDashboardUnavailable('Tenant gagal dimuat', 'Realtime tidak aktif.', `Gagal memuat kantin milik akun ini: ${tenantError.message}`);
                return;
            }
            if (!tenant) {
                setTenantDashboardUnavailable(
                    'Tenant tidak ditemukan',
                    'Realtime tidak aktif.',
                    'Belum ada data tenant yang terhubung dengan akun pemilik ini.'
                );
                return;
            }
            const routeParts = window.location.pathname.split('/').filter(Boolean);
            if (routeParts[0] === 'tenant' && routeParts[2] === 'dashboard' && routeParts[1] !== tenant.slug) {
                setTenantDashboardUnavailable(
                    'Tenant tidak cocok',
                    'Realtime tidak aktif.',
                    'Dashboard tenant ini tidak sesuai dengan akun yang sedang masuk.'
                );
                return;
            }
            if (typeof tenant.id !== 'string' || !tenant.id.trim()) {
                setTenantDashboardUnavailable('ID tenant tidak valid', 'Realtime tidak aktif.', 'Data tenant tidak memiliki ID yang valid. Status dan pesanan tidak dapat dimuat.');
                return;
            }
            activeTenantId = tenant.id;
            document.getElementById('tenantName').textContent = tenant.nama_tenant;
            const tenantCatalogLink = document.getElementById('tenantCatalogLink');
            tenantCatalogLink.href = `/tenant/${encodeURIComponent(tenant.slug)}`;
            tenantCatalogLink.hidden = false;
            setTenantOpenStatus(tenant.status_buka, tenant);
            document.getElementById('tenantOpenStatus').disabled = false;
            subscribeToTenantStatus(session.user.id);

            channel = db
                .channel(`tenant-orders-${activeTenantId}`)
                .on('postgres_changes', {
                    event: '*',
                    schema: 'public',
                    table: 'orders',
                    filter: `tenant_id=eq.${activeTenantId}`
                }, (payload) => {
                    if (payload.eventType === 'INSERT' && payload.new?.tenant_id === activeTenantId) {
                        window.playNotificationSound?.();
                    }
                    const changedTenantId = payload.new?.tenant_id || payload.old?.tenant_id;
                    if (changedTenantId && changedTenantId !== activeTenantId) return;
                    scheduleRefresh();
                })
                .subscribe((status, error) => {
                    connectionStatus.textContent = status === 'SUBSCRIBED'
                        ? 'Realtime aktif'
                        : error
                            ? `Realtime ${status}: ${error.message}`
                            : `Realtime: ${status}`;
                    if (status !== 'SUBSCRIBED') {
                        console.error('Realtime pesanan tenant:', status, error);
                    }
                });

            reviewChannel = db
                .channel(`tenant-reviews-${activeTenantId}`)
                .on('postgres_changes', {
                    event: '*',
                    schema: 'public',
                    table: 'tenant_reviews',
                    filter: `tenant_id=eq.${activeTenantId}`,
                }, (payload) => {
                    const changedTenantId = payload.new?.tenant_id || payload.old?.tenant_id;
                    if (changedTenantId !== activeTenantId) return;
                    scheduleHistoryRefresh();
                })
                .subscribe((status, error) => {
                    if (status !== 'SUBSCRIBED') {
                        console.error('Realtime feedback tenant:', status, error);
                    }
                });

            await loadOrders();
            await loadTenantMenu();
        }

        document.getElementById('logoutButton').addEventListener('click', async () => {
            const { error } = await db.auth.signOut();
            if (error) {
                showMessage(`Gagal logout: ${error.message}`, true);
                return;
            }
            window.location.href = '/';
        });

        document.getElementById('tenantDashboardMenuButton').addEventListener('click', () => {
            const isOpen = document.getElementById('tenantDashboardTabs').classList.toggle('is-open');
            document.getElementById('tenantDashboardMenuButton').setAttribute('aria-expanded', String(isOpen));
        });
        document.getElementById('tenantOpenStatus').addEventListener('click', toggleTenantOpenStatus);
        document.getElementById('tenantStatsPeriod').addEventListener('change', renderTenantStats);
        document.querySelectorAll('[data-tenant-panel]').forEach((tab) => {
            tab.addEventListener('click', () => showTenantPanel(tab.dataset.tenantPanel));
        });

        window.addEventListener('pagehide', () => {
            window.clearTimeout(refreshTimer);
            window.clearTimeout(historyRefreshTimer);
            if (channel) db.removeChannel(channel);
            if (reviewChannel) db.removeChannel(reviewChannel);
            if (tenantStatusChannel) db.removeChannel(tenantStatusChannel);
        });

        function startDashboard() {
            initialize().catch((error) => {
                console.error('Gagal menginisialisasi dashboard tenant:', error);
                setTenantDashboardUnavailable(
                    'Dashboard gagal dimuat',
                    'Realtime tidak aktif.',
                    `Terjadi kesalahan saat memuat dashboard: ${error.message || error}`
                );
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', startDashboard, { once: true });
        } else {
            startDashboard();
        }
    </script>
</Layout>
