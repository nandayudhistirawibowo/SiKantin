---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-uym.png';

interface Props {
	title: string;
	profileInSidebar?: boolean;
}

const { title, profileInSidebar = false } = Astro.props;
---

<Layout title={`${title} | SiKantin Mahasiswa`} themeColor="#172b40" bodyClass="student-portal min-h-screen bg-slate-50 text-slate-800" noIndex>
	<div id="studentFlashMessage" role="status" aria-live="polite" class="fixed left-1/2 top-4 z-[100] hidden w-[min(90vw,32rem)] -translate-x-1/2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-center text-sm font-semibold text-emerald-800 shadow-lg"></div>
	<div class="min-h-screen md:flex">
		<button id="studentSidebarBackdrop" type="button" aria-label="Tutup menu" class="fixed inset-0 z-40 hidden bg-slate-950/60 backdrop-blur-sm md:hidden"></button>
		<aside id="studentSidebar" class="fixed inset-y-0 left-0 z-50 hidden w-72 student-sidebar-closed flex-col border-r border-slate-200 bg-white p-5 shadow-xl md:sticky md:top-0 md:flex md:h-screen md:shadow-none">
			<div class="flex items-center justify-between gap-3">
				<a href="/mahasiswa/dashboard" class="flex items-center gap-3">
					<span class="block h-11 w-11 shrink-0 rounded-full border border-slate-200 bg-white dark:border-slate-700">
						<img src={logo.src} alt="" class="h-full w-full rounded-full object-cover" />
					</span>
					<span>
						<span class="block text-sm font-black tracking-wide text-slate-900">SIKANTIN</span>
						<span class="block text-[11px] text-slate-500">Portal Mahasiswa</span>
					</span>
				</a>
			</div>

			{profileInSidebar && (
				<div id="studentSidebarProfileControl" class="relative mb-6 mt-6">
					<button id="studentProfileButton" type="button" aria-controls="studentProfileMenu" aria-expanded="false" class="flex w-full min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 text-left shadow-sm transition hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:border-blue-500/30 dark:bg-slate-800/80 dark:hover:bg-slate-700/80">
						<span class="block h-12 w-12 shrink-0 overflow-hidden rounded-full">
							<img id="studentAvatar" src={logo.src} data-avatar-fallback={logo.src} alt="" class="h-full w-full rounded-full border-2 border-white/20 object-cover" />
						</span>
						<span class="block min-w-0 flex-1">
							<span id="studentName" class="block max-w-40 truncate text-sm font-extrabold text-slate-800">Mahasiswa</span>
							<span class="block text-[11px] text-slate-500">Mahasiswa</span>
						</span>
						<svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="ml-auto h-4 w-4 shrink-0 text-slate-500"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.09 1.03l-4.25 4.5a.75.75 0 0 1-1.09 0l-4.25-4.5a.75.75 0 0 1 .02-1.05Z" clip-rule="evenodd" /></svg>
					</button>
					<div id="studentProfileMenu" class="absolute left-0 right-0 top-full z-50 mt-2 hidden rounded-xl border border-slate-200 bg-white p-2 shadow-xl transition-colors duration-200 dark:border-slate-700 dark:bg-slate-800">
						<a href="/profile" class="block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700">Profil</a>
						<button id="studentLogoutButton" type="button" class="w-full rounded-lg px-3 py-2 text-left text-sm font-semibold text-rose-700 hover:bg-rose-50">Logout</button>
					</div>
				</div>
			)}

			<p class="mb-2 mt-9 px-3 text-[11px] font-extrabold uppercase tracking-[0.18em] text-slate-400">Menu utama</p>
			<nav class="space-y-1" aria-label="Navigasi mahasiswa">
				<a data-student-nav href="/mahasiswa/dashboard" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-bold text-slate-600 transition hover:bg-blue-50 hover:text-blue-800">
					<span aria-hidden="true">⌂</span> Beranda
				</a>
				<a data-student-nav href="/mahasiswa/dashboard#dashboardTenantHeading" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-bold text-slate-600 transition hover:bg-blue-50 hover:text-blue-800">
					<span aria-hidden="true">⌕</span> Katalog
				</a>
				<a data-student-nav href="/mahasiswa/riwayat" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-bold text-slate-600 transition hover:bg-blue-50 hover:text-blue-800">
					<span aria-hidden="true">◷</span> Status Pesanan
				</a>
				<a data-student-nav href="/mahasiswa/favorit" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-bold text-slate-600 transition hover:bg-blue-50 hover:text-blue-800">
					<span aria-hidden="true">♡</span> Favorit
				</a>
				<a data-student-nav href="/mahasiswa/bantuan" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-bold text-slate-600 transition hover:bg-blue-50 hover:text-blue-800">
					<span aria-hidden="true">?</span> Bantuan
				</a>
			</nav>

		</aside>

		<div class="min-w-0 flex-1">
			<header class="site-header sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
				<div class="flex min-h-[4.5rem] items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
					<div class="flex min-w-0 items-center gap-3">
						<button id="studentMenuButton" type="button" aria-controls="studentSidebar" aria-expanded="false" aria-label="Buka menu" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border border-slate-200 bg-white p-2 text-slate-700 shadow-sm hover:bg-slate-50">
							<svg data-sidebar-icon="open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
							<svg data-sidebar-icon="close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-5 w-5"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" /></svg>
						</button>
						<div class="min-w-0">
							<p class="truncate text-sm font-extrabold text-slate-900">{title}</p>
							<p class="uym-brand-text hidden text-xs sm:block">Universitas Yatsi Madani</p>
						</div>
					</div>
					<div class="relative flex items-center gap-2">
						<span data-theme-toggle-slot class="contents"></span>
						{!profileInSidebar && <button id="studentProfileButton" type="button" aria-controls="studentProfileMenu" aria-expanded="false" class="flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-white p-2 text-left shadow-sm transition hover:border-blue-200 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:border-slate-700 dark:bg-slate-800 dark:hover:border-blue-500/40 dark:hover:bg-slate-700/80">
							<span class="block h-10 w-10 shrink-0 overflow-hidden rounded-full border border-blue-100 ring-2 ring-blue-50 dark:border-slate-600 dark:ring-slate-700">
								<img id="studentAvatar" src={logo.src} data-avatar-fallback={logo.src} alt="" class="h-full w-full rounded-full object-cover" />
							</span>
							<span class="hidden min-w-0 flex-1 sm:block">
								<span id="studentName" class="block max-w-40 truncate text-sm font-extrabold text-slate-800">Mahasiswa</span>
								<span class="block text-[11px] text-slate-500">Mahasiswa</span>
							</span>
							<svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="ml-auto h-4 w-4 shrink-0 text-slate-500"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.168l3.71-3.938a.75.75 0 1 1 1.09 1.03l-4.25 4.5a.75.75 0 0 1-1.09 0l-4.25-4.5a.75.75 0 0 1 .02-1.05Z" clip-rule="evenodd" /></svg>
						</button>}
						{!profileInSidebar && <div id="studentProfileMenu" class="absolute right-0 top-full z-50 mt-2 hidden w-48 rounded-xl border border-slate-200 bg-white p-2 shadow-xl transition-colors duration-200 dark:border-slate-700 dark:bg-slate-800">
							<a href="/profile" class="block rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-700">Profil</a>
							<button id="studentLogoutButton" type="button" class="w-full rounded-lg px-3 py-2 text-left text-sm font-semibold text-rose-700 hover:bg-rose-50">Logout</button>
						</div>}
					</div>
				</div>
			</header>
			<main class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
				<p id="studentShellMessage" role="status" aria-live="polite" class="mb-5 hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700"></p>
				<slot />
			</main>
		</div>
	</div>

	<script>
		import { db } from '../scripts/supabase.js';

		const menuButton = document.getElementById('studentMenuButton');
		const sidebar = document.getElementById('studentSidebar');
		const backdrop = document.getElementById('studentSidebarBackdrop');
		const profileButton = document.getElementById('studentProfileButton');
		const profileMenu = document.getElementById('studentProfileMenu');
		const shellMessage = document.getElementById('studentShellMessage');
		const flashMessage = document.getElementById('studentFlashMessage');
		const desktopSidebar = window.matchMedia('(min-width: 768px)');

		function displayFlashMessage() {
			try {
				const message = sessionStorage.getItem('flash_message');
				if (!message) return;
				sessionStorage.removeItem('flash_message');
				flashMessage.textContent = message;
				flashMessage.classList.remove('hidden', 'student-flash-leaving');
				flashMessage.classList.add('student-flash-entering');
				window.setTimeout(() => {
					flashMessage.classList.remove('student-flash-entering');
					flashMessage.classList.add('student-flash-leaving');
					window.setTimeout(() => {
						flashMessage.classList.add('hidden');
						flashMessage.classList.remove('student-flash-leaving');
					}, 220);
				}, 4500);
			} catch (error) {
				console.error('Notifikasi sesi gagal ditampilkan:', error);
			}
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', displayFlashMessage, { once: true });
		} else {
			displayFlashMessage();
		}

		function setSidebarPosition(isOpen) {
			if (desktopSidebar.matches) {
				sidebar.style.removeProperty('transform');
				return;
			}
			sidebar.style.setProperty('transform', isOpen ? 'translateX(0)' : 'translateX(-100%)', 'important');
		}

		if (desktopSidebar.matches) {
			sidebar.classList.remove('hidden', 'student-sidebar-closed', 'student-sidebar-collapsed');
			menuButton.setAttribute('aria-expanded', 'true');
			menuButton.setAttribute('aria-label', 'Tutup menu');
		} else {
			setSidebarPosition(false);
		}

		function closeSidebar(restoreFocus = false) {
			const wasOpen = menuButton.getAttribute('aria-expanded') === 'true';
			const isDrawer = !desktopSidebar.matches;
			menuButton.setAttribute('aria-expanded', 'false');
			menuButton.setAttribute('aria-label', 'Buka menu');
			backdrop.classList.add('hidden');
			document.body.classList.remove('overflow-hidden');
			if (isDrawer) {
				sidebar.classList.add('student-sidebar-closed', 'hidden');
			} else {
				sidebar.classList.add('student-sidebar-collapsed');
			}
			setSidebarPosition(false);
			if (restoreFocus && wasOpen) menuButton.focus();
		}

		menuButton.addEventListener('click', () => {
			const isDrawer = !desktopSidebar.matches;
			const isOpen = isDrawer
				? !sidebar.classList.contains('hidden') && !sidebar.classList.contains('student-sidebar-closed')
				: !sidebar.classList.contains('hidden') && !sidebar.classList.contains('student-sidebar-collapsed');
			if (isOpen) {
				closeSidebar(true);
				return;
			}
			sidebar.classList.remove('student-sidebar-collapsed');
			if (isDrawer) {
				sidebar.classList.remove('hidden');
				sidebar.classList.remove('student-sidebar-closed');
				backdrop.classList.remove('hidden');
				document.body.classList.add('overflow-hidden');
			}
			setSidebarPosition(true);
			menuButton.setAttribute('aria-expanded', 'true');
			menuButton.setAttribute('aria-label', 'Tutup menu');
			menuButton.focus();
		});

		backdrop.addEventListener('click', () => closeSidebar(true));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				closeSidebar(true);
				profileMenu.classList.add('hidden');
				profileButton.setAttribute('aria-expanded', 'false');
			}
		});
		let wasDesktop = desktopSidebar.matches;
		function syncSidebarBreakpoint() {
			const isDesktop = desktopSidebar.matches;
			if (isDesktop === wasDesktop) return;
			wasDesktop = isDesktop;
			backdrop.classList.add('hidden');
			document.body.classList.remove('overflow-hidden');
			sidebar.classList.remove('student-sidebar-collapsed');
			if (isDesktop) {
				sidebar.classList.remove('hidden', 'student-sidebar-closed');
			} else {
				sidebar.classList.add('hidden', 'student-sidebar-closed');
			}
			setSidebarPosition(isDesktop);
			menuButton.setAttribute('aria-expanded', String(isDesktop));
			menuButton.setAttribute('aria-label', isDesktop ? 'Tutup menu' : 'Buka menu');
		}
		desktopSidebar.addEventListener('change', syncSidebarBreakpoint);
		window.addEventListener('resize', syncSidebarBreakpoint);

		profileButton.addEventListener('click', () => {
			const isOpen = profileButton.getAttribute('aria-expanded') === 'true';
			profileButton.setAttribute('aria-expanded', String(!isOpen));
			profileMenu.classList.toggle('hidden', isOpen);
		});
		document.addEventListener('click', (event) => {
			if (!profileButton.contains(event.target) && !profileMenu.contains(event.target)) {
				profileButton.setAttribute('aria-expanded', 'false');
				profileMenu.classList.add('hidden');
			}
		});

		document.querySelectorAll('[data-student-nav]').forEach((link) => {
			const linkUrl = new URL(link.href, window.location.origin);
			const samePath = linkUrl.pathname === window.location.pathname;
			const sameSection = linkUrl.hash
				? linkUrl.hash === window.location.hash
				: !window.location.hash;
			if (samePath && sameSection) {
				link.classList.add('bg-blue-50', 'text-blue-800');
				link.setAttribute('aria-current', 'page');
			}
		});

		document.getElementById('studentLogoutButton').addEventListener('click', async () => {
			const { error } = await db.auth.signOut();
			if (error) {
				shellMessage.textContent = `Logout gagal: ${error.message}`;
				shellMessage.classList.remove('hidden');
				return;
			}
			window.location.assign('/');
		});

		async function initializeStudentShell() {
			const { data: { session }, error: sessionError } = await db.auth.getSession();
			if (sessionError) {
				shellMessage.textContent = `Sesi gagal diperiksa: ${sessionError.message}`;
				shellMessage.classList.remove('hidden');
				return;
			}
			if (!session) {
				window.location.replace(`/mahasiswa/login?redirect=${encodeURIComponent(window.location.pathname)}`);
				return;
			}
			const { data: profile, error: profileError } = await db
				.from('profiles')
				.select('nama, peran, avatar_url')
				.eq('id', session.user.id)
				.single();
			if (profileError) {
				shellMessage.textContent = `Profil gagal dimuat: ${profileError.message}`;
				shellMessage.classList.remove('hidden');
				return;
			}
			if (profile.peran !== 'mahasiswa') {
				const dashboardByRole = {
					pemilik_tenant: '/tenant-dashboard',
					tenant: '/tenant-dashboard',
					admin: '/admin/dashboard',
				};
				const dashboard = dashboardByRole[profile.peran];
				if (dashboard) {
					window.location.replace(dashboard);
					return;
				}
				shellMessage.textContent = 'Akun ini tidak memiliki role mahasiswa yang valid. Hubungi administrator.';
				shellMessage.classList.remove('hidden');
				return;
			}

			const studentName = document.getElementById('studentName');
			studentName.textContent = profile.nama || session.user.email || 'Mahasiswa';
			studentName.title = studentName.textContent;
			const avatar = document.getElementById('studentAvatar');
			avatar.src = profile.avatar_url || avatar.dataset.avatarFallback;
			avatar.onerror = () => { avatar.src = avatar.dataset.avatarFallback; };
		}

		initializeStudentShell();
	</script>

	<style>
		@keyframes student-flash-enter {
			from { opacity: 0; translate: 0 -0.5rem; }
			to { opacity: 1; translate: 0 0; }
		}

		@keyframes student-flash-leave {
			from { opacity: 1; }
			to { opacity: 0; }
		}

		.student-flash-entering { animation: student-flash-enter 240ms ease-out both; }
		.student-flash-leaving { animation: student-flash-leave 220ms ease-in both; }

		@media (prefers-reduced-motion: reduce) {
			.student-flash-entering,
			.student-flash-leaving { animation: none; }
		}

		@media (max-width: 767px) {
			header {
				z-index: 60 !important;
			}

			#studentMenuButton {
				display: inline-flex !important;
				visibility: visible !important;
				opacity: 1 !important;
			}

			#studentMenuButton[aria-expanded='true'] [data-sidebar-icon='open'],
			#studentMenuButton[aria-expanded='false'] [data-sidebar-icon='close'] {
				display: none !important;
			}

			#studentMenuButton[aria-expanded='true'] [data-sidebar-icon='close'],
			#studentMenuButton[aria-expanded='false'] [data-sidebar-icon='open'] {
				display: block !important;
			}

			#studentSidebar {
				position: fixed !important;
				inset: 0 auto 0 0 !important;
				z-index: 50 !important;
				display: flex !important;
				width: min(18rem, calc(100vw - 4rem)) !important;
				height: 100dvh !important;
				transform: translateX(-100%) !important;
				translate: none !important;
			}

			#studentSidebar.hidden {
				display: none !important;
			}

			#studentSidebar:not(.hidden):not(.student-sidebar-closed) {
				transform: translateX(0) !important;
			}

			#studentSidebar.student-sidebar-closed {
				transform: translateX(-100%) !important;
			}

			#studentSidebarBackdrop:not(.hidden) {
				display: block !important;
			}
		}

		@media (min-width: 768px) {
			#studentSidebar {
				display: flex !important;
				position: sticky !important;
				height: 100vh !important;
				transform: none !important;
				translate: none !important;
			}

			#studentSidebar.student-sidebar-collapsed {
				display: none !important;
			}

			#studentMenuButton {
				display: inline-flex !important;
			}
		}
	</style>
</Layout>