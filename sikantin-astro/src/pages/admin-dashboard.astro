---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-uym.png';
import '../styles/admin-dashboard.css';
---

<Layout title="Dashboard Admin | SiKantin" themeColor="#ffffff" bodyClass="min-h-screen bg-slate-50 text-slate-800" noIndex>

<div class="min-h-screen lg:flex">
        <aside id="adminSidebar" class="fixed inset-y-0 left-0 z-30 w-64 -translate-x-full border-r border-slate-200 bg-white p-5 transition-transform lg:static lg:min-h-screen lg:translate-x-0">
            <a href="/admin/dashboard" class="flex items-center gap-3">
                <img src={logo.src} alt="Logo Universitas Yatsi Madani" class="h-11 w-11 object-contain">
                <span><span class="block font-extrabold text-slate-900">SiKantin</span><span class="text-xs text-slate-500">Administrator</span></span>
            </a>
            <nav class="mt-8 space-y-1" aria-label="Navigasi admin">
                <a href="#adminHome" data-admin-nav class="admin-nav-link is-active block rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-100">Dashboard</a>
                <a href="#studentsSection" data-admin-nav class="admin-nav-link block rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-100">Kelola User</a>
                <a href="#tenantsSection" data-admin-nav class="admin-nav-link block rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-100">Kelola Tenant</a>
                <a href="#menusSection" data-admin-nav class="admin-nav-link block rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-100">Kelola Menu</a>
                <a href="#reportsSection" data-admin-nav class="admin-nav-link block rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-100">Laporan</a>
            </nav>
        </aside>
        <div id="adminOverlay" class="fixed inset-0 z-20 hidden bg-slate-900/50 lg:hidden"></div>
        <div class="min-w-0 flex-1">
            <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/95 backdrop-blur">
                <div class="flex items-center justify-between gap-3 px-4 py-4 sm:px-7">
                    <div class="flex items-center gap-3">
                        <button id="adminMenuButton" type="button" aria-label="Buka navigasi admin" aria-expanded="false" class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-bold text-slate-700 lg:hidden">☰</button>
                        <div><p class="text-xs font-bold uppercase tracking-wider text-blue-700">Panel Admin</p><h1 class="font-extrabold text-slate-900">Manajemen SiKantin</h1></div>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="/profile" class="hidden rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 sm:inline-flex">Edit Profil</a>
                        <button id="logoutButton" type="button" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50">Keluar</button>
                    </div>
                </div>
            </header>
            <main id="adminHome" class="mx-auto max-w-7xl space-y-7 p-4 sm:p-7">
                <p id="message" role="status" aria-live="polite" class="hidden rounded-lg p-3 text-sm"></p>
                <section class="grid gap-4 sm:grid-cols-3" aria-label="Ringkasan admin">
                    <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"><p class="text-sm font-semibold text-slate-500">Mahasiswa terdaftar</p><p id="studentCount" class="mt-2 text-3xl font-extrabold text-blue-700">—</p></article>
                    <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"><p class="text-sm font-semibold text-slate-500">Tenant terdaftar</p><p id="tenantCount" class="mt-2 text-3xl font-extrabold text-emerald-700">—</p></article>
                    <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"><p class="text-sm font-semibold text-slate-500">Tenant buka</p><p id="openTenantCount" class="mt-2 text-3xl font-extrabold text-amber-600">—</p></article>
                </section>

                <section id="studentsSection" class="scroll-mt-24 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5">
                        <div><h2 class="font-extrabold text-slate-900">Kelola User</h2><p class="mt-1 text-xs text-slate-500">Data seluruh akun dari profiles.</p></div>
                        <button id="addUserButton" type="button" class="rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-800">Tambah User</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[850px] text-left text-sm">
                            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3">Nama</th><th class="px-5 py-3">NIM</th><th class="px-5 py-3">WhatsApp</th><th class="px-5 py-3">Role</th><th class="px-5 py-3">Aksi</th></tr></thead>
                            <tbody id="studentsTable" class="divide-y divide-slate-100"><tr><td colspan="5" class="px-5 py-5 text-slate-500">Memuat user...</td></tr></tbody>
                        </table>
                    </div>
                </section>

                <section id="tenantsSection" class="scroll-mt-24 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5">
                        <div><h2 class="font-extrabold text-slate-900">Kelola Tenant</h2><p class="mt-1 text-xs text-slate-500">Data tenant, pemilik, kontak, operasional, dan QRIS.</p></div>
                        <button id="addTenantButton" type="button" class="rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-800">Tambah Tenant</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[1100px] text-left text-sm">
                            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3">Nama Tenant</th><th class="px-5 py-3">Lokasi</th><th class="px-5 py-3">Jam Operasional</th><th class="px-5 py-3">WhatsApp</th><th class="px-5 py-3">QRIS</th><th class="px-5 py-3">Pemilik</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Aksi</th></tr></thead>
                            <tbody id="tenantsTable" class="divide-y divide-slate-100"><tr><td colspan="8" class="px-5 py-5 text-slate-500">Memuat tenant...</td></tr></tbody>
                        </table>
                    </div>
                </section>

                <section id="menusSection" class="scroll-mt-24 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5">
                        <div><h2 class="font-extrabold text-slate-900">Kelola Menu</h2><p class="mt-1 text-xs text-slate-500">Data menu dari tabel menu_items.</p></div>
                        <button id="addMenuButton" type="button" class="rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-800">Tambah Menu</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[1100px] text-left text-sm">
                            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3">Nama Menu</th><th class="px-5 py-3">Tenant</th><th class="px-5 py-3">Kategori</th><th class="px-5 py-3">Harga</th><th class="px-5 py-3">Waktu Persiapan</th><th class="px-5 py-3">Add-On</th><th class="px-5 py-3">Foto</th><th class="px-5 py-3">Aksi</th></tr></thead>
                            <tbody id="menusTable" class="divide-y divide-slate-100"><tr><td colspan="8" class="px-5 py-5 text-slate-500">Memuat menu...</td></tr></tbody>
                        </table>
                    </div>
                </section>

                <section id="reportsSection" class="scroll-mt-24 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                    <h2 class="font-extrabold text-slate-900">Laporan</h2>
                    <p class="mt-2 text-sm text-slate-600">Ringkasan akun dan tenant ditampilkan di panel ini. Rincian transaksi tetap mengikuti hak akses database.</p>
                </section>
            </main>
        </div>
    </div>

    <div id="userModal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-labelledby="userModalTitle">
        <form id="createUserForm" class="max-h-[90vh] w-full max-w-lg space-y-4 overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
            <div class="flex items-start justify-between gap-3">
                <div><h2 id="userModalTitle" class="text-xl font-extrabold text-slate-900">Tambah User</h2><p class="mt-1 text-sm text-slate-500">Akun dibuat melalui Edge Function create-user.</p></div>
                <button id="closeUserModalButton" type="button" aria-label="Tutup" class="rounded-lg px-2 py-1 text-xl text-slate-500 hover:bg-slate-100">×</button>
            </div>
            <p id="modalMessage" role="status" aria-live="polite" class="hidden rounded-lg p-3 text-sm"></p>
            <label class="block text-sm font-bold">Role<select id="newUserRole" name="peran" required class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal"><option value="mahasiswa">Mahasiswa</option><option value="pemilik_tenant">Pemilik tenant</option></select></label>
            <label id="userIdentifierLabel" class="block text-sm font-bold" for="userIdentifier">NIM
                <input id="userIdentifier" name="identifier" inputmode="numeric" pattern="[0-9]{6,20}" autocomplete="username" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <p id="identifierHelp" class="-mt-2 text-xs text-slate-500">Login menggunakan NIM ini; email akun dibuat otomatis.</p>
            <label id="newUserPhoneField" class="hidden text-sm font-bold" for="newUserPhone">Nomor WhatsApp pemilik tenant
                <input id="newUserPhone" name="no_telepon" type="tel" inputmode="numeric" autocomplete="tel" maxlength="16" pattern="628[0-9]{8,13}" placeholder="6281234567890" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
                <span class="mt-1 block text-xs font-normal text-slate-500">Opsional. Gunakan format 628 tanpa tanda + atau spasi.</span>
            </label>
            <label class="block text-sm font-bold" for="newUserPassword">Password
                <input id="newUserPassword" name="password" type="password" required minlength="8" maxlength="128" autocomplete="new-password" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <div class="flex justify-end gap-2 pt-2">
                <button id="cancelUserButton" type="button" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-50">Batal</button>
                <button id="createUserSubmit" type="submit" class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white hover:bg-blue-800 disabled:opacity-60">Buat User</button>
            </div>
        </form>
    </div>
    <div id="userEditModal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-labelledby="userEditModalTitle">
        <form id="editUserForm" class="max-h-[90vh] w-full max-w-lg space-y-4 overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
            <div class="flex items-start justify-between gap-3">
                <div><h2 id="userEditModalTitle" class="text-xl font-extrabold text-slate-900">Edit User</h2><p class="mt-1 text-sm text-slate-500">Perbarui informasi profil user.</p></div>
                <button type="button" data-close-modal="userEditModal" aria-label="Tutup" class="rounded-lg px-2 py-1 text-xl text-slate-500 hover:bg-slate-100">×</button>
            </div>
            <p id="userEditMessage" role="status" aria-live="polite" class="hidden rounded-lg p-3 text-sm"></p>
            <input id="editUserId" name="id" type="hidden">
            <label class="block text-sm font-bold" for="editUserName">Nama
                <input id="editUserName" name="nama" maxlength="120" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <label class="block text-sm font-bold" for="editUserPhone">No. HP
                <input id="editUserPhone" name="no_telepon" type="tel" maxlength="30" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <label id="editUserNimField" class="block text-sm font-bold" for="editUserNim">NIM
                <input id="editUserNim" name="nim" inputmode="numeric" pattern="[0-9]{6,20}" maxlength="20" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" data-close-modal="userEditModal" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-50">Batal</button>
                <button id="editUserSubmit" type="submit" class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white hover:bg-blue-800 disabled:opacity-60">Simpan</button>
            </div>
        </form>
    </div>
    <div id="tenantModal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-labelledby="tenantModalTitle">
        <form id="tenantForm" class="max-h-[90vh] w-full max-w-lg space-y-4 overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
            <div class="flex items-start justify-between gap-3">
                <div><h2 id="tenantModalTitle" class="text-xl font-extrabold text-slate-900">Tambah Tenant</h2><p class="mt-1 text-sm text-slate-500">Informasi tenant dan QRIS pembayaran.</p></div>
                <button type="button" data-close-modal="tenantModal" aria-label="Tutup" class="rounded-lg px-2 py-1 text-xl text-slate-500 hover:bg-slate-100">×</button>
            </div>
            <p id="tenantModalMessage" role="status" aria-live="polite" class="hidden rounded-lg p-3 text-sm"></p>
            <input id="tenantId" name="id" type="hidden">
            <label class="block text-sm font-bold" for="tenantName">Nama tenant
                <input id="tenantName" name="nama_tenant" maxlength="120" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <label class="block text-sm font-bold" for="tenantLocation">Lokasi
                <input id="tenantLocation" name="lokasi" maxlength="255" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <fieldset class="space-y-2">
                <legend class="text-sm font-bold">Jadwal buka otomatis (WIB)</legend>
                <div class="grid grid-cols-2 gap-3">
                    <label class="text-xs font-semibold text-slate-600" for="tenantOpenTime">Jam buka
                        <input id="tenantOpenTime" name="jam_buka" type="time" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-normal text-slate-900">
                    </label>
                    <label class="text-xs font-semibold text-slate-600" for="tenantCloseTime">Jam tutup
                        <input id="tenantCloseTime" name="jam_tutup" type="time" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-normal text-slate-900">
                    </label>
                </div>
                <p class="text-xs font-normal text-slate-500">Kosongkan keduanya untuk menonaktifkan jadwal otomatis. Jam tutup boleh melewati tengah malam.</p>
            </fieldset>
            <input id="tenantHours" name="jam_operasional" type="hidden">
            <label class="block text-sm font-bold" for="tenantPhone">No. HP
                <input id="tenantPhone" name="no_telepon" type="tel" maxlength="30" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <label class="block text-sm font-bold" for="tenantOwner">Pemilik tenant
                <select id="tenantOwner" name="pemilik_id" required class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal"></select>
            </label>
            <label class="block text-sm font-bold" for="tenantQris">Upload QRIS
                <input id="tenantQris" name="qris_image" type="file" accept="image/*" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
                <span id="tenantQrisHelp" class="mt-1 block text-xs font-normal text-slate-500">Format gambar, maksimal 5 MB.</span>
            </label>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" data-close-modal="tenantModal" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-50">Batal</button>
                <button id="tenantSubmit" type="submit" class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white hover:bg-blue-800 disabled:opacity-60">Simpan</button>
            </div>
        </form>
    </div>
    <div id="menuModal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-900/50 p-4" role="dialog" aria-modal="true" aria-labelledby="menuModalTitle">
        <form id="menuForm" class="max-h-[90vh] w-full max-w-lg space-y-4 overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
            <div class="flex items-start justify-between gap-3">
                <div><h2 id="menuModalTitle" class="text-xl font-extrabold text-slate-900">Tambah Menu</h2><p class="mt-1 text-sm text-slate-500">Isi detail menu dan foto produk.</p></div>
                <button type="button" data-close-modal="menuModal" aria-label="Tutup" class="rounded-lg px-2 py-1 text-xl text-slate-500 hover:bg-slate-100">×</button>
            </div>
            <p id="menuModalMessage" role="status" aria-live="polite" class="hidden rounded-lg p-3 text-sm"></p>
            <input id="menuId" name="id" type="hidden">
            <label class="block text-sm font-bold" for="menuTenant">Tenant
                <select id="menuTenant" name="tenant_id" required class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal"></select>
            </label>
            <label class="block text-sm font-bold" for="menuName">Nama menu
                <input id="menuName" name="nama_menu" maxlength="120" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <label class="block text-sm font-bold" for="menuCategory">Kategori
                <select id="menuCategory" name="kategori" required class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-normal">
                    <option value="">Pilih kategori</option>
                    <option value="Makanan">Makanan</option>
                    <option value="Minuman">Minuman</option>
                    <option value="Snack">Snack</option>
                    <option value="Paket Hemat">Paket Hemat</option>
                </select>
            </label>
            <label class="block text-sm font-bold" for="menuPrice">Harga (Rp)
                <input id="menuPrice" name="harga" type="number" min="0" step="1" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <label class="block text-sm font-bold" for="menuPreparation">Waktu persiapan (menit)
                <input id="menuPreparation" name="waktu_persiapan" type="number" min="0" max="1440" step="1" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
            </label>
            <section class="rounded-xl border border-slate-200 p-4" aria-labelledby="menuAddonsTitle">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div><h3 id="menuAddonsTitle" class="text-sm font-extrabold text-slate-800">Add-On / Topping</h3><p class="mt-1 text-xs font-normal text-slate-500">Tambahkan pilihan opsional beserta harga tambahannya.</p></div>
                    <button id="addMenuAddonButton" type="button" class="rounded-lg border border-blue-200 px-3 py-2 text-xs font-bold text-blue-700 hover:bg-blue-50">+ Tambah Add-On</button>
                </div>
                <div id="menuAddonsList" class="mt-3 space-y-2"></div>
            </section>
            <label class="block text-sm font-bold" for="menuPhoto">Upload foto
                <input id="menuPhoto" name="foto" type="file" accept="image/*" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal">
                <span id="menuPhotoHelp" class="mt-1 block text-xs font-normal text-slate-500">Format gambar, maksimal 5 MB.</span>
            </label>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" data-close-modal="menuModal" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-50">Batal</button>
                <button id="menuSubmit" type="submit" class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white hover:bg-blue-800 disabled:opacity-60">Simpan</button>
            </div>
        </form>
    </div>
    <script src="../scripts/admin-dashboard.js"></script>
</Layout>
