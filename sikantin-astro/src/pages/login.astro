---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-uym.png';
import '../styles/login.css';
---

<Layout title="Login Mahasiswa | SiKantin" themeColor="#172b40" bodyClass="login-screen flex min-h-screen items-center justify-center px-4 py-8 text-slate-100">

<main class="w-full max-w-md rounded-[1.75rem] border border-white/15 bg-slate-900/50 p-6 shadow-2xl backdrop-blur-xl sm:p-10">
        <a href="/" class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-blue-100/75 hover:text-white">← Kembali ke beranda</a>
        <div class="mb-7 text-center">
            <img src={logo.src} alt="Logo Universitas Yatsi Madani" class="mx-auto mb-4 h-16 w-16 rounded-full bg-white p-1 shadow">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-300">SiKantin UYM</p>
            <h1 id="loginHeading" class="mt-2 text-3xl font-extrabold">Login Mahasiswa</h1>
        </div>
        <form id="loginForm" class="space-y-5">
            <label class="block text-sm font-semibold" for="nim">NIM atau email akun
                <input id="nim" class="login-input mt-2" type="text" autocomplete="username" placeholder="NIM atau email Supabase" required>
            </label>
            <label class="block text-sm font-semibold" for="password">Password
                <input id="password" class="login-input mt-2" type="password" autocomplete="current-password" placeholder="Masukkan password" required>
            </label>
            <button type="submit" class="w-full rounded-xl bg-blue-600 px-4 py-3 font-extrabold hover:bg-blue-500 disabled:opacity-60">Masuk ke SiKantin <span aria-hidden="true">→</span></button>
        </form>
        <p id="message" class="mt-4 hidden text-center text-sm font-bold" role="status" aria-live="polite"></p>
    </main>
    <script>
	import { db } from '../scripts/supabase.js';
        const message = document.getElementById('message');
        const loginForm = document.getElementById('loginForm');
        const adminLogin = new URLSearchParams(window.location.search).get('role') === 'admin';
        if (adminLogin) {
            document.title = 'Login Administrator | SiKantin';
            document.getElementById('loginHeading').textContent = 'Login Administrator';
        }

        function showMessage(text, isError) {
            message.textContent = text;
            message.className = `mt-4 text-center text-sm font-bold ${isError ? 'text-red-300' : 'text-green-300'}`;
        }

        loginForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const identifier = document.getElementById('nim').value.trim();
            const email = /^\d{6,20}$/.test(identifier) ? `${identifier}@uym.ac.id` : identifier;
            const button = loginForm.querySelector('button[type="submit"]');
            button.disabled = true;
            showMessage('Memeriksa akun...', false);

            const { data, error } = await db.auth.signInWithPassword({
                email,
                password: document.getElementById('password').value
            });
            if (error) {
                showMessage(`Login gagal: ${error.message}`, true);
                button.disabled = false;
                return;
            }

            const { data: profile, error: profileError } = await db
                .from('profiles')
                .select('peran')
                .eq('id', data.user.id)
                .single();
            if (profileError) {
                await db.auth.signOut();
                showMessage(`Profil gagal dimuat: ${profileError.message}`, true);
                button.disabled = false;
                return;
            }
            if (adminLogin && profile.peran !== 'admin') {
                await db.auth.signOut();
                showMessage('Akun ini bukan akun administrator.', true);
                button.disabled = false;
                return;
            }
            if (profile.peran === 'admin') {
                showMessage('Login berhasil. Membuka dashboard admin...', false);
                window.location.assign('/admin/dashboard');
                return;
            }
            if (profile.peran !== 'mahasiswa') {
                await db.auth.signOut();
                showMessage('Akun ini bukan akun mahasiswa.', true);
                button.disabled = false;
                return;
            }
            showMessage('Login berhasil. Membuka dashboard...', false);
            window.location.assign('/dashboard');
        });
    </script>
</Layout>
