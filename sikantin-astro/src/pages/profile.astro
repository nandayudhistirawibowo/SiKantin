---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-uym.png';
import '../styles/profile.css';
---

<Layout title="Edit Profil | SiKantin" themeColor="#ffffff" bodyClass="min-h-screen bg-slate-50 text-slate-800" noIndex>

<header class="site-header border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
            <a href="/mahasiswa/dashboard" id="backLink" class="arrow-action arrow-left arrow-before text-sm font-bold text-blue-700 hover:underline">Kembali ke Dashboard</a>
        <div class="flex items-center gap-3">
            <span data-theme-toggle-slot class="contents"></span>
        </div>
    </div>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-8">
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
            <div class="mb-7">
                <p class="text-sm font-bold text-blue-700">Akun SiKantin</p>
                <h1 class="mt-1 text-2xl font-extrabold text-slate-900">Edit Profil</h1>
                <p class="mt-2 text-sm text-slate-500">Perbarui informasi profil dan foto yang ditampilkan di dashboard.</p>
            </div>
            <p id="message" role="status" aria-live="polite" class="mb-5 hidden rounded-lg p-3 text-sm"></p>
            <form id="profileForm" class="space-y-5">
                <div>
                    <label class="mb-2 block text-sm font-bold" for="avatarFile">Foto profil</label>
                    <div class="flex flex-wrap items-center gap-4">
                        <img id="avatarPreview" src={logo.src} alt="Pratinjau foto profil" class="h-20 w-20 rounded-full border border-slate-200 bg-slate-50 object-cover">
                        <div class="min-w-0 flex-1">
                            <input id="avatarFile" type="file" accept="image/*" class="block w-full text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-blue-50 file:px-3 file:py-2 file:font-bold file:text-blue-700">
                            <p class="mt-2 text-xs text-slate-500">Pilih gambar maksimal 5 MB. File disimpan di bucket avatars.</p>
                        </div>
                    </div>
                </div>
                <label class="block text-sm font-bold" for="nama">
                    Nama lengkap
                    <input id="nama" name="nama" type="text" maxlength="120" autocomplete="name" readonly aria-describedby="studentIdentityHelp" required class="mt-2 w-full cursor-not-allowed rounded-lg border border-slate-200 bg-slate-100 px-3 py-2.5 font-normal text-slate-600">
                </label>
                <label class="block text-sm font-bold" for="nimEmail">
                    NIM / Email
                    <input id="nimEmail" type="text" readonly class="mt-2 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2.5 font-normal text-slate-600">
                </label>
                <p id="studentIdentityHelp" class="-mt-3 hidden text-xs font-normal text-slate-500">Nama dan NIM tidak dapat diubah. Hubungi Admin jika ada kesalahan.</p>
                <label class="block text-sm font-bold" for="whatsapp">
                    Nomor WhatsApp
                    <input id="whatsapp" name="whatsapp" type="tel" inputmode="numeric" autocomplete="tel" placeholder="6281234567890" pattern="628[0-9]{8,13}" title="Gunakan format 628 diikuti 8 sampai 13 digit" required class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2.5 font-normal outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                    <span class="mt-1 block text-xs font-normal text-slate-500">Gunakan format 628..., tanpa tanda + atau spasi.</span>
                </label>
                <button id="saveButton" type="submit" class="w-full rounded-lg bg-blue-700 px-4 py-3 text-sm font-extrabold text-white transition hover:bg-blue-800 disabled:cursor-wait disabled:opacity-60">Simpan Perubahan</button>
            </form>
        </section>
        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
            <div class="mb-6">
                <p class="text-sm font-bold text-blue-700">Keamanan akun</p>
                <h2 class="mt-1 text-xl font-extrabold text-slate-900">Ganti Password</h2>
                <p id="passwordRequirement" class="mt-2 text-sm text-slate-500">Gunakan password baru minimal 6 karakter.</p>
            </div>
            <p id="passwordMessage" role="status" aria-live="polite" class="mb-5 hidden rounded-lg p-3 text-sm"></p>
            <form id="passwordForm" class="space-y-5">
                <div class="block text-sm font-bold">
                    <label for="newPassword">Password Baru</label>
                    <div class="relative mt-2">
                        <input id="newPassword" name="newPassword" type="password" minlength="6" autocomplete="new-password" required class="w-full rounded-lg border border-slate-300 py-2.5 pl-3 pr-12 font-normal outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                        <button type="button" data-password-toggle aria-label="Tampilkan password" aria-pressed="false" class="absolute right-2 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-md text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
                            <svg data-eye-icon aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg data-eye-off-icon aria-hidden="true" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.1A10.8 10.8 0 0 1 12 4.8c6 0 9.75 7.2 9.75 7.2a18.8 18.8 0 0 1-2.1 2.9"/><path d="M6.1 6.1C3.6 7.8 2.25 12 2.25 12S6 18.75 12 18.75c1.2 0 2.3-.2 3.3-.6"/></svg>
                        </button>
                    </div>
                </div>
                <div class="block text-sm font-bold">
                    <label for="confirmNewPassword">Konfirmasi Password Baru</label>
                    <div class="relative mt-2">
                        <input id="confirmNewPassword" name="confirmNewPassword" type="password" minlength="6" autocomplete="new-password" required class="w-full rounded-lg border border-slate-300 py-2.5 pl-3 pr-12 font-normal outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                        <button type="button" data-password-toggle aria-label="Tampilkan password" aria-pressed="false" class="absolute right-2 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-md text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
                            <svg data-eye-icon aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg data-eye-off-icon aria-hidden="true" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.1A10.8 10.8 0 0 1 12 4.8c6 0 9.75 7.2 9.75 7.2a18.8 18.8 0 0 1-2.1 2.9"/><path d="M6.1 6.1C3.6 7.8 2.25 12 2.25 12S6 18.75 12 18.75c1.2 0 2.3-.2 3.3-.6"/></svg>
                        </button>
                    </div>
                </div>
                <button id="changePasswordButton" type="submit" class="w-full rounded-lg bg-blue-700 px-4 py-3 text-sm font-extrabold text-white transition hover:bg-blue-800 disabled:cursor-wait disabled:opacity-60">Ganti Password</button>
            </form>
        </section>
    </main>
    <script>
	import { db } from '../scripts/supabase.js';
        document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
            const input = toggle.parentElement.querySelector('input');
            toggle.addEventListener('click', () => {
                const isVisible = input.type === 'password';
                input.type = isVisible ? 'text' : 'password';
                toggle.querySelector('[data-eye-icon]').classList.toggle('hidden', isVisible);
                toggle.querySelector('[data-eye-off-icon]').classList.toggle('hidden', !isVisible);
                toggle.setAttribute('aria-label', isVisible ? 'Sembunyikan password' : 'Tampilkan password');
                toggle.setAttribute('aria-pressed', String(isVisible));
            });
        });

        const profileForm = document.getElementById('profileForm');
        const passwordForm = document.getElementById('passwordForm');
        const message = document.getElementById('message');
        const passwordMessage = document.getElementById('passwordMessage');
        const avatarFile = document.getElementById('avatarFile');
        const avatarPreview = document.getElementById('avatarPreview');
        let currentUser;
        let currentProfile;
        let selectedAvatar;
        let previewObjectUrl;

        function showMessage(text, isError) {
            message.textContent = text;
            message.className = `mb-5 rounded-lg p-3 text-sm ${isError ? 'bg-rose-50 text-rose-700' : 'bg-emerald-50 text-emerald-700'}`;
        }

        function showPasswordMessage(text, isError) {
            passwordMessage.textContent = text;
            passwordMessage.className = `mb-5 rounded-lg p-3 text-sm ${isError ? 'bg-rose-50 text-rose-700' : 'bg-emerald-50 text-emerald-700'}`;
        }

        let dashboardPath = '/';

        function redirectAfterProfileUpdate(message) {
            if (currentProfile?.peran === 'mahasiswa') {
                try {
                    sessionStorage.setItem('flash_message', message);
                } catch (error) {
                    console.error('Notifikasi profil gagal disimpan:', error);
                }
            }
            window.location.assign(dashboardPath);
        }

        async function initialize() {
            const { data: { session }, error: sessionError } = await db.auth.getSession();
            if (sessionError) {
                showMessage(`Gagal memeriksa sesi: ${sessionError.message}`, true);
                return;
            }
            if (!session) {
                window.location.replace('/');
                return;
            }

            const { data: profile, error: profileError } = await db
                .from('profiles')
                .select('id, nama, nim, no_telepon, peran, avatar_url')
                .eq('id', session.user.id)
                .single();
            if (profileError) {
                showMessage(`Gagal memuat profil: ${profileError.message}`, true);
                return;
            }
            if (!['mahasiswa', 'pemilik_tenant', 'tenant', 'admin'].includes(profile.peran)) {
                showMessage('Role akun ini tidak diizinkan mengedit profil.', true);
                return;
            }

            currentUser = session.user;
            currentProfile = profile;
            const backLink = document.getElementById('backLink');
            const nameInput = document.getElementById('nama');
            if (profile.peran === 'mahasiswa') {
                dashboardPath = '/mahasiswa/dashboard';
                backLink.href = dashboardPath;
                backLink.textContent = 'Kembali ke Dashboard';
                document.getElementById('studentIdentityHelp').classList.remove('hidden');
                if (session.user.user_metadata?.is_temp_password === true) {
                    document.getElementById('newPassword').focus();
                }
                document.getElementById('newPassword').minLength = 8;
                document.getElementById('newPassword').maxLength = 128;
                document.getElementById('confirmNewPassword').minLength = 8;
                document.getElementById('confirmNewPassword').maxLength = 128;
                document.getElementById('passwordRequirement').textContent = 'Gunakan password baru 8 sampai 128 karakter.';
            } else {
                nameInput.readOnly = false;
                nameInput.classList.remove('cursor-not-allowed', 'border-slate-200', 'bg-slate-100', 'text-slate-600');
                nameInput.classList.add('border-slate-300', 'outline-none', 'focus:border-blue-500', 'focus:ring-2', 'focus:ring-blue-100');
                nameInput.removeAttribute('aria-describedby');
                nameInput.setAttribute('required', '');
                document.getElementById('studentIdentityHelp').classList.add('hidden');
            }
            document.getElementById('nama').value = profile.nama || '';
            document.getElementById('nimEmail').value = profile.nim || session.user.email || '';
            document.getElementById('whatsapp').value = profile.no_telepon || '';
            avatarPreview.src = profile.avatar_url || logoUrl;
            avatarPreview.onerror = () => { avatarPreview.src = logoUrl; };
            if (profile.peran === 'pemilik_tenant' || profile.peran === 'tenant') {
                dashboardPath = '/tenant-dashboard';
                const { data: tenant, error: tenantError } = await db
                    .from('tenants')
                    .select('slug')
                    .eq('pemilik_id', session.user.id)
                    .maybeSingle();
                if (tenantError) {
                    showMessage(`Gagal memuat tautan dashboard tenant: ${tenantError.message}`, true);
                } else if (tenant?.slug) {
                    backLink.href = `/tenant/${encodeURIComponent(tenant.slug)}/dashboard`;
                    backLink.textContent = 'Kembali ke dashboard tenant';
                } else {
                    backLink.href = '/tenant/login';
                    backLink.textContent = 'Kembali ke login tenant';
                }
            } else if (profile.peran === 'admin') {
                dashboardPath = '/admin/dashboard';
                backLink.href = '/admin/dashboard';
                backLink.textContent = 'Kembali ke dashboard admin';
            }
        }

        avatarFile.addEventListener('change', () => {
            const file = avatarFile.files[0];
            selectedAvatar = file || null;
            if (previewObjectUrl) {
                URL.revokeObjectURL(previewObjectUrl);
                previewObjectUrl = null;
            }
            if (!file) {
                avatarPreview.src = currentProfile?.avatar_url || logoUrl;
                return;
            }
            if (!file.type.startsWith('image/') || file.size > 5 * 1024 * 1024) {
                selectedAvatar = null;
                avatarFile.value = '';
                avatarPreview.src = currentProfile?.avatar_url || logoUrl;
                showMessage('Pilih file gambar dengan ukuran maksimal 5 MB.', true);
                return;
            }
            previewObjectUrl = URL.createObjectURL(file);
            avatarPreview.src = previewObjectUrl;
        });

        profileForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!currentUser || !currentProfile) return;

            const nama = document.getElementById('nama').value.trim();
            const noTelepon = document.getElementById('whatsapp').value.trim();
            const isStudent = currentProfile.peran === 'mahasiswa';
            if ((!isStudent && !nama) || !/^628\d{8,13}$/.test(noTelepon)) {
                showMessage(isStudent
                    ? 'Isi nomor WhatsApp dengan format 628 yang valid.'
                    : 'Isi nama dan nomor WhatsApp dengan format 628 yang valid.', true);
                return;
            }

            const saveButton = document.getElementById('saveButton');
            saveButton.disabled = true;
            let avatarUrl = currentProfile.avatar_url || null;
            let uploadedPath;

            if (selectedAvatar) {
                const extension = selectedAvatar.name.split('.').pop().toLowerCase().replace(/[^a-z0-9]/g, '') || 'image';
                uploadedPath = `${currentUser.id}/${Date.now()}.${extension}`;
                const { error: uploadError } = await db.storage
                    .from('avatars')
                    .upload(uploadedPath, selectedAvatar, {
                        cacheControl: '3600',
                        contentType: selectedAvatar.type,
                        upsert: false
                    });
                if (uploadError) {
                    showMessage(`Foto profil gagal diunggah: ${uploadError.message}`, true);
                    saveButton.disabled = false;
                    return;
                }
                const { data: publicUrl } = db.storage.from('avatars').getPublicUrl(uploadedPath);
                avatarUrl = publicUrl.publicUrl;
            }

            const profileUpdates = isStudent
                ? { no_telepon: noTelepon, avatar_url: avatarUrl }
                : { nama, no_telepon: noTelepon, avatar_url: avatarUrl };
            const { error: updateError } = await db
                .from('profiles')
                .update(profileUpdates)
                .eq('id', currentUser.id);
            if (updateError) {
                let cleanupMessage = '';
                if (uploadedPath) {
                    const { error: cleanupError } = await db.storage.from('avatars').remove([uploadedPath]);
                    if (cleanupError) cleanupMessage = ` Foto yang gagal disimpan juga tidak dapat dibersihkan: ${cleanupError.message}`;
                }
                showMessage(`Profil gagal diperbarui: ${updateError.message}.${cleanupMessage}`, true);
                saveButton.disabled = false;
                return;
            }

            currentProfile = {
                ...currentProfile,
                ...(isStudent ? {} : { nama }),
                no_telepon: noTelepon,
                avatar_url: avatarUrl,
            };
            selectedAvatar = null;
            avatarFile.value = '';
            avatarPreview.src = avatarUrl || logoUrl;
            redirectAfterProfileUpdate('Profil berhasil diperbarui');
        });

        passwordForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const newPassword = document.getElementById('newPassword').value;
            const confirmNewPassword = document.getElementById('confirmNewPassword').value;
            const isStudent = currentProfile?.peran === 'mahasiswa';
            const minimumPasswordLength = isStudent ? 8 : 6;
            if (newPassword.length < minimumPasswordLength || (isStudent && newPassword.length > 128)) {
                showPasswordMessage(
                    isStudent
                        ? 'Password baru harus berisi 8 sampai 128 karakter.'
                        : 'Password baru harus minimal 6 karakter.',
                    true
                );
                return;
            }
            if (newPassword !== confirmNewPassword) {
                showPasswordMessage('Konfirmasi password baru tidak cocok.', true);
                return;
            }

            const changePasswordButton = document.getElementById('changePasswordButton');
            changePasswordButton.disabled = true;
            const updatePayload = { password: newPassword };
            if (isStudent) {
                updatePayload.data = {
                    ...currentUser.user_metadata,
                    is_temp_password: false,
                    password_reset_required: false,
                };
            }
            const { data, error } = await db.auth.updateUser(updatePayload);
            if (error) {
                showPasswordMessage(`Password gagal diubah: ${error.message}`, true);
                changePasswordButton.disabled = false;
                return;
            }

            if (isStudent && !data.user) {
                showPasswordMessage('Password berhasil diperbarui, tetapi data sesi tidak tersedia. Login kembali.', true);
                changePasswordButton.disabled = false;
                return;
            }
            if (data.user) currentUser = data.user;
            passwordForm.reset();
            redirectAfterProfileUpdate('Password berhasil diubah');
        });

        initialize();
    </script>
</Layout>
