---
interface Props {
	title: string;
	themeColor?: string;
	bodyClass?: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	noIndex?: boolean;
}

import '../styles/global.css';
import logo from '../assets/logo-uym.png';

const {
	title,
	themeColor = '#172b40',
	bodyClass = '',
	description = 'SiKantin Universitas Yatsi Madani.',
	keywords = 'SiKantin, kantin kampus, Universitas Yatsi Madani, pesan makanan',
	ogImage,
	noIndex = false,
} = Astro.props;

const siteUrl = 'https://sikantin.ndhistira.my.id';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImage = new URL(ogImage || logo.src, siteUrl).href;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content={`SiKantin UYM - ${title}`} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="SiKantin UYM" />
		<meta property="og:locale" content="id_ID" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class={bodyClass} data-logo-url={logo.src}>
		<slot />
	</body>
</html>
