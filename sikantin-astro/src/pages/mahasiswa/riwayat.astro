---
import StudentShell from '../../components/StudentShell.astro';
---

<StudentShell title="Riwayat Pesanan">
	<section class="mb-6">
		<p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-700">Aktivitas akun</p>
		<h1 class="mt-1 text-2xl font-black text-slate-900">Riwayat Pesanan</h1>
		<p class="mt-2 text-sm text-slate-500">Daftar pesanan yang dibuat menggunakan akun mahasiswa ini.</p>
		<div class="mt-3 flex flex-wrap items-center gap-3">
			<p id="orderRealtimeMessage" role="status" aria-live="polite" class="text-sm text-slate-600">Menyiapkan pembaruan status otomatis...</p>
		</div>
	</section>
	<p id="orderHistoryMessage" role="status" aria-live="polite" class="mb-4 hidden rounded-xl p-4 text-sm"></p>
	<div id="studentOrderHistory" class="space-y-4">
		<div class="skeleton-card" role="status" aria-label="Memuat riwayat pesanan"><span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span><span class="skeleton-line w-1/3"></span></div>
	</div>

	<script>
		import { db } from '../../scripts/supabase.js';

		const container = document.getElementById('studentOrderHistory');
		const message = document.getElementById('orderHistoryMessage');
		const realtimeMessage = document.getElementById('orderRealtimeMessage');
		const notificationSound = new Audio('https://zafuozcduvijohjnbycw.supabase.co/storage/v1/object/public/sounds/notif.mp3');
		notificationSound.preload = 'auto';
		const ordersById = new Map();
		const channels = [];
		let statusChangeSoundRequested = false;
		let studentId = '';

		function setRealtimeMessage(text, isError = false) {
			realtimeMessage.textContent = text;
			realtimeMessage.className = `text-sm ${isError ? 'text-rose-700' : 'text-slate-600'}`;
		}

		window.playNotificationSound = function () {
			statusChangeSoundRequested = true;
			notificationSound.volume = 1;
			notificationSound.currentTime = 0;
			notificationSound.play().catch((error) => {
				console.warn('Notification sound could not be played.', error);
			});
		};

		notificationSound.volume = 0;
		notificationSound.play()
			.then(() => {
				if (!statusChangeSoundRequested) {
					notificationSound.pause();
					notificationSound.currentTime = 0;
				}
				notificationSound.volume = 1;
			})
			.catch((error) => {
				notificationSound.volume = 1;
				console.warn('Silent notification audio unlock was blocked.', error);
			});

		function showMessage(text, isError = true) {
			message.textContent = text;
			message.className = `mb-4 rounded-xl p-4 text-sm ${isError ? 'border border-rose-200 bg-rose-50 text-rose-700' : 'border border-emerald-200 bg-emerald-50 text-emerald-700'}`;
		}

		function renderOrder(order) {
			const card = document.createElement('article');
			card.className = 'ui-hover-card ui-enter rounded-2xl border border-slate-200 bg-white p-5 shadow-sm';
			card.dataset.orderId = order.id;
			const header = document.createElement('div');
			header.className = 'flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-4';
			const identity = document.createElement('div');
			const number = document.createElement('h2');
			number.className = 'font-extrabold text-slate-900';
			number.textContent = `Pesanan ${order.nomor_pesanan}`;
			const tenant = document.createElement('p');
			tenant.className = 'mt-1 text-sm text-slate-500';
			tenant.textContent = order.tenants?.nama_tenant || 'Kantin';
			const date = document.createElement('p');
			date.className = 'mt-1 text-xs text-slate-400';
			date.textContent = new Date(order.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' });
			identity.append(number, tenant, date);
			const status = document.createElement('span');
			status.className = 'rounded-full bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-800';
			status.dataset.orderStatus = '';
			status.textContent = order.status || 'Status tidak tersedia';
			header.append(identity, status);

			const items = document.createElement('ul');
			items.className = 'space-y-2 py-4';
			(order.order_items || []).forEach((item) => {
				const row = document.createElement('li');
				row.className = 'flex justify-between gap-3 text-sm';
				const name = document.createElement('span');
				name.className = 'text-slate-600';
				name.textContent = `${item.jumlah} × ${item.nama_menu}`;
				const subtotal = document.createElement('span');
				subtotal.className = 'shrink-0 font-semibold text-slate-800';
				subtotal.textContent = `Rp ${Number(item.subtotal).toLocaleString('id-ID')}`;
				row.append(name, subtotal);
				items.append(row);
			});

			const footer = document.createElement('div');
			footer.className = 'flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4';
			const total = document.createElement('p');
			total.className = 'font-extrabold text-slate-900';
			total.textContent = `Total Rp ${Number(order.total).toLocaleString('id-ID')}`;
			footer.append(total);
			if (order.token_pesanan) {
				const track = document.createElement('a');
				track.href = `/cek-pesanan?token=${encodeURIComponent(order.token_pesanan)}`;
				track.className = 'text-sm font-bold text-blue-700 hover:underline';
				track.textContent = 'Pantau pesanan →';
				footer.append(track);
			}
			card.append(header, items, footer);
			return card;
		}

		function renderOrders(orders) {
			container.replaceChildren();
			ordersById.clear();
			orders.forEach((order) => ordersById.set(order.id, order));
			if (!orders.length) {
				const empty = document.createElement('section');
				empty.className = 'rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center';
				empty.innerHTML = '<p class="font-bold text-slate-800">Belum ada riwayat pesanan</p><p class="mt-2 text-sm text-slate-500">Pesanan yang dibuat saat login akan muncul di halaman ini.</p><a href="/mahasiswa/dashboard" class="mt-4 inline-flex rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white">Pilih kantin</a>';
				container.append(empty);
				return;
			}
			orders.forEach((order) => container.append(renderOrder(order)));
		}

		function applyRealtimeStatus(orderId, nextStatus, updatedAt) {
			const currentOrder = ordersById.get(orderId);
			if (!currentOrder || !nextStatus || currentOrder.status === nextStatus) return;
			const updatedOrder = { ...currentOrder, status: nextStatus, updated_at: updatedAt || currentOrder.updated_at };
			ordersById.set(orderId, updatedOrder);
			const card = [...container.querySelectorAll('[data-order-id]')].find((item) => item.dataset.orderId === orderId);
			const badge = card?.querySelector('[data-order-status]');
			if (badge) badge.textContent = nextStatus;
			window.playNotificationSound?.();
		}

		async function refreshOrderHistory() {
			const { data, error } = await db
				.from('orders')
				.select('id, nomor_pesanan, nomor_antrean, token_pesanan, status, total, created_at, tenants(nama_tenant), order_items(nama_menu, jumlah, subtotal)')
				.eq('mahasiswa_id', studentId)
				.order('created_at', { ascending: false });
			if (error) throw new Error(`Riwayat pesanan gagal dimuat: ${error.message}`);
			renderOrders(data || []);
		}

		function subscribeToOrderBroadcasts(orders) {
			const tokens = [...new Set(orders.map((order) => order.token_pesanan).filter(Boolean))];
			tokens.forEach((token) => {
				const channel = db
					.channel(`guest-order:${token}`, { config: { private: false } })
					.on('broadcast', { event: 'order_status' }, ({ payload }) => {
						if (payload?.token_pesanan !== token) return;
						const order = orders.find((item) => item.token_pesanan === token);
						if (order) applyRealtimeStatus(order.id, payload.status, payload.updated_at);
					})
					.subscribe((status) => {
						if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT' || status === 'CLOSED') {
							setRealtimeMessage(`Koneksi status pesanan terganggu (${status}). Riwayat tetap dapat dimuat ulang.`, true);
						}
					});
				channels.push(channel);
			});
		}

		function subscribeToStudentOrders() {
			const channel = db
				.channel(`student-orders:${studentId}`)
				.on('postgres_changes', {
					event: 'UPDATE',
					schema: 'public',
					table: 'orders',
					filter: `mahasiswa_id=eq.${studentId}`,
				}, ({ new: updatedOrder }) => {
					if (updatedOrder?.mahasiswa_id !== studentId) return;
					if (ordersById.has(updatedOrder.id)) {
						applyRealtimeStatus(updatedOrder.id, updatedOrder.status, updatedOrder.updated_at);
					} else {
						refreshOrderHistory().catch((error) => {
							showMessage(error.message || String(error));
						});
					}
				})
				.on('postgres_changes', {
					event: 'INSERT',
					schema: 'public',
					table: 'orders',
					filter: `mahasiswa_id=eq.${studentId}`,
				}, () => {
					refreshOrderHistory().catch((error) => {
						showMessage(error.message || String(error));
					});
				})
				.subscribe((status) => {
					if (status === 'SUBSCRIBED') {
						setRealtimeMessage('Pembaruan status pesanan otomatis aktif.');
					} else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT' || status === 'CLOSED') {
						setRealtimeMessage(`Koneksi status pesanan terganggu (${status}).`, true);
					}
				});
			channels.push(channel);
		}

		async function initializeOrderHistory() {
			const { data: { session }, error: sessionError } = await db.auth.getSession();
			if (sessionError) throw new Error(`Sesi gagal diperiksa: ${sessionError.message}`);
			if (!session) {
				showMessage('Sesi mahasiswa tidak ditemukan. Silakan login kembali.');
				container.replaceChildren();
				return;
			}
			studentId = session.user.id;
			await refreshOrderHistory();
			const loadedOrders = [...ordersById.values()];
			subscribeToStudentOrders();
			subscribeToOrderBroadcasts(loadedOrders);
		}

		initializeOrderHistory().catch((error) => {
			showMessage(error.message || String(error));
			container.replaceChildren();
		});

		window.addEventListener('pagehide', () => {
			channels.forEach((channel) => {
				db.removeChannel(channel);
			});
		}, { once: true });
	</script>
</StudentShell>
