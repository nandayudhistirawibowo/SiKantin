---
interface Props {
	title: string;
	themeColor?: string;
	bodyClass?: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	noIndex?: boolean;
}

import '../styles/global.css';
import logo from '../assets/logo-uym.png';

const {
	title,
	themeColor = '#172b40',
	bodyClass = '',
	description = 'Temukan tenant, menu, dan informasi pemesanan kantin kampus Universitas Yatsi Madani.',
	keywords = 'SiKantin UYM, kantin kampus, Universitas Yatsi Madani, pesan makanan',
	ogImage,
	noIndex = false,
} = Astro.props;

const pageTitle = title.replace(/\s*[|–—-]\s*SiKantin(?:\s+UYM|\s+Mahasiswa)?$/i, '');
const seoTitle = `SiKantin UYM - ${pageTitle}`;
const metaDescription = description.startsWith('SiKantin UYM')
	? description
	: `SiKantin UYM — ${description}`;
const siteUrl = 'https://sikantin.ndhistira.my.id';
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const socialImage = new URL(ogImage || logo.src, siteUrl).href;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content={metaDescription} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={seoTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content={seoTitle} />
		<meta property="og:image:secure_url" content={socialImage} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="SiKantin UYM" />
		<meta property="og:locale" content="id_ID" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={seoTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:image:alt" content={seoTitle} />
		<script is:inline>
			try {
				const savedTheme = localStorage.getItem('sikantin-theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', savedTheme ? savedTheme === 'dark' : prefersDark);
			} catch (error) {
				console.error('Preferensi tema SiKantin UYM gagal dibaca:', error);
			}
		</script>
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{seoTitle}</title>
	</head>
	<body class={bodyClass} data-logo-url={logo.src}>
		<slot />
		<button
			id="themeToggle"
			type="button"
			aria-label="Aktifkan mode gelap"
			aria-pressed="false"
			class="theme-toggle"
		>
			<svg data-theme-icon="moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
				<path d="M20.9 13A8.5 8.5 0 0 1 11 3.1 8.5 8.5 0 1 0 20.9 13Z" />
			</svg>
			<svg data-theme-icon="sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-5 w-5">
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
			</svg>
		</button>
		<script is:inline>
			const themeToggle = document.getElementById('themeToggle');
			const themeToggleSlot = document.querySelector('[data-theme-toggle-slot]');
			if (themeToggleSlot) themeToggleSlot.append(themeToggle);

			function syncThemeToggle() {
				const isDark = document.documentElement.classList.contains('dark');
				themeToggle.setAttribute('aria-pressed', String(isDark));
				themeToggle.setAttribute('aria-label', isDark ? 'Aktifkan mode terang' : 'Aktifkan mode gelap');
				themeToggle.querySelector('[data-theme-icon="moon"]').classList.toggle('hidden', isDark);
				themeToggle.querySelector('[data-theme-icon="sun"]').classList.toggle('hidden', !isDark);
			}

			syncThemeToggle();
			themeToggle.addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				try {
					localStorage.setItem('sikantin-theme', isDark ? 'dark' : 'light');
				} catch (error) {
					console.error('Preferensi tema SiKantin UYM gagal disimpan:', error);
				}
				syncThemeToggle();
			});

			document.addEventListener('error', (event) => {
				const image = event.target;
				if (!(image instanceof HTMLImageElement) || !image.hasAttribute('data-fallback-on-error')) return;
				image.removeAttribute('data-fallback-on-error');
				image.src = document.body.dataset.logoUrl;
			}, true);
		</script>
	</body>
</html>
