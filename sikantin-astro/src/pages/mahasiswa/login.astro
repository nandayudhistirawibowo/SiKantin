---
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/logo-uym.png';
---

<Layout title="Login Mahasiswa | SiKantin" themeColor="#172b40" bodyClass="flex min-h-screen items-center justify-center bg-slate-950 px-4 py-8 text-white" noIndex>
	<main class="w-full max-w-md rounded-3xl border border-white/10 bg-slate-900 p-6 shadow-2xl sm:p-9">
		<a href="/" class="text-sm font-bold text-blue-200 hover:text-white">← Kembali ke katalog</a>
		<div class="mb-7 mt-8 text-center">
			<img src={logo.src} alt="" class="mx-auto h-16 w-16 rounded-full bg-white p-1" />
			<p class="mt-4 text-xs font-extrabold uppercase tracking-[0.2em] text-sky-300">SiKantin UYM</p>
			<h1 class="mt-2 text-3xl font-black">Login Mahasiswa</h1>
			<p class="mt-2 text-sm text-blue-100/65">Masuk menggunakan NIM dan password akun mahasiswa.</p>
		</div>
		<form id="studentLoginForm" class="space-y-4">
			<label for="studentNim" class="block text-sm font-bold">NIM
				<input id="studentNim" type="text" inputmode="numeric" pattern="[0-9]{6,20}" maxlength="20" autocomplete="username" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 text-white outline-none focus:border-sky-300" />
			</label>
			<label for="studentPassword" class="block text-sm font-bold">Password
				<input id="studentPassword" type="password" autocomplete="current-password" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 text-white outline-none focus:border-sky-300" />
			</label>
			<button id="studentLoginButton" type="submit" class="w-full rounded-xl bg-blue-500 px-4 py-3 font-extrabold text-white transition hover:bg-blue-400 disabled:cursor-wait disabled:opacity-60">Masuk ke Dashboard</button>
		</form>
		<div class="mt-4 text-center">
			<a href="/mahasiswa/set-password-awal" class="text-sm font-bold text-sky-300 underline-offset-4 hover:text-white hover:underline">Atur Password Pertama Kali</a>
			<p class="mt-2 text-xs text-blue-100/55">Lupa password? Hubungi administrator untuk meminta reset.</p>
		</div>
		<p id="studentLoginMessage" role="status" aria-live="polite" class="mt-4 hidden rounded-xl p-3 text-sm"></p>
		<p class="mt-6 text-center text-xs leading-5 text-blue-100/55">Masuk menggunakan NIM dan password. Mahasiswa baru memerlukan kode aktivasi dari administrator untuk membuat password pertama kali.</p>
	</main>

	<script>
		import { db } from '../../scripts/supabase.js';

		const form = document.getElementById('studentLoginForm');
		const button = document.getElementById('studentLoginButton');
		const message = document.getElementById('studentLoginMessage');

		function showMessage(text, isError) {
			message.textContent = text;
			message.className = `mt-4 rounded-xl p-3 text-sm ${isError ? 'bg-rose-950 text-rose-200' : 'bg-emerald-950 text-emerald-200'}`;
		}

		if (new URLSearchParams(window.location.search).get('password_set') === '1') {
			showMessage('Password berhasil dibuat! Silakan login.', false);
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			button.disabled = true;
			try {
				const nim = document.getElementById('studentNim').value.trim();
				const { data, error } = await db.auth.signInWithPassword({
					email: `${nim}@uym.ac.id`,
					password: document.getElementById('studentPassword').value,
				});
				if (error) throw new Error(error.message);

				const { data: profile, error: profileError } = await db
					.from('profiles')
					.select('peran')
					.eq('id', data.user.id)
					.single();
				if (profileError) throw new Error(`Profil gagal dimuat: ${profileError.message}`);
				if (profile.peran !== 'mahasiswa') throw new Error('Akun ini bukan akun mahasiswa.');
				if (data.user.user_metadata?.password_reset_required === true) {
					window.location.assign('/mahasiswa/update-password?required=1');
					return;
				}

				const requestedPath = new URLSearchParams(window.location.search).get('redirect') || '';
				const destination = requestedPath.startsWith('/mahasiswa/')
					&& !requestedPath.startsWith('/mahasiswa/login')
					? requestedPath
					: '/mahasiswa/dashboard';
				window.location.assign(destination);
			} catch (error) {
				const { error: signOutError } = await db.auth.signOut();
				const errorMessage = error instanceof Error ? error.message : String(error);
				const passwordHint = ' Jika belum pernah membuat password, gunakan Kode Aktivasi dari WhatsApp administrator.';
				showMessage(signOutError
					? `${errorMessage} Sesi gagal ditutup: ${signOutError.message}${passwordHint}`
					: `${errorMessage}${passwordHint}`, true);
			} finally {
				button.disabled = false;
			}
		});
	</script>
</Layout>
