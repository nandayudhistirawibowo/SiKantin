---
import StudentShell from '../../components/StudentShell.astro';
---

<StudentShell title="Beranda" profileInSidebar>
	<section class="student-dashboard-hero ui-enter overflow-hidden rounded-3xl bg-gradient-to-br from-blue-800 via-blue-700 to-indigo-800 p-6 text-white shadow-lg sm:p-9">
		<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-200">Portal mahasiswa</p>
		<h1 class="mt-3 text-3xl font-black sm:text-4xl">Halo, <span id="studentGreetingName">Mahasiswa</span>! <span class="student-wave inline-block" aria-hidden="true">👋</span></h1>
		<p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/80">Mau makan apa hari ini? Temukan kantin favoritmu, pesan lebih awal, dan nikmati waktu istirahat tanpa terburu-buru.</p>
		<button id="showStudentTenantDiscovery" type="button" aria-controls="studentTenantDiscovery" aria-expanded="false" class="mt-6 inline-flex rounded-xl bg-white px-5 py-3 text-sm font-extrabold text-blue-800 transition hover:bg-blue-50 dark:border dark:border-blue-300/50 dark:bg-blue-100 dark:text-blue-900 dark:hover:bg-white">Pilih kantin <span class="ml-2" aria-hidden="true">↓</span></button>
	</section>

	<section class="ui-enter ui-hover-card mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="dashboardRecentOrdersHeading">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<p class="text-xs font-extrabold uppercase tracking-wide text-blue-700">Aktivitas</p>
				<h2 id="dashboardRecentOrdersHeading" class="mt-1 text-lg font-black text-slate-900">Riwayat Pesanan Terakhir</h2>
			</div>
			<a href="/mahasiswa/riwayat" class="text-sm font-bold text-blue-700 hover:underline">Lihat semua →</a>
		</div>
		<p id="dashboardOrdersMessage" role="status" aria-live="polite" class="mt-3 hidden text-sm text-slate-500"></p>
		<div id="dashboardRecentOrders" class="mt-3 grid gap-3 md:grid-cols-3">
			<div class="skeleton-card" role="status" aria-label="Memuat pesanan terakhir"><span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span><span class="skeleton-line w-1/3"></span></div>
		</div>
	</section>

	<div id="studentTenantDiscovery" class="hidden mt-8 scroll-mt-24 translate-y-4 opacity-0 transition-all duration-300 ease-out motion-reduce:transition-none" aria-hidden="true" inert>
		<section aria-labelledby="dashboardTenantHeading">
			<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
				<div>
					<p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-700">Jelajahi</p>
					<h2 id="dashboardTenantHeading" tabindex="-1" class="mt-1 text-xl font-black text-slate-900 focus:outline-none">Pilih kantin</h2>
				</div>
			</div>
			<p id="dashboardTenantMessage" role="status" aria-live="polite" class="mb-4 hidden rounded-xl p-4 text-sm"></p>
			<div id="dashboardTenantGrid" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
				<div class="skeleton-card" role="status" aria-label="Memuat daftar kantin"><span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span><span class="skeleton-line w-1/3"></span></div>
			</div>
		</section>
	</div>

	<script>
		import { db } from '../../scripts/supabase.js';

		const grid = document.getElementById('dashboardTenantGrid');
		const message = document.getElementById('dashboardTenantMessage');
		const recentOrdersContainer = document.getElementById('dashboardRecentOrders');
		const ordersMessage = document.getElementById('dashboardOrdersMessage');
		const profileButton = document.getElementById('studentProfileButton');
		const profileMenu = document.getElementById('studentProfileMenu');
		const sidebar = document.getElementById('studentSidebar');
		const tenantDiscovery = document.getElementById('studentTenantDiscovery');
		const showTenantDiscoveryButton = document.getElementById('showStudentTenantDiscovery');
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const favoriteIds = new Set();
		let userId;
		let tenants = [];
		let recentOrders = [];
		let dashboardReady = false;
		let tenantRefreshInProgress = false;
		let dashboardInitialization;

		document.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)) return;
			const link = event.target.closest('a[href]');
			if (!link) return;
			const destination = new URL(link.href, window.location.origin);
			if (destination.origin !== window.location.origin) return;
			if ((destination.pathname === '/' && destination.hash === '#daftar-tenant')
				|| /^\/(?:tenant|mahasiswa\/katalog)\/[^/]+\/?$/.test(destination.pathname)) {
				try {
					sessionStorage.setItem('referrer', '/mahasiswa/dashboard');
				} catch (error) {
					console.warn('Asal pemesanan dari dashboard tidak dapat disimpan:', error);
				}
			}
		});

		profileButton.className = 'flex h-auto w-full min-w-0 items-center gap-3 rounded-lg border border-slate-200 bg-white p-3 text-left text-slate-800 shadow-none transition-colors duration-200 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:border-[#25344a] dark:bg-[#111c2e] dark:text-white dark:hover:bg-[#152238]';
		profileButton.querySelector('#studentName').parentElement.className = 'block min-w-0 flex-1';
		profileButton.querySelector('#studentName').className = 'block max-w-40 truncate text-sm font-extrabold uppercase text-slate-800 dark:text-white';
		profileButton.querySelector('span > span:last-child').textContent = 'Mahasiswa';
		profileButton.querySelector('span > span:last-child').className = 'mt-0.5 block text-[11px] text-slate-500 dark:text-slate-300';
		profileButton.querySelector('svg[aria-hidden="true"]').setAttribute('class', 'ml-auto h-4 w-4 shrink-0 text-slate-500 dark:text-slate-300');
		profileMenu.classList.add('left-0', 'right-0', 'w-full', 'rounded-2xl');

		function revealTenantDiscovery({ scroll = true, focus = false } = {}) {
			if (tenantDiscovery.classList.contains('hidden')) {
				tenantDiscovery.classList.remove('hidden');
				tenantDiscovery.removeAttribute('aria-hidden');
				tenantDiscovery.removeAttribute('inert');
				showTenantDiscoveryButton.setAttribute('aria-expanded', 'true');
			}

			const showAndScroll = () => {
				tenantDiscovery.classList.remove('translate-y-4', 'opacity-0');
				tenantDiscovery.classList.add('translate-y-0', 'opacity-100');
				if (scroll) {
					tenantDiscovery.scrollIntoView({
						behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
						block: 'start',
					});
				}
				if (focus) document.getElementById('dashboardTenantHeading')?.focus({ preventScroll: true });
			};

			if (prefersReducedMotion.matches) {
				showAndScroll();
			} else {
				window.requestAnimationFrame(() => window.requestAnimationFrame(showAndScroll));
			}
		}

		showTenantDiscoveryButton.addEventListener('click', async () => {
			revealTenantDiscovery({ focus: true });
			try {
				await initializeDashboardOnce();
				await refreshTenantDirectory();
			} catch (error) {
				const details = error instanceof Error ? error.message : String(error);
				showError(`Daftar kantin gagal dimuat: ${details}`);
				showTenantGridMessage(`Gagal memuat data tenant: ${details}`, true);
			}
		});
		const catalogNavLink = document.querySelector('[data-student-nav][href*="#dashboardTenantHeading"]');
		catalogNavLink?.addEventListener('click', (event) => {
			if (window.location.pathname !== '/mahasiswa/dashboard') return;
			event.preventDefault();
			history.replaceState(null, '', '/mahasiswa/dashboard#dashboardTenantHeading');
			document.querySelectorAll('[data-student-nav]').forEach((link) => {
				link.classList.remove('bg-blue-50', 'text-blue-800');
				link.removeAttribute('aria-current');
			});
			catalogNavLink.classList.add('bg-blue-50', 'text-blue-800');
			catalogNavLink.setAttribute('aria-current', 'page');
			revealTenantDiscovery({ focus: true });
		});
		if (window.location.hash === '#dashboardTenantHeading') {
			revealTenantDiscovery();
		}

		function showError(text) {
			message.textContent = text;
			message.className = 'mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700';
		}

		function showTenantGridMessage(text, isError = false) {
			const notice = document.createElement('p');
			notice.className = isError
				? 'rounded-2xl border border-rose-200 bg-rose-50 p-5 text-sm text-rose-700 sm:col-span-2 xl:col-span-3'
				: 'rounded-2xl border border-slate-200 bg-white p-5 text-sm text-slate-600 sm:col-span-2 xl:col-span-3';
			notice.setAttribute(isError ? 'role' : 'aria-live', isError ? 'alert' : 'polite');
			notice.textContent = text;
			grid.replaceChildren(notice);
		}

		function makeTenantCard(tenant) {
			const card = document.createElement('article');
			card.className = 'ui-hover-card rounded-2xl border border-slate-200 bg-white p-5 shadow-sm';
			const top = document.createElement('div');
			top.className = 'flex items-start justify-between gap-3';
			const details = document.createElement('div');
			const name = document.createElement('h3');
			name.className = 'font-extrabold text-slate-900';
			name.textContent = tenant.nama_tenant;
			const location = document.createElement('p');
			location.className = 'mt-1 text-sm text-slate-500';
			location.textContent = tenant.lokasi || 'Lokasi belum diisi';
			const status = document.createElement('span');
			const isOpen = tenant.status_buka === true;
			status.className = `tenant-status-badge mt-3 inline-flex rounded-full px-2.5 py-1 text-xs font-bold ${isOpen ? 'tenant-status-open' : 'tenant-status-closed bg-slate-100 text-slate-600'}`;
			status.textContent = isOpen ? 'Sedang buka' : 'Sedang tutup';
			details.append(name, location, status);

			const favoriteButton = document.createElement('button');
			favoriteButton.type = 'button';
			favoriteButton.className = 'shrink-0 rounded-full border border-slate-200 p-2 text-xl leading-none transition hover:bg-rose-50';
			favoriteButton.setAttribute('aria-label', `${favoriteIds.has(tenant.id) ? 'Hapus dari' : 'Tambah ke'} favorit ${tenant.nama_tenant}`);
			favoriteButton.setAttribute('aria-pressed', String(favoriteIds.has(tenant.id)));
			favoriteButton.textContent = favoriteIds.has(tenant.id) ? '♥' : '♡';
			favoriteButton.addEventListener('click', async () => {
				favoriteButton.disabled = true;
				try {
					if (favoriteIds.has(tenant.id)) {
						const { error } = await db.from('favorites').delete().eq('user_id', userId).eq('tenant_id', tenant.id);
						if (error) throw error;
						favoriteIds.delete(tenant.id);
					} else {
						const { error } = await db.from('favorites').insert({ user_id: userId, tenant_id: tenant.id });
						if (error) throw error;
						favoriteIds.add(tenant.id);
					}
					render();
				} catch (error) {
					showError(`Favorit gagal diperbarui: ${error.message || error}`);
					favoriteButton.disabled = false;
				}
			});
			top.append(details, favoriteButton);
			const visit = document.createElement('a');
			visit.href = `/mahasiswa/katalog/${encodeURIComponent(tenant.slug)}`;
			visit.className = 'arrow-action arrow-after mt-5 flex items-center justify-center rounded-xl bg-blue-700 px-4 py-3 text-sm font-extrabold text-white transition hover:bg-blue-800';
			visit.textContent = 'Lihat menu & pesan';
			card.append(top, visit);
			return card;
		}

		function render() {
			renderTenantGrid();
			renderRecentOrders();
		}

		function renderTenantGrid() {
			grid.replaceChildren(...tenants.map(makeTenantCard));
			if (!tenants.length) {
				showTenantGridMessage('Tidak ada tenant yang tersedia saat ini.');
			}
		}

		function renderRecentOrders() {
			recentOrdersContainer.replaceChildren();
			if (!ordersMessage.classList.contains('hidden')) return;
			if (!recentOrders.length) {
				const empty = document.createElement('p');
				empty.className = 'text-sm text-slate-500 md:col-span-3';
				empty.textContent = 'Belum ada pesanan saat login. Pesanan berikutnya akan muncul di sini.';
				recentOrdersContainer.append(empty);
				return;
			}
			recentOrders.forEach((order) => {
				const card = document.createElement('article');
				card.className = 'ui-hover-card ui-enter rounded-xl border border-slate-200 bg-slate-50 p-4';
				const tenant = document.createElement('p');
				tenant.className = 'truncate text-sm font-extrabold text-slate-900';
				tenant.textContent = order.tenants?.nama_tenant || 'Kantin';
				const info = document.createElement('p');
				info.className = 'mt-1 text-xs text-slate-500';
				const orderDate = new Date(order.created_at);
				const dateText = Number.isNaN(orderDate.getTime())
					? 'Tanggal tidak tersedia'
					: orderDate.toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' });
				info.textContent = `Pesanan ${order.nomor_pesanan || order.nomor_antrean || '—'} · ${dateText}`;
				const status = document.createElement('p');
				status.className = 'mt-2 text-sm font-bold text-blue-700';
				status.textContent = order.status || 'Status tidak tersedia';
				const total = document.createElement('p');
				total.className = 'mt-1 text-sm font-extrabold text-slate-800';
				total.textContent = `Rp ${Number(order.total || 0).toLocaleString('id-ID')}`;
				card.append(tenant, info, status, total);
				if (order.token_pesanan) {
					const track = document.createElement('a');
					track.href = `/cek-pesanan?token=${encodeURIComponent(order.token_pesanan)}`;
					track.className = 'mt-3 inline-flex text-sm font-bold text-blue-700 hover:underline';
					track.textContent = 'Lacak pesanan →';
					card.append(track);
				}
				recentOrdersContainer.append(card);
			});
		}

		async function initializeDashboard() {
			const { data: { session }, error: sessionError } = await db.auth.getSession();
			if (sessionError) throw new Error(`Sesi gagal diperiksa: ${sessionError.message}`);
			if (!session) {
				showTenantGridMessage('Sesi mahasiswa tidak ditemukan. Silakan login kembali.', true);
				return;
			}
			userId = session.user.id;

			const { data: tenantRows, error: tenantError } = await db
				.from('tenants')
				.select('id, nama_tenant, slug, lokasi, status_buka')
				.eq('status_buka', true)
				.order('nama_tenant');
			if (tenantError) {
				console.error('Daftar kantin gagal dimuat:', tenantError);
				showTenantGridMessage(`Gagal memuat data tenant: ${tenantError.message}`, true);
				throw new Error(`Daftar kantin gagal dimuat: ${tenantError.message}`);
			}

			tenants = tenantRows || [];
			dashboardReady = true;
			renderTenantGrid();

			const [
				{ data: profile, error: profileError },
				{ data: favorites, error: favoriteError },
				{ data: orderRows, error: ordersError },
			] = await Promise.all([
				db.from('profiles').select('nama, avatar_url').eq('id', userId).single(),
				db.from('favorites').select('tenant_id').eq('user_id', userId),
				db.from('orders')
					.select('id, nomor_pesanan, nomor_antrean, token_pesanan, status, total, created_at, tenants(nama_tenant)')
					.eq('mahasiswa_id', userId)
					.order('created_at', { ascending: false })
					.limit(3),
			]);

			if (profileError) {
				console.error('Profil mahasiswa gagal dimuat:', profileError);
				const shellMessage = document.getElementById('studentShellMessage');
				shellMessage.textContent = `Profil gagal dimuat: ${profileError.message}`;
				shellMessage.classList.remove('hidden');
			} else {
				const studentName = profile.nama?.trim() || 'Mahasiswa';
				document.getElementById('studentGreetingName').textContent = studentName;
				document.getElementById('studentName').textContent = studentName;
				document.getElementById('studentName').title = studentName;
				const avatar = document.getElementById('studentAvatar');
				avatar.src = profile.avatar_url || avatar.dataset.avatarFallback;
			}

			if (favoriteError) {
				console.error('Favorit mahasiswa gagal dimuat:', favoriteError);
				const shellMessage = document.getElementById('studentShellMessage');
				shellMessage.textContent = `Favorit gagal dimuat: ${favoriteError.message}`;
				shellMessage.classList.remove('hidden');
			} else {
				(favorites || []).forEach((favorite) => favoriteIds.add(favorite.tenant_id));
			}
			renderTenantGrid();
			if (ordersError) {
				console.error('Riwayat pesanan gagal dimuat:', ordersError);
				ordersMessage.textContent = `Riwayat pesanan gagal dimuat: ${ordersError.message}`;
				ordersMessage.classList.remove('hidden');
			} else {
				recentOrders = orderRows || [];
			}
			renderRecentOrders();
		}

		async function refreshTenantDirectory() {
			if (!dashboardReady || tenantRefreshInProgress || document.visibilityState !== 'visible') return;
			tenantRefreshInProgress = true;
			try {
				const { data, error } = await db
					.from('tenants')
					.select('id, nama_tenant, slug, lokasi, status_buka')
					.eq('status_buka', true)
					.order('nama_tenant');
				if (error) {
					console.error('Daftar kantin gagal disegarkan:', error);
					showError(`Daftar kantin gagal disegarkan: ${error.message}`);
					return;
				}
				const updatedTenants = data || [];
				if (JSON.stringify(updatedTenants) !== JSON.stringify(tenants)) {
					tenants = updatedTenants;
					render();
				}
			} catch (error) {
				console.error('Daftar kantin gagal disegarkan:', error);
				showError(`Daftar kantin gagal disegarkan: ${error instanceof Error ? error.message : String(error)}`);
			} finally {
				tenantRefreshInProgress = false;
			}
		}

		function initializeDashboardOnce() {
			if (!dashboardInitialization) {
				dashboardInitialization = initializeDashboard().catch((error) => {
					dashboardInitialization = undefined;
					throw error;
				});
			}
			return dashboardInitialization;
		}

		initializeDashboardOnce().catch((error) => {
			console.error('Dashboard mahasiswa gagal dimuat:', error);
			showError(error.message || String(error));
			showTenantGridMessage(`Gagal memuat data tenant: ${error instanceof Error ? error.message : String(error)}`, true);
		});
		document.addEventListener('visibilitychange', refreshTenantDirectory);
		window.addEventListener('pageshow', (event) => {
			if (event.persisted) refreshTenantDirectory();
		});
	</script>

	<style>
		:global(.student-wave) {
			transform-origin: 70% 85%;
			animation: wave 1.8s ease-in-out infinite;
		}

		@media (max-width: 1023px) {
			:global(header) {
				z-index: 60 !important;
			}

			:global(header #studentMenuButton) {
				display: inline-flex !important;
				visibility: visible !important;
				opacity: 1 !important;
				position: relative;
				z-index: 61 !important;
				min-width: 2.75rem;
				min-height: 2.75rem;
			}

			:global(#studentSidebar) {
				position: fixed !important;
				inset: 0 auto 0 0 !important;
				z-index: 50 !important;
				display: flex !important;
				width: min(18rem, calc(100vw - 4rem)) !important;
				height: 100dvh !important;
				transform: translateX(-100%) !important;
				translate: none !important;
			}

			:global(#studentSidebar.hidden) {
				display: none !important;
			}

			:global(#studentSidebar:not(.hidden):not(.student-sidebar-closed)) {
				transform: translateX(0) !important;
			}

			:global(#studentSidebar.student-sidebar-closed) {
				transform: translateX(-100%) !important;
			}

			:global(#studentSidebarBackdrop:not(.hidden)) {
				display: block !important;
				z-index: 20 !important;
			}
		}

		@media (min-width: 1024px) {
			:global(#studentSidebar) {
				display: flex !important;
				position: sticky !important;
				height: 100vh !important;
				transform: none !important;
				translate: none !important;
			}

			:global(#studentSidebar.student-sidebar-collapsed) {
				display: none !important;
			}
		}

		:global(#studentSidebarProfileControl #studentProfileButton) {
			display: flex !important;
		}

		:global(#studentSidebarProfileControl #studentProfileButton > span:first-child) {
			width: 3rem;
			height: 3rem;
			flex: 0 0 3rem;
			overflow: hidden;
			border: 0;
			border-radius: 9999px;
			box-shadow: none;
		}

		:global(#studentSidebarProfileControl #studentProfileButton > span:first-child > img) {
			width: 100%;
			height: 100%;
			border-radius: 9999px;
			border: 2px solid rgb(255 255 255 / 20%);
			object-fit: cover;
		}

		:global(#studentSidebarProfileControl #studentProfileButton > span > span:first-child) {
			display: block;
			min-width: 0;
			max-width: 12rem;
			overflow: hidden;
			font-size: 0.875rem;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		:global(#studentSidebarProfileControl #studentProfileButton > span > span:last-child) {
			margin-top: 0.125rem;
			font-size: 0.75rem;
		}

		:global(#studentSidebarProfileControl #studentProfileButton > svg[aria-hidden="true"]) {
			margin-left: auto;
		}

		:global(#studentSidebarProfileControl #studentProfileMenu) {
			top: calc(100% + 0.5rem);
		}
	</style>
</StudentShell>