---
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/logo-uym.png';
---

<Layout title="Login Mahasiswa | SiKantin" themeColor="#172b40" bodyClass="flex min-h-screen items-center justify-center bg-slate-950 px-4 py-8 text-white" noIndex>
	<main class="w-full max-w-md rounded-3xl border border-white/10 bg-slate-900 p-6 shadow-2xl sm:p-9">
		<a href="/" class="text-sm font-bold text-blue-200 hover:text-white">← Kembali ke katalog</a>
		<div class="mb-7 mt-8 text-center">
			<img src={logo.src} alt="" class="mx-auto h-16 w-16 rounded-full bg-white p-1" />
			<p class="mt-4 text-xs font-extrabold uppercase tracking-[0.2em] text-sky-300">SiKantin UYM</p>
			<h1 class="mt-2 text-3xl font-black">Login Mahasiswa</h1>
			<p class="mt-2 text-sm text-blue-100/65">Masuk menggunakan NIM dan password. Untuk akun baru atau reset admin, password awal sama dengan NIM.</p>
		</div>
		<form id="studentLoginForm" class="space-y-4">
			<label for="studentNim" class="block text-sm font-bold">NIM
				<input id="studentNim" type="text" inputmode="numeric" pattern="[0-9]{6,20}" maxlength="20" autocomplete="username" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 text-white outline-none focus:border-sky-300" />
			</label>
			<div class="block text-sm font-bold">
				<label for="studentPassword">Password</label>
				<div class="relative mt-2">
					<input id="studentPassword" type="password" autocomplete="current-password" required class="w-full rounded-xl border border-white/15 bg-slate-950/60 py-3 pl-4 pr-12 text-white outline-none focus:border-sky-300" />
					<button type="button" data-password-toggle aria-label="Tampilkan password" aria-pressed="false" class="absolute right-2 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-md text-blue-200 hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300">
						<svg data-eye-icon aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"/><circle cx="12" cy="12" r="3"/></svg>
						<svg data-eye-off-icon aria-hidden="true" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.1A10.8 10.8 0 0 1 12 4.8c6 0 9.75 7.2 9.75 7.2a18.8 18.8 0 0 1-2.1 2.9"/><path d="M6.1 6.1C3.6 7.8 2.25 12 2.25 12S6 18.75 12 18.75c1.2 0 2.3-.2 3.3-.6"/></svg>
					</button>
				</div>
			</div>
			<button id="studentLoginButton" type="submit" class="w-full rounded-xl bg-blue-500 px-4 py-3 font-extrabold text-white transition hover:bg-blue-400 disabled:cursor-wait disabled:opacity-60">Masuk ke Dashboard</button>
			<p class="px-2 text-center text-xs leading-relaxed text-blue-100/70">Lupa password? Silakan hubungi Admin untuk reset.</p>
		</form>
		<p id="studentLoginMessage" role="status" aria-live="polite" class="mt-4 hidden rounded-xl p-3 text-sm"></p>
		<p class="student-login-hint mt-6 text-center text-xs leading-5 text-slate-500 dark:text-slate-400">Setelah login dengan password awal, segera ganti password melalui Profil.</p>
	</main>

	<script>
		import { db } from '../../scripts/supabase.js';

		document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
			const input = toggle.parentElement.querySelector('input');
			toggle.addEventListener('click', () => {
				const isVisible = input.type === 'password';
				input.type = isVisible ? 'text' : 'password';
				toggle.querySelector('[data-eye-icon]').classList.toggle('hidden', isVisible);
				toggle.querySelector('[data-eye-off-icon]').classList.toggle('hidden', !isVisible);
				toggle.setAttribute('aria-label', isVisible ? 'Sembunyikan password' : 'Tampilkan password');
				toggle.setAttribute('aria-pressed', String(isVisible));
			});
		});

		const form = document.getElementById('studentLoginForm');
		const button = document.getElementById('studentLoginButton');
		const message = document.getElementById('studentLoginMessage');

		function showMessage(text, isError) {
			message.textContent = text;
			message.className = `mt-4 rounded-xl p-3 text-sm ${isError ? 'bg-rose-950 text-rose-200' : 'bg-emerald-950 text-emerald-200'}`;
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			button.disabled = true;
			try {
				const nim = document.getElementById('studentNim').value.trim();
				const { data, error } = await db.auth.signInWithPassword({
					email: `${nim}@uym.ac.id`,
					password: document.getElementById('studentPassword').value,
				});
				if (error) throw new Error(error.message);

				const { data: profile, error: profileError } = await db
					.from('profiles')
					.select('peran')
					.eq('id', data.user.id)
					.single();
				if (profileError) throw new Error(`Profil gagal dimuat: ${profileError.message}`);
				if (profile.peran !== 'mahasiswa') throw new Error('Akun ini bukan akun mahasiswa.');
				if (data.user.user_metadata?.is_temp_password === true) {
					window.location.assign('/mahasiswa/profil?change_password=1');
					return;
				}
				const requestedPath = new URLSearchParams(window.location.search).get('redirect') || '';
				const destination = requestedPath.startsWith('/mahasiswa/')
					&& !requestedPath.startsWith('/mahasiswa/login')
					? requestedPath
					: '/mahasiswa/dashboard';
				window.location.assign(destination);
			} catch (error) {
				const { error: signOutError } = await db.auth.signOut();
				const errorMessage = error instanceof Error ? error.message : String(error);
				showMessage(signOutError
					? `${errorMessage} Sesi gagal ditutup: ${signOutError.message}`
					: errorMessage, true);
			} finally {
				button.disabled = false;
			}
		});
	</script>
</Layout>
