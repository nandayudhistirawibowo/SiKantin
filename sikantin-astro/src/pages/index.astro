---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-uym.png';
import { supabaseServer } from '../lib/supabase-server.js';
import '../styles/index.css';

function isTenantOpen(value: unknown): boolean {
	if (value === true || value === 1) return true;
	if (typeof value !== 'string') return false;
	return ['true', '1'].includes(value.trim().toLowerCase());
}

const { data: tenantRows, error } = await supabaseServer
	.from('tenants')
	.select('id, nama_tenant, slug, lokasi, status_buka')
	.order('nama_tenant');
const tenants = tenantRows?.map((tenant) => ({
	...tenant,
	status_buka: isTenantOpen(tenant.status_buka),
}));

const { data: tenantMenuPrices, error: menuPriceError } = await supabaseServer
	.from('menu_items')
	.select('tenant_id, harga, foto_url')
	.eq('tersedia', true);

if (menuPriceError) {
	console.error('Gagal memuat harga menu untuk katalog tenant:', menuPriceError.message);
}

const { data: tenantRatings, error: ratingsError } = await supabaseServer
	.rpc('get_public_tenant_ratings', { p_tenant_id: null });

if (ratingsError) {
	console.error('Gagal memuat rating menu tenant:', ratingsError.message);
}

const cheapestPriceByTenant = new Map<string, number>();
const coverImageByTenant = new Map<string, string>();
const tenantRatingTotals = new Map<string, { total: number; count: number }>();
tenantMenuPrices?.forEach(({ tenant_id, harga }) => {
	const price = Number(harga);
	if (!Number.isFinite(price)) return;
	const currentPrice = cheapestPriceByTenant.get(tenant_id);
	if (currentPrice === undefined || price < currentPrice) cheapestPriceByTenant.set(tenant_id, price);
});

tenantMenuPrices?.forEach(({ tenant_id, foto_url }) => {
	if (foto_url && !coverImageByTenant.has(tenant_id)) coverImageByTenant.set(tenant_id, foto_url);
});

tenantRatings?.forEach((rating) => {
	const tenantId = rating.tenant_id;
	const count = Number(rating.review_count) || 0;
	if (!tenantId || count <= 0) return;
	tenantRatingTotals.set(tenantId, {
		total: Number(rating.rating_total) || 0,
		count,
	});
});
---

<Layout
	title="Pesan Makanan di Kantin Kampus | SiKantin UYM"
	description="Jelajahi kantin Universitas Yatsi Madani, lihat menu dan rating, lalu pesan makanan dengan mudah melalui SiKantin."
	keywords="SiKantin, kantin UYM, kantin Universitas Yatsi Madani, pesan makanan kampus, menu kantin"
	themeColor="#172b40"
	bodyClass="role-screen min-h-screen px-4 py-6 text-slate-100 sm:px-6"
>
	<main class="mx-auto max-w-6xl">
		<header class="glass flex items-center justify-between rounded-3xl px-4 py-3 sm:px-6">
			<a href="/" class="flex items-center gap-3" aria-label="SiKantin Universitas Yatsi Madani">
				<img src={logo.src} alt="" class="h-11 w-11 rounded-full bg-white p-1" />
				<span>
					<span class="block text-lg font-extrabold tracking-wide">SIKANTIN</span>
					<span class="block text-xs text-blue-100/75">Universitas Yatsi Madani</span>
				</span>
			</a>
			<nav class="flex flex-wrap items-center justify-end gap-2 text-sm font-bold">
				<button id="tenantMenuButton" type="button" aria-controls="tenantSidebar" aria-expanded="false" aria-label="Buka menu kantin" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 transition hover:bg-white/10 lg:hidden">
					<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
					<span>Menu kantin</span>
				</button>
				<a href="/mahasiswa/login" class="rounded-full bg-emerald-400 px-4 py-2 text-emerald-950 transition hover:bg-emerald-300">Login Mahasiswa</a>
				<a href="/cek-pesanan" class="rounded-full border border-white/15 bg-white/5 px-4 py-2 hover:bg-white/10">Cek Pesanan</a>
				<a href="/tenant/login" class="rounded-full border border-white/15 bg-white/5 px-4 py-2 hover:bg-white/10">Login Tenant</a>
			</nav>
		</header>

		<section class="catalog-hero relative mt-7 overflow-hidden rounded-[2rem] border border-white/10 px-6 py-10 shadow-2xl sm:px-10 sm:py-14">
			<div class="relative z-10 max-w-2xl">
				<p class="mb-3 text-xs font-extrabold uppercase tracking-[0.28em] text-amber-300">Universitas Yatsi Madani</p>
				<h1 class="text-4xl font-black tracking-tight sm:text-6xl">Lapar? Kantin favoritmu <span class="text-sky-300">dekat.</span></h1>
				<p class="mt-4 max-w-xl text-base leading-7 text-blue-100/75 sm:text-lg">Temukan pilihan makan dan minum di kampus. Pesan tanpa login, lalu pantau pesanan dengan token.</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<a href="#daftar-tenant" class="rounded-xl bg-blue-500 px-5 py-3 text-sm font-extrabold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-400">Jelajahi kantin <span aria-hidden="true">↓</span></a>
					<a href="/cek-pesanan" class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-bold text-white transition hover:bg-white/10">Cek pesanan</a>
				</div>
			</div>
			<div class="hero-decoration" aria-hidden="true"><span>🍜</span><span>🥤</span><span>🍱</span></div>
		</section>

		<section class="catalog-promo mt-6 overflow-hidden rounded-3xl border border-white/10 px-5 py-6 shadow-xl sm:px-9 sm:py-9" aria-labelledby="catalog-promo-heading">
			<div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
				<div class="max-w-2xl">
					<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-amber-200">Praktis untuk hari sibuk</p>
					<h2 id="catalog-promo-heading" class="mt-2 text-2xl font-black sm:text-3xl">Pesan dulu, nikmati waktu istirahatmu.</h2>
					<p class="mt-2 text-sm leading-6 text-blue-100/70">Pilih menu favorit tanpa perlu login, lalu gunakan token untuk memantau status pesanan.</p>
				</div>
				<a href="/cek-pesanan" class="inline-flex w-full shrink-0 items-center justify-center rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-extrabold transition hover:bg-white/15 sm:w-auto">
					Cek status pesanan <span class="ml-2" aria-hidden="true">→</span>
				</a>
			</div>
		</section>

		<div class="mt-10 grid items-start gap-6 lg:grid-cols-[250px_minmax(0,1fr)]">
			<button id="tenantSidebarBackdrop" type="button" aria-label="Tutup menu kantin" class="fixed inset-0 z-40 hidden bg-slate-950/70 backdrop-blur-sm lg:hidden"></button>
			<aside id="tenantSidebar" class="tenant-sidebar glass fixed inset-y-4 left-4 z-50 hidden w-[min(20rem,calc(100vw-2rem))] -translate-x-full overflow-y-auto rounded-3xl p-5 transition-transform duration-300 ease-out lg:sticky lg:top-5 lg:block lg:w-auto lg:translate-x-0 lg:overflow-visible" aria-label="Navigasi kantin">
				<div class="flex items-start justify-between gap-3">
					<div>
						<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-200">Jelajahi</p>
						<h2 class="mt-1 text-xl font-black">Cari kantin</h2>
					</div>
					<button id="tenantSidebarClose" type="button" aria-label="Tutup menu kantin" class="rounded-lg border border-white/15 p-2 text-blue-100 transition hover:bg-white/10 lg:hidden">
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" /></svg>
					</button>
				</div>
				<nav class="mt-5 grid grid-cols-2 gap-2 lg:grid-cols-1" aria-label="Filter tenant">
					<button type="button" data-tenant-filter="all" aria-pressed="true" class="tenant-filter is-active rounded-xl px-3 py-2.5 text-left text-sm font-bold transition">Semua kantin <span class="float-right text-xs opacity-70">{tenants?.length ?? 0}</span></button>
					<button type="button" data-tenant-filter="open" aria-pressed="false" class="tenant-filter rounded-xl px-3 py-2.5 text-left text-sm font-bold transition">Sedang buka <span id="openTenantCount" class="float-right text-xs opacity-70">{tenants?.filter((tenant) => tenant.status_buka).length ?? 0}</span></button>
					<button type="button" data-tenant-filter="cheapest" aria-pressed="false" class="tenant-filter rounded-xl px-3 py-2.5 text-left text-sm font-bold transition">Termurah <span class="float-right text-xs opacity-70">↓</span></button>
				</nav>
				<div class="mt-6 border-t border-white/10 pt-5">
					<p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-200/75">Daftar tenant</p>
					{tenants?.length ? (
						<ul class="mt-3 space-y-1">
							{tenants.map((tenant) => (
								<li>
									<a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm text-blue-50/80 transition hover:bg-white/10 hover:text-white">
										<span class="truncate">{tenant.nama_tenant}</span>
										<span data-tenant-status-indicator={tenant.id} class:list={['h-2 w-2 shrink-0 rounded-full', tenant.status_buka ? 'bg-emerald-300' : 'bg-slate-400']} aria-label={tenant.status_buka ? 'Buka' : 'Tutup'}></span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="mt-3 text-sm text-blue-100/55">Tenant akan tampil di sini.</p>
					)}
				</div>
				<div class="mt-6 rounded-2xl border border-sky-200/10 bg-sky-300/5 p-4">
					<p class="text-sm font-extrabold text-sky-100">Pesan praktis</p>
					<p class="mt-1 text-xs leading-5 text-blue-100/60">Pilih kantin, tambahkan menu ke pesanan, dan ambil saat siap.</p>
				</div>
			</aside>

			<section id="daftar-tenant" aria-labelledby="tenant-list-heading">
				<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-200">Menu kampus</p>
						<h2 id="tenant-list-heading" class="mt-1 text-2xl font-extrabold">Kantin di sekitar kamu</h2>
					</div>
					<p class="text-sm text-blue-100/70"><span id="tenantCount">{tenants?.length ?? 0}</span> tenant</p>
				</div>
				<p id="tenantRealtimeStatus" class="mb-4 text-xs text-blue-100/60" role="status" aria-live="polite">Menghubungkan status kantin realtime...</p>
				{error ? (
					<p role="alert" class="rounded-xl border border-rose-300/30 bg-rose-950/30 p-4 text-sm text-rose-100">
						Daftar tenant gagal dimuat. Coba muat ulang halaman.
					</p>
				) : tenants?.length ? (
					<>
						<div id="tenantCardGrid" class="grid gap-4 sm:grid-cols-2">
							{tenants.map((tenant, index) => (
								<article
									data-tenant-card
									data-tenant-id={tenant.id}
									data-tenant-open={tenant.status_buka ? 'true' : 'false'}
									data-cheapest-price={cheapestPriceByTenant.has(tenant.id) ? String(cheapestPriceByTenant.get(tenant.id)) : ''}
									data-original-order={index}
									class="tenant-card glass flex min-h-80 flex-col overflow-hidden rounded-3xl shadow-xl transition duration-200 hover:-translate-y-1 hover:border-sky-200/30 hover:shadow-2xl"
								>
									<a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="tenant-card-cover group relative block h-44 overflow-hidden" aria-label={`Lihat menu ${tenant.nama_tenant}`}>
										{coverImageByTenant.get(tenant.id) ? (
											<img src={coverImageByTenant.get(tenant.id)} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
										) : (
											<>
												<span class="tenant-card-cover-art" aria-hidden="true"></span>
												<span class="tenant-card-cover-emoji" aria-hidden="true">{index % 3 === 0 ? '🍱' : index % 3 === 1 ? '🥤' : '🍜'}</span>
											</>
										)}
										<span data-tenant-status-badge={tenant.id} class:list={['absolute right-3 top-3 rounded-full px-3 py-1.5 text-xs font-extrabold shadow-sm', tenant.status_buka ? 'bg-emerald-300 text-emerald-950' : 'bg-white/90 text-slate-700']}>
											<span data-tenant-status-dot class:list={['mr-1 inline-block h-1.5 w-1.5 rounded-full align-middle', tenant.status_buka ? 'bg-emerald-700' : 'bg-slate-400']}></span>
											<span data-tenant-status-label>{tenant.status_buka ? 'Buka sekarang' : 'Sedang tutup'}</span>
										</span>
										<span class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-slate-950/60 to-transparent" aria-hidden="true"></span>
									</a>
									<div class="flex flex-1 flex-col p-5">
										<div class="flex items-start justify-between gap-3">
											<div>
												<h3 class="text-xl font-extrabold tracking-tight">{tenant.nama_tenant}</h3>
												<p class="mt-1 text-sm text-blue-100/70">{tenant.lokasi || 'Lokasi belum diisi'}</p>
											</div>
										</div>
										<div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold text-blue-100/80">
											{(() => {
												const rating = tenantRatingTotals.get(tenant.id);
												if (ratingsError) {
													return <span class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-[11px] font-semibold text-blue-100/70">Rating gagal dimuat</span>;
												}
												return rating ? (
													<span class="inline-flex items-center gap-1.5 rounded-full border border-yellow-200 bg-yellow-400 px-2.5 py-1 font-extrabold text-yellow-950 shadow-sm" aria-label={`Rating ${(rating.total / rating.count).toFixed(1)} dari 5`}>
														<span aria-hidden="true">★</span> {(rating.total / rating.count).toFixed(1)}
													</span>
												) : (
													<span class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-[11px] font-semibold text-blue-100/70">Belum ada rating</span>
												);
											})()}
											{cheapestPriceByTenant.has(tenant.id) && <span class="whitespace-nowrap text-emerald-300">Mulai Rp {cheapestPriceByTenant.get(tenant.id).toLocaleString('id-ID')}</span>}
										</div>
										<a href={`/tenant/${encodeURIComponent(tenant.slug)}`} class="mt-5 inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-400 px-4 py-3 text-sm font-extrabold text-emerald-950 shadow-lg shadow-emerald-950/20 transition hover:bg-emerald-300">
											Pesan Sekarang <span aria-hidden="true">→</span>
										</a>
									</div>
								</article>
							))}
						</div>
						<p id="tenantEmptyFilter" class="mt-4 hidden rounded-xl border border-white/10 bg-white/5 p-5 text-sm text-blue-100/75">Tidak ada tenant yang sedang buka saat ini.</p>
					</>
				) : (
					<div class="empty-tenant rounded-3xl border border-white/10 p-8 text-center">
						<span class="text-5xl" aria-hidden="true">🍽️</span>
						<h3 class="mt-4 text-xl font-extrabold">Kantin sedang bersiap</h3>
						<p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-blue-100/65">Daftar tenant akan muncul di sini saat kantin sudah bergabung. Silakan kembali lagi nanti.</p>
					</div>
				)}
			</section>
		</div>

		<footer class="py-8 text-center text-xs text-blue-100/50">
			<p>SiKantin UYM · Pesan dulu, ambil tanpa antre.</p>
		</footer>
	</main>
	<script>
		import { db } from '../scripts/supabase.js';

		const tenantFilterButtons = document.querySelectorAll('[data-tenant-filter]');
		const tenantCards = document.querySelectorAll('[data-tenant-card]');
		const tenantCardGrid = document.getElementById('tenantCardGrid');
		const tenantCount = document.getElementById('tenantCount');
		const openTenantCount = document.getElementById('openTenantCount');
		const tenantMenuButton = document.getElementById('tenantMenuButton');
		const tenantSidebar = document.getElementById('tenantSidebar');
		const tenantSidebarBackdrop = document.getElementById('tenantSidebarBackdrop');
		const tenantSidebarClose = document.getElementById('tenantSidebarClose');
		const tenantEmptyFilter = document.getElementById('tenantEmptyFilter');
		const tenantRealtimeStatus = document.getElementById('tenantRealtimeStatus');
		let activeTenantFilter = 'all';
		let tenantStatusChannel;
		const tenantStatusRevisions = new Map();

		function closeTenantDrawer(restoreFocus = false) {
			const wasOpen = tenantMenuButton.getAttribute('aria-expanded') === 'true';
			tenantMenuButton.setAttribute('aria-expanded', 'false');
			tenantSidebarBackdrop.classList.add('hidden');
			document.body.classList.remove('overflow-hidden');
			if (wasOpen && window.matchMedia('(max-width: 1023px)').matches) {
				tenantSidebar.classList.add('-translate-x-full');
			} else {
				tenantSidebar.classList.add('hidden', '-translate-x-full');
			}
			if (restoreFocus && wasOpen) tenantMenuButton.focus();
		}

		tenantSidebar.addEventListener('transitionend', (event) => {
			if (
				event.target === tenantSidebar
				&& event.propertyName === 'transform'
				&& tenantMenuButton.getAttribute('aria-expanded') === 'false'
			) {
				tenantSidebar.classList.add('hidden');
			}
		});
		tenantMenuButton.addEventListener('click', () => {
			tenantSidebar.classList.remove('hidden');
			tenantSidebarBackdrop.classList.remove('hidden');
			tenantMenuButton.setAttribute('aria-expanded', 'true');
			document.body.classList.add('overflow-hidden');
			requestAnimationFrame(() => {
				if (tenantMenuButton.getAttribute('aria-expanded') === 'true') {
					tenantSidebar.classList.remove('-translate-x-full');
				}
			});
			tenantSidebarClose.focus();
		});
		tenantSidebarClose.addEventListener('click', () => closeTenantDrawer(true));
		tenantSidebarBackdrop.addEventListener('click', () => closeTenantDrawer(true));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeTenantDrawer(true);
		});
		window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
			if (event.matches) closeTenantDrawer();
		});

		function parseTenantOpenStatus(value) {
			if (value === true || value === 1) return true;
			if (value === false || value === 0) return false;
			if (typeof value === 'string') {
				const normalized = value.trim().toLowerCase();
				if (normalized === 'true' || normalized === '1') return true;
				if (normalized === 'false' || normalized === '0') return false;
			}
			return null;
		}

		function refreshTenantCards() {
			if (tenantCardGrid) {
				const sortedCards = [...tenantCards].sort((a, b) => {
					if (activeTenantFilter !== 'cheapest') {
						return Number(a.dataset.originalOrder) - Number(b.dataset.originalOrder);
					}
					const priceA = a.dataset.cheapestPrice === '' ? Number.POSITIVE_INFINITY : Number(a.dataset.cheapestPrice);
					const priceB = b.dataset.cheapestPrice === '' ? Number.POSITIVE_INFINITY : Number(b.dataset.cheapestPrice);
					return priceA - priceB;
				});
				sortedCards.forEach((card) => tenantCardGrid.append(card));
			}

			let visibleCount = 0;
			let openCount = 0;
			tenantCards.forEach((card) => {
				const isOpen = card.dataset.tenantOpen === 'true';
				const visible = activeTenantFilter !== 'open' || isOpen;
				card.classList.toggle('hidden', !visible);
				if (visible) visibleCount += 1;
				if (isOpen) openCount += 1;
			});
			if (tenantCount) tenantCount.textContent = String(visibleCount);
			if (openTenantCount) openTenantCount.textContent = String(openCount);
			if (tenantEmptyFilter) tenantEmptyFilter.classList.toggle('hidden', visibleCount > 0);
		}

		function applyTenantStatus(tenantId, statusValue) {
			const isOpen = parseTenantOpenStatus(statusValue);
			if (isOpen === null) return;

			const card = [...tenantCards].find((item) => item.dataset.tenantId === tenantId);
			if (card) {
				card.dataset.tenantOpen = String(isOpen);
				const badge = card.querySelector('[data-tenant-status-badge]');
				const dot = badge?.querySelector('[data-tenant-status-dot]');
				const label = badge?.querySelector('[data-tenant-status-label]');
				badge?.classList.toggle('bg-emerald-300', isOpen);
				badge?.classList.toggle('text-emerald-950', isOpen);
				badge?.classList.toggle('bg-white/90', !isOpen);
				badge?.classList.toggle('text-slate-700', !isOpen);
				dot?.classList.toggle('bg-emerald-700', isOpen);
				dot?.classList.toggle('bg-slate-400', !isOpen);
				if (label) label.textContent = isOpen ? 'Buka sekarang' : 'Sedang tutup';
			}

			const indicator = document.querySelector(`[data-tenant-status-indicator="${CSS.escape(tenantId)}"]`);
			indicator?.classList.toggle('bg-emerald-300', isOpen);
			indicator?.classList.toggle('bg-slate-400', !isOpen);
			indicator?.setAttribute('aria-label', isOpen ? 'Buka' : 'Tutup');
			refreshTenantCards();
		}

		tenantFilterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				activeTenantFilter = button.dataset.tenantFilter;
				refreshTenantCards();
				tenantFilterButtons.forEach((filterButton) => {
					const active = filterButton === button;
					filterButton.classList.toggle('is-active', active);
					filterButton.setAttribute('aria-pressed', String(active));
				});
				closeTenantDrawer(true);
			});
		});

		const tenantIds = [...tenantCards].map((card) => card.dataset.tenantId).filter(Boolean);
		if (tenantIds.length) {
			tenantStatusChannel = db
				.channel('tenant-directory-status')
				.on('postgres_changes', {
					event: 'UPDATE',
					schema: 'public',
					table: 'tenants',
				}, ({ new: tenant }) => {
					if (tenant?.id && Object.prototype.hasOwnProperty.call(tenant, 'status_buka')) {
						tenantStatusRevisions.set(tenant.id, (tenantStatusRevisions.get(tenant.id) || 0) + 1);
						applyTenantStatus(tenant.id, tenant.status_buka);
					}
				})
				.subscribe((status, error) => {
					tenantRealtimeStatus.textContent = status === 'SUBSCRIBED'
						? 'Status kantin diperbarui realtime.'
						: error
							? `Realtime status kantin gagal: ${error.message}`
							: `Realtime status kantin: ${status}`;
					if (status !== 'SUBSCRIBED') console.error('Realtime status tenant:', status, error);
					if (status === 'SUBSCRIBED') {
						const revisionsAtRequest = new Map(tenantStatusRevisions);
						db.from('tenants')
							.select('id, status_buka')
							.in('id', tenantIds)
							.then(({ data, error: snapshotError }) => {
								if (snapshotError) {
									tenantRealtimeStatus.textContent = `Gagal menyegarkan status kantin: ${snapshotError.message}`;
									console.error('Gagal menyegarkan status tenant:', snapshotError);
									return;
								}
								data?.forEach((tenant) => {
									if ((revisionsAtRequest.get(tenant.id) || 0) === (tenantStatusRevisions.get(tenant.id) || 0)) {
										applyTenantStatus(tenant.id, tenant.status_buka);
									}
								});
							});
					}
				});
		} else if (tenantRealtimeStatus) {
			tenantRealtimeStatus.textContent = 'Belum ada tenant untuk dipantau.';
		}

		window.addEventListener('pagehide', () => {
			if (tenantStatusChannel) db.removeChannel(tenantStatusChannel);
		}, { once: true });
	</script>
</Layout>
