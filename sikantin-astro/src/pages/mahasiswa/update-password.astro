---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Buat Password Mahasiswa | SiKantin" description="Buat password baru untuk akun mahasiswa SiKantin." themeColor="#172b40" bodyClass="flex min-h-screen items-center justify-center bg-slate-950 px-4 py-8 text-white" noIndex>
	<main class="w-full max-w-md rounded-3xl border border-white/10 bg-slate-900 p-6 shadow-2xl sm:p-9">
		<a href="/mahasiswa/login" class="text-sm font-bold text-blue-200 hover:text-white">← Kembali ke login</a>
		<div class="mb-7 mt-8">
			<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-sky-300">Keamanan akun</p>
			<h1 class="mt-2 text-3xl font-black">Buat password baru</h1>
			<p id="passwordSetupIntro" class="mt-2 text-sm leading-6 text-blue-100/65">Gunakan password yang kuat dan tidak dipakai di akun lain.</p>
		</div>
		<form id="studentPasswordForm" class="hidden space-y-4">
			<label for="newStudentPassword" class="block text-sm font-bold">Password baru
				<input id="newStudentPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 text-white outline-none focus:border-sky-300" />
			</label>
			<label for="confirmStudentPassword" class="block text-sm font-bold">Ulangi password baru
				<input id="confirmStudentPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 text-white outline-none focus:border-sky-300" />
			</label>
			<button id="studentPasswordButton" type="submit" class="w-full rounded-xl bg-blue-500 px-4 py-3 font-extrabold text-white transition hover:bg-blue-400 disabled:cursor-wait disabled:opacity-60">Simpan password</button>
		</form>
		<p id="studentPasswordMessage" role="status" aria-live="polite" class="mt-4 hidden rounded-xl p-3 text-sm"></p>
		<a id="passwordRecoveryLink" href="/mahasiswa/lupa-password" class="mt-4 hidden text-sm font-bold text-sky-300 underline-offset-4 hover:text-white hover:underline">Minta tautan pengaturan password baru</a>
	</main>

	<script>
		import { db } from '../../scripts/supabase.js';

		const form = document.getElementById('studentPasswordForm');
		const button = document.getElementById('studentPasswordButton');
		const message = document.getElementById('studentPasswordMessage');
		const recoveryLink = document.getElementById('passwordRecoveryLink');
		const intro = document.getElementById('passwordSetupIntro');
		let userMetadata = {};

		function showMessage(text, isError) {
			message.textContent = text;
			message.className = `mt-4 rounded-xl p-3 text-sm ${isError ? 'bg-rose-950 text-rose-200' : 'bg-emerald-950 text-emerald-200'}`;
		}

		async function initializePasswordSetup() {
			const { data: { session }, error } = await db.auth.getSession();
			if (error) throw new Error(`Sesi pengaturan password gagal diperiksa: ${error.message}`);
			if (!session) {
				intro.textContent = 'Tautan tidak valid atau sudah kedaluwarsa. Minta tautan pengaturan password baru.';
				recoveryLink.classList.remove('hidden');
				return;
			}
			const { data: profile, error: profileError } = await db
				.from('profiles')
				.select('peran')
				.eq('id', session.user.id)
				.single();
			if (profileError) throw new Error(`Profil gagal dimuat: ${profileError.message}`);
			if (profile.peran !== 'mahasiswa') throw new Error('Halaman ini hanya untuk akun mahasiswa.');
			userMetadata = session.user.user_metadata || {};
			if (new URLSearchParams(window.location.search).get('required') === '1') {
				intro.textContent = 'Password sementara harus diganti sebelum menggunakan dashboard.';
			}
			form.classList.remove('hidden');
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			button.disabled = true;
			try {
				const password = document.getElementById('newStudentPassword').value;
				const confirmation = document.getElementById('confirmStudentPassword').value;
				if (password.length < 8 || password.length > 128) {
					throw new Error('Password harus berisi 8 sampai 128 karakter.');
				}
				if (password !== confirmation) throw new Error('Konfirmasi password tidak sama.');
				const { data, error } = await db.auth.updateUser({
					password,
					data: {
						...userMetadata,
						password_reset_required: false,
					},
				});
				if (error) throw new Error(`Password gagal diperbarui: ${error.message}`);
				if (!data.user) throw new Error('Password diperbarui tetapi sesi akun tidak tersedia. Silakan login kembali.');
				showMessage('Password berhasil diperbarui. Kamu akan diarahkan ke dashboard.', false);
				window.setTimeout(() => window.location.assign('/mahasiswa/dashboard'), 900);
			} catch (error) {
				showMessage(error instanceof Error ? error.message : String(error), true);
			} finally {
				button.disabled = false;
			}
		});

		initializePasswordSetup().catch((error) => {
			showMessage(error instanceof Error ? error.message : String(error), true);
			recoveryLink.classList.remove('hidden');
		});
	</script>
</Layout>
