PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-service-role-key
PORT=3000
WA_HOST=127.0.0.1
WA_PORT=3000
# Use the same random secret as the WA_API_KEY Supabase Edge Function secret.
WA_API_KEY=replace-with-a-random-secret-at-least-32-characters
# After starting ngrok, set its HTTPS forwarding URL as the Supabase Edge Function secret:
# supabase secrets set WA_GATEWAY_URL=https://your-ngrok-domain.ngrok-free.app
# Optional. Defaults to the existing auth_info_baileys directory beside sikantin-astro.
# WA_AUTH_DIR=C:\path\to\auth_info_baileys
