---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Atur Ulang Password Mahasiswa | SiKantin" description="Kirim tautan aman untuk mengatur atau memulihkan password akun mahasiswa SiKantin." themeColor="#172b40" bodyClass="flex min-h-screen items-center justify-center bg-slate-950 px-4 py-8 text-white" noIndex>
	<main class="w-full max-w-md rounded-3xl border border-white/10 bg-slate-900 p-6 shadow-2xl sm:p-9">
		<a href="/mahasiswa/login" class="text-sm font-bold text-blue-200 hover:text-white">← Kembali ke login</a>
		<div class="mb-7 mt-8">
			<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-sky-300">Pemulihan akun</p>
			<h1 class="mt-2 text-3xl font-black">Atur ulang password</h1>
			<p class="mt-2 text-sm leading-6 text-blue-100/65">Masukkan NIM. Jika akun terdaftar, tautan pengaturan password akan dikirim ke alamat NIM kamu.</p>
		</div>
		<form id="studentRecoveryForm" class="space-y-4">
			<label for="studentNim" class="block text-sm font-bold">NIM
				<input id="studentNim" type="text" inputmode="numeric" pattern="[0-9]{6,20}" maxlength="20" autocomplete="username" required class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/60 px-4 py-3 text-white outline-none focus:border-sky-300" />
			</label>
			<button id="studentRecoveryButton" type="submit" class="w-full rounded-xl bg-blue-500 px-4 py-3 font-extrabold text-white transition hover:bg-blue-400 disabled:cursor-wait disabled:opacity-60">Kirim tautan</button>
		</form>
		<p id="studentRecoveryMessage" role="status" aria-live="polite" class="mt-4 hidden rounded-xl p-3 text-sm"></p>
	</main>

	<script>
		import { db } from '../../scripts/supabase.js';

		const form = document.getElementById('studentRecoveryForm');
		const button = document.getElementById('studentRecoveryButton');
		const message = document.getElementById('studentRecoveryMessage');

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			button.disabled = true;
			message.className = 'mt-4 rounded-xl p-3 text-sm';
			message.textContent = '';
			try {
				const nim = document.getElementById('studentNim').value.trim();
				if (!/^\d{6,20}$/.test(nim)) throw new Error('NIM harus berisi 6 sampai 20 digit.');
				const redirectTo = new URL('/mahasiswa/update-password', window.location.origin).href;
				const { error } = await db.auth.resetPasswordForEmail(`${nim}@uym.ac.id`, { redirectTo });
				if (error) throw new Error(`Tautan gagal dikirim: ${error.message}`);
				message.textContent = 'Jika NIM terdaftar, tautan pengaturan password akan dikirim ke alamat NIM. Periksa kotak masuk dan folder spam.';
				message.classList.add('bg-emerald-950', 'text-emerald-200');
			} catch (error) {
				message.textContent = error instanceof Error ? error.message : String(error);
				message.classList.add('bg-rose-950', 'text-rose-200');
			} finally {
				button.disabled = false;
			}
		});
	</script>
</Layout>
