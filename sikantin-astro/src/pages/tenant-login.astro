---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo-uym.png';
import '../styles/tenant-login.css';
---

<Layout title="Login Pemilik Tenant" themeColor="#172b40" bodyClass="login-screen flex min-h-screen items-center justify-center px-4 py-8 text-slate-100" noIndex>

<main class="w-full max-w-md rounded-[1.75rem] border border-white/15 bg-slate-900/50 p-6 shadow-2xl backdrop-blur-xl sm:p-10">
        <a href="/" class="arrow-action arrow-left mb-8 inline-flex items-center gap-2 text-sm font-semibold text-blue-100/75 hover:text-white"><span class="arrow-icon" aria-hidden="true">←</span>Kembali ke katalog</a>
        <div class="mb-7 text-center">
            <Image src={logo} alt="Logo Universitas Yatsi Madani" width={64} height={64} format="webp" loading="eager" class="mx-auto mb-4 h-16 w-16 rounded-full border border-slate-200 bg-white object-cover shadow dark:border-slate-700" />
            <p class="uym-brand-text text-xs font-bold uppercase tracking-[0.2em]">SiKantin UYM</p>
            <h1 class="mt-2 text-3xl font-extrabold">Login Pemilik Tenant</h1>
        </div>
        <form id="loginForm" class="space-y-5">
            <label class="block text-sm font-semibold" for="email">Email akun
                <input id="email" class="login-input mt-2" type="email" autocomplete="username" placeholder="Email akun Supabase" required>
            </label>
            <div class="block text-sm font-semibold">
                <label for="password">Password</label>
                <div class="relative mt-2">
                    <input id="password" class="login-input pr-12" type="password" autocomplete="current-password" placeholder="Masukkan password" required>
                    <button type="button" data-password-toggle aria-label="Tampilkan password" aria-pressed="false" class="absolute right-2 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-md text-blue-200 hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-300">
                        <svg data-eye-icon aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg data-eye-off-icon aria-hidden="true" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.1A10.8 10.8 0 0 1 12 4.8c6 0 9.75 7.2 9.75 7.2a18.8 18.8 0 0 1-2.1 2.9"/><path d="M6.1 6.1C3.6 7.8 2.25 12 2.25 12S6 18.75 12 18.75c1.2 0 2.3-.2 3.3-.6"/></svg>
                    </button>
                </div>
            </div>
            <button type="submit" class="w-full rounded-xl bg-blue-600 px-4 py-3 font-extrabold hover:bg-blue-500 disabled:opacity-60">Masuk ke Dashboard Tenant <span aria-hidden="true">→</span></button>
        </form>
        <p id="message" class="mt-4 hidden text-center text-sm font-bold" role="status" aria-live="polite"></p>
    </main>
    <script>
	import { db } from '../scripts/supabase.js';
        document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
            const input = toggle.parentElement.querySelector('input');
            toggle.addEventListener('click', () => {
                const isVisible = input.type === 'password';
                input.type = isVisible ? 'text' : 'password';
                toggle.querySelector('[data-eye-icon]').classList.toggle('hidden', isVisible);
                toggle.querySelector('[data-eye-off-icon]').classList.toggle('hidden', !isVisible);
                toggle.setAttribute('aria-label', isVisible ? 'Sembunyikan password' : 'Tampilkan password');
                toggle.setAttribute('aria-pressed', String(isVisible));
            });
        });

        const message = document.getElementById('message');
        const loginForm = document.getElementById('loginForm');

        function showMessage(text, isError) {
            message.textContent = text;
            message.className = `mt-4 text-center text-sm font-bold ${isError ? 'text-red-300' : 'text-green-300'}`;
        }

        loginForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const button = loginForm.querySelector('button[type="submit"]');
            button.disabled = true;
            const { data, error } = await db.auth.signInWithPassword({
                email: document.getElementById('email').value.trim(),
                password: document.getElementById('password').value
            });
            if (error) {
                showMessage(`Login gagal: ${error.message}`, true);
                button.disabled = false;
                return;
            }

            const { data: profile, error: profileError } = await db
                .from('profiles')
                .select('peran')
                .eq('id', data.user.id)
                .single();
            if (profileError || profile.peran !== 'pemilik_tenant') {
                await db.auth.signOut();
                showMessage(profileError ? `Profil gagal dimuat: ${profileError.message}` : 'Akun ini bukan akun pemilik tenant.', true);
                button.disabled = false;
                return;
            }
            const { data: tenant, error: tenantError } = await db
                .from('tenants')
                .select('slug')
                .eq('pemilik_id', data.user.id)
                .maybeSingle();
            if (tenantError || !tenant?.slug) {
                await db.auth.signOut();
                showMessage(tenantError ? `Tenant gagal dimuat: ${tenantError.message}` : 'Tenant belum terhubung.', true);
                button.disabled = false;
                return;
            }
            showMessage('Login berhasil. Membuka dashboard...', false);
            window.location.assign('/tenant-dashboard');
        });
    </script>
</Layout>
