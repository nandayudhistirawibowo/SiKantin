---
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/logo-uym.png';
import '../../styles/login.css';
---

<Layout title="Login Admin | SiKantin UYM" themeColor="#172b40" bodyClass="login-screen min-h-screen text-slate-100">
	<main class="mx-auto flex min-h-screen max-w-7xl items-center px-4 py-8 sm:px-6 lg:px-10">
		<div class="grid w-full overflow-hidden rounded-[2rem] border border-white/10 bg-slate-950/30 shadow-2xl shadow-slate-950/30 backdrop-blur-xl lg:min-h-[690px] lg:grid-cols-2">
			<section class="flex flex-col justify-center p-6 sm:p-10 lg:p-14">
				<a href="/" class="mb-10 inline-flex w-fit items-center gap-3" aria-label="SiKantin Universitas Yatsi Madani">
					<img src={logo.src} alt="" class="h-12 w-12 rounded-full bg-white p-1 shadow-lg" />
					<span>
						<span class="block text-lg font-extrabold tracking-wide">SIKANTIN</span>
						<span class="block text-xs text-blue-100/65">Universitas Yatsi Madani</span>
					</span>
				</a>

				<div class="mb-8">
					<p class="text-xs font-extrabold uppercase tracking-[0.24em] text-sky-300">Portal administrator</p>
					<h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">Selamat datang kembali</h1>
					<p class="mt-3 max-w-md text-sm leading-6 text-blue-100/65">
						Masuk untuk mengelola tenant, menu, dan aktivitas SiKantin UYM.
					</p>
				</div>

				<form id="adminLoginForm" class="space-y-5">
					<label class="block text-sm font-semibold" for="adminEmail">
						Email akun admin
						<input id="adminEmail" type="email" autocomplete="username" required class="login-input mt-2" placeholder="nama@kampus.ac.id" />
					</label>
					<label class="block text-sm font-semibold" for="adminPassword">
						Password
						<input id="adminPassword" type="password" autocomplete="current-password" required class="login-input mt-2" placeholder="Masukkan password" />
					</label>
					<button id="adminLoginButton" type="submit" class="w-full rounded-xl bg-blue-600 px-4 py-3.5 font-extrabold shadow-lg shadow-blue-950/30 transition hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-60">
						Masuk ke Panel Admin <span aria-hidden="true">→</span>
					</button>
				</form>
				<p id="adminLoginMessage" role="status" aria-live="polite" class="mt-4 hidden text-center text-sm font-bold"></p>

				<div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-6 text-sm">
					<a href="/" class="font-bold text-sky-300 transition hover:text-white">Kembali ke katalog <span aria-hidden="true">→</span></a>
					<a href="/tenant/login" class="text-blue-100/65 transition hover:text-white">Login Tenant</a>
				</div>
			</section>

			<aside class="login-showcase relative hidden overflow-hidden border-l border-white/10 p-10 lg:flex lg:flex-col lg:justify-between lg:p-14">
				<div class="relative z-10">
					<span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-bold text-sky-100">
						<span class="h-2 w-2 rounded-full bg-emerald-300"></span>
						Sistem kantin kampus
					</span>
					<h2 class="mt-8 max-w-lg text-4xl font-black leading-tight">
						Satu tempat untuk mengelola <span class="text-sky-300">rasa dan layanan.</span>
					</h2>
					<p class="mt-4 max-w-md leading-7 text-blue-100/70">
						SiKantin membantu pengelolaan kantin kampus menjadi lebih praktis, tertata, dan mudah dijangkau.
					</p>
				</div>

				<div class="relative z-10 space-y-3">
					<div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-slate-950/25 p-4">
						<span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-400/15 text-lg text-sky-200" aria-hidden="true">01</span>
						<div><p class="font-bold">Kelola tenant</p><p class="mt-1 text-sm text-blue-100/55">Informasi kantin dalam satu panel.</p></div>
					</div>
					<div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-slate-950/25 p-4">
						<span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-300/15 text-lg text-amber-200" aria-hidden="true">02</span>
						<div><p class="font-bold">Atur menu</p><p class="mt-1 text-sm text-blue-100/55">Perbarui katalog dengan lebih mudah.</p></div>
					</div>
					<div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-slate-950/25 p-4">
						<span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-300/15 text-lg text-emerald-200" aria-hidden="true">03</span>
						<div><p class="font-bold">Pantau aktivitas</p><p class="mt-1 text-sm text-blue-100/55">Bantu layanan kantin tetap terorganisir.</p></div>
					</div>
				</div>
				<div class="login-orb login-orb-one" aria-hidden="true"></div>
				<div class="login-orb login-orb-two" aria-hidden="true"></div>
			</aside>
		</div>
	</main>
	<script>
		import { db } from '../../scripts/supabase.js';

		document.getElementById('adminLoginForm').addEventListener('submit', async (event) => {
			event.preventDefault();
			const button = document.getElementById('adminLoginButton');
			const message = document.getElementById('adminLoginMessage');
			button.disabled = true;
			message.textContent = 'Memeriksa akun...';
			message.className = 'mt-4 text-center text-sm font-bold text-blue-200';
			try {
				const { data, error } = await db.auth.signInWithPassword({
					email: document.getElementById('adminEmail').value.trim(),
					password: document.getElementById('adminPassword').value,
				});
				if (error) throw new Error(error.message);
				const { data: profile, error: profileError } = await db
					.from('profiles')
					.select('peran')
					.eq('id', data.user.id)
					.single();
				if (profileError) throw new Error(`Profil gagal dimuat: ${profileError.message}`);
				if (profile.peran !== 'admin') throw new Error('Akun ini bukan akun administrator.');
				window.location.assign('/admin/dashboard');
			} catch (error) {
				const { error: signOutError } = await db.auth.signOut();
				message.textContent = signOutError
					? `${error.message} Sesi gagal ditutup: ${signOutError.message}`
					: error.message;
				message.className = 'mt-4 text-center text-sm font-bold text-red-300';
			} finally {
				button.disabled = false;
			}
		});
	</script>
</Layout>
