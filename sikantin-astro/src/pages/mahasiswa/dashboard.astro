---
import StudentShell from '../../components/StudentShell.astro';
---

<StudentShell title="Beranda">
	<section id="dashboardStudentProfileCard" class="hidden rounded-2xl border border-slate-200 bg-slate-50 p-4" aria-label="Profil mahasiswa">
		<div id="dashboardProfileControl" class="relative"></div>
	</section>

	<section class="ui-enter overflow-hidden rounded-3xl bg-gradient-to-br from-blue-800 via-blue-700 to-indigo-800 p-6 text-white shadow-lg sm:p-9">
		<p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-200">Portal mahasiswa</p>
		<h1 class="mt-3 text-3xl font-black sm:text-4xl">Halo, <span id="studentGreetingName">Mahasiswa</span>! <span class="student-wave inline-block" aria-hidden="true">👋</span></h1>
		<p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/80">Mau makan apa hari ini? Temukan kantin favoritmu, pesan lebih awal, dan nikmati waktu istirahat tanpa terburu-buru.</p>
		<a href="#dashboardTenantGrid" class="mt-6 inline-flex rounded-xl bg-white px-5 py-3 text-sm font-extrabold text-blue-800 transition hover:bg-blue-50">Pilih kantin <span class="ml-2" aria-hidden="true">↓</span></a>
	</section>

	<section class="mt-6 grid gap-4 lg:grid-cols-3" aria-label="Ringkasan mahasiswa">
		<article class="ui-hover-card ui-enter rounded-2xl border border-amber-100 bg-gradient-to-br from-amber-50 to-white p-5 shadow-sm">
			<p class="text-xs font-extrabold uppercase tracking-wide text-amber-700">Benefit</p>
			<p class="mt-2 text-lg font-black text-slate-900">Poin SiKantin</p>
			<p class="mt-1 text-sm text-slate-600"><span id="studentPoints" class="font-extrabold text-amber-700">0</span> poin</p>
			<p class="mt-2 text-xs text-slate-500">Program poin segera hadir.</p>
		</article>
		<article class="ui-hover-card ui-enter rounded-2xl border border-blue-100 bg-gradient-to-br from-blue-50 to-white p-5 shadow-sm lg:col-span-2">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<div>
					<p class="text-xs font-extrabold uppercase tracking-wide text-blue-700">Tersimpan</p>
					<h2 class="mt-1 text-lg font-black text-slate-900">Kantin Favoritmu</h2>
				</div>
				<a href="/mahasiswa/favorit" class="text-sm font-bold text-blue-700 hover:underline">Kelola favorit →</a>
			</div>
			<p id="dashboardFavoritesMessage" role="status" aria-live="polite" class="mt-3 hidden text-sm text-slate-500"></p>
			<div id="dashboardFavoriteGrid" class="mt-3 grid gap-3 sm:grid-cols-2">
				<div class="skeleton-card" role="status" aria-label="Memuat kantin favorit">
					<span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span>
				</div>
			</div>
		</article>
	</section>

	<section class="ui-enter ui-hover-card mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="dashboardRecentOrdersHeading">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<p class="text-xs font-extrabold uppercase tracking-wide text-blue-700">Aktivitas</p>
				<h2 id="dashboardRecentOrdersHeading" class="mt-1 text-lg font-black text-slate-900">Riwayat Pesanan Terakhir</h2>
			</div>
			<a href="/mahasiswa/riwayat" class="text-sm font-bold text-blue-700 hover:underline">Lihat semua →</a>
		</div>
		<p id="dashboardOrdersMessage" role="status" aria-live="polite" class="mt-3 hidden text-sm text-slate-500"></p>
		<div id="dashboardRecentOrders" class="mt-3 grid gap-3 md:grid-cols-3">
			<div class="skeleton-card" role="status" aria-label="Memuat pesanan terakhir"><span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span><span class="skeleton-line w-1/3"></span></div>
		</div>
	</section>

	<section class="mt-8" aria-labelledby="dashboardTenantHeading">
		<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
			<div>
				<p class="text-xs font-extrabold uppercase tracking-[0.16em] text-blue-700">Jelajahi</p>
				<h2 id="dashboardTenantHeading" class="mt-1 text-xl font-black text-slate-900">Pilih kantin</h2>
			</div>
			<a href="/mahasiswa/favorit" class="text-sm font-bold text-blue-700 hover:underline">Kelola favorit →</a>
		</div>
		<p id="dashboardTenantMessage" role="status" aria-live="polite" class="mb-4 hidden rounded-xl p-4 text-sm"></p>
		<div id="dashboardTenantGrid" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
			<div class="skeleton-card" role="status" aria-label="Memuat daftar kantin"><span class="skeleton-line w-2/3"></span><span class="skeleton-line w-1/2"></span><span class="skeleton-line w-1/3"></span></div>
		</div>
	</section>

	<script>
		import { db } from '../../scripts/supabase.js';

		const grid = document.getElementById('dashboardTenantGrid');
		const message = document.getElementById('dashboardTenantMessage');
		const favoriteGrid = document.getElementById('dashboardFavoriteGrid');
		const favoritesMessage = document.getElementById('dashboardFavoritesMessage');
		const recentOrdersContainer = document.getElementById('dashboardRecentOrders');
		const ordersMessage = document.getElementById('dashboardOrdersMessage');
		const profileCard = document.getElementById('dashboardStudentProfileCard');
		const profileControl = document.getElementById('dashboardProfileControl');
		const profileButton = document.getElementById('studentProfileButton');
		const profileMenu = document.getElementById('studentProfileMenu');
		const sidebar = document.getElementById('studentSidebar');
		const headerActions = profileButton.parentElement;
		const favoriteIds = new Set();
		let userId;
		let tenants = [];
		let recentOrders = [];

		headerActions.className = 'relative flex items-center gap-2';
		profileButton.className = 'flex w-full items-center gap-3 rounded-xl border-0 bg-transparent p-0 text-left transition hover:bg-transparent';
		profileButton.querySelector('span').className = 'block min-w-0 flex-1';
		profileButton.querySelector('span > span:first-child').classList.add('truncate');
		profileButton.querySelector('span > span:last-child').textContent = 'Mahasiswa';
		profileButton.querySelector('[aria-hidden="true"]').classList.add('ml-auto');
		profileMenu.classList.add('left-0', 'right-auto', 'w-full');
		profileControl.append(profileButton, profileMenu);
		sidebar.insertBefore(profileCard, sidebar.querySelector('nav'));
		profileCard.classList.remove('hidden');

		function showError(text) {
			message.textContent = text;
			message.className = 'mb-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700';
		}

		function makeTenantCard(tenant) {
			const card = document.createElement('article');
			card.className = 'ui-hover-card ui-enter rounded-2xl border border-slate-200 bg-white p-5 shadow-sm';
			const top = document.createElement('div');
			top.className = 'flex items-start justify-between gap-3';
			const details = document.createElement('div');
			const name = document.createElement('h3');
			name.className = 'font-extrabold text-slate-900';
			name.textContent = tenant.nama_tenant;
			const location = document.createElement('p');
			location.className = 'mt-1 text-sm text-slate-500';
			location.textContent = tenant.lokasi || 'Lokasi belum diisi';
			const status = document.createElement('span');
			const isOpen = tenant.status_buka === true;
			status.className = `mt-3 inline-flex rounded-full px-2.5 py-1 text-xs font-bold ${isOpen ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600'}`;
			status.textContent = isOpen ? 'Sedang buka' : 'Sedang tutup';
			details.append(name, location, status);

			const favoriteButton = document.createElement('button');
			favoriteButton.type = 'button';
			favoriteButton.className = 'shrink-0 rounded-full border border-slate-200 p-2 text-xl leading-none transition hover:bg-rose-50';
			favoriteButton.setAttribute('aria-label', `${favoriteIds.has(tenant.id) ? 'Hapus dari' : 'Tambah ke'} favorit ${tenant.nama_tenant}`);
			favoriteButton.setAttribute('aria-pressed', String(favoriteIds.has(tenant.id)));
			favoriteButton.textContent = favoriteIds.has(tenant.id) ? '♥' : '♡';
			favoriteButton.addEventListener('click', async () => {
				favoriteButton.disabled = true;
				try {
					if (favoriteIds.has(tenant.id)) {
						const { error } = await db.from('favorites').delete().eq('user_id', userId).eq('tenant_id', tenant.id);
						if (error) throw error;
						favoriteIds.delete(tenant.id);
					} else {
						const { error } = await db.from('favorites').insert({ user_id: userId, tenant_id: tenant.id });
						if (error) throw error;
						favoriteIds.add(tenant.id);
					}
					render();
				} catch (error) {
					showError(`Favorit gagal diperbarui: ${error.message || error}`);
					favoriteButton.disabled = false;
				}
			});
			top.append(details, favoriteButton);
			const visit = document.createElement('a');
			visit.href = `/tenant/${encodeURIComponent(tenant.slug)}`;
			visit.className = 'mt-5 flex items-center justify-center rounded-xl bg-blue-700 px-4 py-3 text-sm font-extrabold text-white transition hover:bg-blue-800';
			visit.textContent = 'Lihat menu & pesan →';
			card.append(top, visit);
			return card;
		}

		function render() {
			grid.replaceChildren(...tenants.map(makeTenantCard));
			if (!tenants.length) {
				const empty = document.createElement('p');
				empty.className = 'rounded-2xl border border-slate-200 bg-white p-5 text-sm text-slate-500 sm:col-span-2 xl:col-span-3';
				empty.textContent = 'Belum ada kantin yang tersedia.';
				grid.append(empty);
			}
			renderFavorites();
			renderRecentOrders();
		}

		function renderFavorites() {
			const favoriteTenants = tenants.filter((tenant) => favoriteIds.has(tenant.id));
			favoriteGrid.replaceChildren();
			if (!favoritesMessage.classList.contains('hidden')) return;
			favoritesMessage.classList.add('hidden');
			if (!favoriteTenants.length) {
				const empty = document.createElement('p');
				empty.className = 'text-sm text-slate-500 sm:col-span-2';
				empty.textContent = 'Belum ada kantin favorit. Tekan ikon hati pada kantin yang kamu suka.';
				favoriteGrid.append(empty);
				return;
			}
			favoriteTenants.forEach((tenant) => {
				const card = document.createElement('a');
				card.href = `/tenant/${encodeURIComponent(tenant.slug)}`;
				card.className = 'ui-hover-card ui-enter rounded-xl border border-blue-100 bg-white p-4';
				const name = document.createElement('span');
				name.className = 'block truncate font-extrabold text-slate-900';
				name.textContent = tenant.nama_tenant;
				const location = document.createElement('span');
				location.className = 'mt-1 block truncate text-sm text-slate-500';
				location.textContent = tenant.lokasi || 'Lokasi belum diisi';
				card.append(name, location);
				favoriteGrid.append(card);
			});
		}

		function renderRecentOrders() {
			recentOrdersContainer.replaceChildren();
			if (!ordersMessage.classList.contains('hidden')) return;
			if (!recentOrders.length) {
				const empty = document.createElement('p');
				empty.className = 'text-sm text-slate-500 md:col-span-3';
				empty.textContent = 'Belum ada pesanan saat login. Pesanan berikutnya akan muncul di sini.';
				recentOrdersContainer.append(empty);
				return;
			}
			recentOrders.forEach((order) => {
				const card = document.createElement('article');
				card.className = 'ui-hover-card ui-enter rounded-xl border border-slate-200 bg-slate-50 p-4';
				const tenant = document.createElement('p');
				tenant.className = 'truncate text-sm font-extrabold text-slate-900';
				tenant.textContent = order.tenants?.nama_tenant || 'Kantin';
				const info = document.createElement('p');
				info.className = 'mt-1 text-xs text-slate-500';
				const orderDate = new Date(order.created_at);
				const dateText = Number.isNaN(orderDate.getTime())
					? 'Tanggal tidak tersedia'
					: orderDate.toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' });
				info.textContent = `Pesanan ${order.nomor_pesanan || order.nomor_antrean || '—'} · ${dateText}`;
				const status = document.createElement('p');
				status.className = 'mt-2 text-sm font-bold text-blue-700';
				status.textContent = order.status || 'Status tidak tersedia';
				const total = document.createElement('p');
				total.className = 'mt-1 text-sm font-extrabold text-slate-800';
				total.textContent = `Rp ${Number(order.total || 0).toLocaleString('id-ID')}`;
				card.append(tenant, info, status, total);
				if (order.token_pesanan) {
					const track = document.createElement('a');
					track.href = `/cek-pesanan?token=${encodeURIComponent(order.token_pesanan)}`;
					track.className = 'mt-3 inline-flex text-sm font-bold text-blue-700 hover:underline';
					track.textContent = 'Lacak pesanan →';
					card.append(track);
				}
				recentOrdersContainer.append(card);
			});
		}

		async function initializeDashboard() {
			const { data: { session }, error: sessionError } = await db.auth.getSession();
			if (sessionError) throw new Error(`Sesi gagal diperiksa: ${sessionError.message}`);
			if (!session) return;
			userId = session.user.id;

			const [
				{ data: profile, error: profileError },
				{ data: tenantRows, error: tenantError },
				{ data: favorites, error: favoriteError },
				{ data: orderRows, error: ordersError },
			] = await Promise.all([
				db.from('profiles').select('nama, avatar_url').eq('id', userId).single(),
				db.from('tenants').select('id, nama_tenant, slug, lokasi, status_buka').order('nama_tenant'),
				db.from('favorites').select('tenant_id').eq('user_id', userId),
				db.from('orders')
					.select('id, nomor_pesanan, nomor_antrean, token_pesanan, status, total, created_at, tenants(nama_tenant)')
					.eq('mahasiswa_id', userId)
					.order('created_at', { ascending: false })
					.limit(3),
			]);
			if (profileError) throw new Error(`Profil gagal dimuat: ${profileError.message}`);
			if (tenantError) throw new Error(`Daftar kantin gagal dimuat: ${tenantError.message}`);
			const studentName = profile.nama?.trim() || 'Mahasiswa';
			document.getElementById('studentGreetingName').textContent = studentName;
			document.getElementById('studentName').textContent = studentName;
			const avatar = document.getElementById('studentAvatar');
			avatar.src = profile.avatar_url || avatar.dataset.avatarFallback;
			tenants = tenantRows || [];
			if (favoriteError) {
				favoritesMessage.textContent = `Favorit gagal dimuat: ${favoriteError.message}`;
				favoritesMessage.classList.remove('hidden');
			} else {
				favorites.forEach((favorite) => favoriteIds.add(favorite.tenant_id));
			}
			if (ordersError) {
				ordersMessage.textContent = `Riwayat pesanan gagal dimuat: ${ordersError.message}`;
				ordersMessage.classList.remove('hidden');
			} else {
				recentOrders = orderRows || [];
			}
			render();
		}

		initializeDashboard().catch((error) => {
			showError(error.message || String(error));
			grid.replaceChildren();
		});
	</script>

	<style>
		:global(.student-wave) {
			transform-origin: 70% 85%;
			animation: wave 1.8s ease-in-out infinite;
		}

		@media (max-width: 1023px) {
			:global(header) {
				z-index: 60 !important;
			}

			:global(header #studentMenuButton) {
				display: inline-flex !important;
				visibility: visible !important;
				opacity: 1 !important;
				position: relative;
				z-index: 61 !important;
				min-width: 2.75rem;
				min-height: 2.75rem;
			}

			:global(#studentSidebar) {
				position: fixed !important;
				inset: 0 auto 0 0 !important;
				z-index: 50 !important;
				display: flex !important;
				width: min(18rem, calc(100vw - 4rem)) !important;
				height: 100dvh !important;
				transform: translateX(-100%) !important;
				translate: none !important;
			}

			:global(#studentSidebar.hidden) {
				display: none !important;
			}

			:global(#studentSidebar:not(.hidden):not(.student-sidebar-closed)) {
				transform: translateX(0) !important;
			}

			:global(#studentSidebar.student-sidebar-closed) {
				transform: translateX(-100%) !important;
			}

			:global(#studentSidebarBackdrop:not(.hidden)) {
				display: block !important;
				z-index: 20 !important;
			}
		}

		@media (min-width: 1024px) {
			:global(#studentSidebar) {
				display: flex !important;
				position: sticky !important;
				height: 100vh !important;
				transform: none !important;
				translate: none !important;
			}

			:global(#studentSidebar.student-sidebar-collapsed) {
				display: none !important;
			}
		}

		:global(header #studentProfileButton) {
			display: none !important;
		}

		:global(#dashboardProfileControl #studentProfileButton) {
			display: flex !important;
		}

		:global(#dashboardProfileControl #studentProfileButton > img) {
			width: 2.5rem;
			height: 2.5rem;
			flex: 0 0 2.5rem;
		}

		:global(#dashboardProfileControl #studentProfileButton > span > span:first-child) {
			display: block;
			min-width: 0;
			max-width: 10rem;
			overflow: hidden;
			font-size: 0.875rem;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		:global(#dashboardProfileControl #studentProfileButton > span > span:last-child) {
			margin-top: 0.125rem;
			font-size: 0.75rem;
		}

		:global(#dashboardProfileControl #studentProfileButton > span[aria-hidden="true"]) {
			margin-left: auto;
		}

		:global(#dashboardProfileControl #studentProfileMenu) {
			top: calc(100% + 0.5rem);
		}
	</style>
</StudentShell>